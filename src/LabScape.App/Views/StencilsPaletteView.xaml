<UserControl x:Class="LabScape.App.Views.StencilsPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:stencils="clr-namespace:LabScape.ViewModels.Stencils;assembly=LabScape.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="260">

    <Grid Background="{DynamicResource PanelBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search Box -->
        <Border Grid.Row="0" Margin="10,10,10,8" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Margin="2,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"/>
                <TextBox Grid.Column="1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="0" Background="Transparent" Foreground="{DynamicResource InputForegroundBrush}"
                         CaretBrush="{DynamicResource InputForegroundBrush}" VerticalAlignment="Center"
                         FontSize="11.5" Padding="0"/>
                <Button Grid.Column="2" Content="✕" FontSize="9" Width="18" Height="18"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource AppTextMutedBrush}"
                        Cursor="Hand" ToolTip="Clear Search"
                        Command="{Binding ClearSearchCommand}"
                        Visibility="{Binding SearchFilter, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="9">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Categories Accordion / Scroll -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8,0,8,12">

                <!-- 1. Devices Expander -->
                <Expander IsExpanded="True" FontWeight="SemiBold" Margin="0,2,0,6" Foreground="{DynamicResource AppTextPrimaryBrush}">
                    <Expander.Header>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="IT Hardware &amp; Devices" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding FilteredDevices.Count}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Border>
                        </DockPanel>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding FilteredDevices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="110" ItemHeight="95"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type stencils:StencilItem}">
                                <Border Margin="3" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6"
                                        Cursor="Hand" ToolTip="{Binding Title}"
                                        MouseMove="Stencil_MouseMove" MouseLeftButtonDown="Stencil_MouseLeftButtonDown">
                                    <Border.CacheMode>
                                        <BitmapCache EnableClearType="False" RenderAtScale="1.0" SnapsToDevicePixels="True"/>
                                    </Border.CacheMode>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHoverBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Image Grid.Row="0" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding IconResourceKey, Converter={StaticResource ResourceKeyToImageConverter}}" Stretch="Uniform" Margin="2"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="10" FontWeight="Medium" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <!-- 2. Furniture Expander -->
                <Expander IsExpanded="True" FontWeight="SemiBold" Margin="0,4,0,6" Foreground="{DynamicResource AppTextPrimaryBrush}">
                    <Expander.Header>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Office Furniture" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding FilteredFurniture.Count}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Border>
                        </DockPanel>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding FilteredFurniture}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="110" ItemHeight="95"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type stencils:StencilItem}">
                                <Border Margin="3" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6"
                                        Cursor="Hand" ToolTip="{Binding Title}"
                                        MouseMove="Stencil_MouseMove" MouseLeftButtonDown="Stencil_MouseLeftButtonDown">
                                    <Border.CacheMode>
                                        <BitmapCache EnableClearType="False" RenderAtScale="1.0" SnapsToDevicePixels="True"/>
                                    </Border.CacheMode>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHoverBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Image Grid.Row="0" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding IconResourceKey, Converter={StaticResource ResourceKeyToImageConverter}}" Stretch="Uniform" Margin="2"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="10" FontWeight="Medium" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <!-- 3. Shapes Expander -->
                <Expander IsExpanded="True" FontWeight="SemiBold" Margin="0,4,0,6" Foreground="{DynamicResource AppTextPrimaryBrush}">
                    <Expander.Header>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Geometric Shapes" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding FilteredShapes.Count}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Border>
                        </DockPanel>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding FilteredShapes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="110" ItemHeight="95"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type stencils:StencilItem}">
                                <Border Margin="3" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6"
                                        Cursor="Hand" ToolTip="{Binding Title}"
                                        MouseMove="Stencil_MouseMove" MouseLeftButtonDown="Stencil_MouseLeftButtonDown">
                                    <Border.CacheMode>
                                        <BitmapCache EnableClearType="False" RenderAtScale="1.0" SnapsToDevicePixels="True"/>
                                    </Border.CacheMode>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHoverBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Image Grid.Row="0" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding IconResourceKey, Converter={StaticResource ResourceKeyToImageConverter}}" Stretch="Uniform" Margin="4"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="10" FontWeight="Medium" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
