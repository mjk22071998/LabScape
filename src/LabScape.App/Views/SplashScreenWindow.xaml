<Window x:Class="LabScape.App.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabScape"
        Width="560" Height="330"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Self-contained brushes for ultra-fast startup -->
        <LinearGradientBrush x:Key="SplashBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#070B12" Offset="0.0"/>
            <GradientStop Color="#0D1524" Offset="0.5"/>
            <GradientStop Color="#0F192C" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SplashProgressBarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0284C7" Offset="0.0"/>
            <GradientStop Color="#38BDF8" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SplashEmblemBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#38BDF8" Offset="0.0"/>
            <GradientStop Color="#0284C7" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Border Margin="16" CornerRadius="12" Background="{StaticResource SplashBackgroundBrush}"
            BorderBrush="#1E3252" BorderThickness="1.2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" Direction="270" ShadowDepth="6" Opacity="0.75" Color="#000000"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <!-- 1. Background Technical Blueprint Grid -->
            <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.12" IsHitTestVisible="False">
                <Line X1="0" Y1="40" X2="540" Y2="40" Stroke="#38BDF8" StrokeThickness="0.6"/>
                <Line X1="0" Y1="80" X2="540" Y2="80" Stroke="#38BDF8" StrokeThickness="0.6"/>
                <Line X1="0" Y1="120" X2="540" Y2="120" Stroke="#38BDF8" StrokeThickness="0.6"/>
                <Line X1="0" Y1="160" X2="540" Y2="160" Stroke="#38BDF8" StrokeThickness="0.6"/>
                <Line X1="0" Y1="200" X2="540" Y2="200" Stroke="#38BDF8" StrokeThickness="0.6"/>
                <Line X1="0" Y1="240" X2="540" Y2="240" Stroke="#38BDF8" StrokeThickness="0.6"/>
                <Line X1="60" Y1="0" X2="60" Y2="300" Stroke="#38BDF8" StrokeThickness="0.6"/>
                <Line X1="120" Y1="0" X2="120" Y2="300" Stroke="#38BDF8" StrokeThickness="0.6"/>
                <Line X1="180" Y1="0" X2="180" Y2="300" Stroke="#38BDF8" StrokeThickness="0.6"/>
                <Line X1="240" Y1="0" X2="240" Y2="300" Stroke="#38BDF8" StrokeThickness="0.6"/>
                <Line X1="300" Y1="0" X2="300" Y2="300" Stroke="#38BDF8" StrokeThickness="0.6"/>
                <Line X1="360" Y1="0" X2="360" Y2="300" Stroke="#38BDF8" StrokeThickness="0.6"/>
                <Line X1="420" Y1="0" X2="420" Y2="300" Stroke="#38BDF8" StrokeThickness="0.6"/>
                <Line X1="480" Y1="0" X2="480" Y2="300" Stroke="#38BDF8" StrokeThickness="0.6"/>
            </Canvas>

            <!-- 2. Technical Corner Crop Brackets -->
            <Path Data="M 12 22 V 12 H 22 M 516 12 H 506 V 22 M 12 276 V 286 H 22 M 516 286 H 506 V 276"
                  Stroke="#38BDF8" StrokeThickness="1.2" Opacity="0.4" IsHitTestVisible="False"/>

            <!-- 3. Main Content Area -->
            <Grid Margin="28,24,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Row: Logo Emblem + App Title & Subtitle -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vector CAD Emblem Badge -->
                    <Border Grid.Column="0" Width="60" Height="60" CornerRadius="12"
                            Background="#0C253B" BorderBrush="#0284C7" BorderThickness="1.5"
                            Margin="0,0,18,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#38BDF8" Opacity="0.3"/>
                        </Border.Effect>
                        <Viewbox Width="38" Height="38">
                            <Canvas Width="24" Height="24">
                                <!-- Isometric Blueprint Cube / CAD Workstation -->
                                <Polygon Points="12,2 22,7.5 12,13 2,7.5"
                                         Fill="{StaticResource SplashEmblemBrush}"
                                         Stroke="#38BDF8" StrokeThickness="0.8"/>
                                <Polygon Points="2,7.5 12,13 12,22 2,16.5"
                                         Fill="#0369A1"
                                         Stroke="#0284C7" StrokeThickness="0.8"/>
                                <Polygon Points="12,13 22,7.5 22,16.5 12,22"
                                         Fill="#075985"
                                         Stroke="#0284C7" StrokeThickness="0.8"/>
                                <!-- Central Illuminated Tech Core -->
                                <Ellipse Canvas.Left="9.5" Canvas.Top="10" Width="5" Height="5"
                                         Fill="#38BDF8">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#38BDF8" Opacity="0.8"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <!-- Title & Subtitle Typography -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="LABSCAPE" FontSize="26" FontWeight="ExtraBold"
                                   Foreground="#F8FAFC" FontFamily="Segoe UI Variable Display, Segoe UI">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.4" Color="#000000"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="ENTERPRISE LAB LAYOUT DESIGNER" FontSize="10.5" FontWeight="Bold"
                                   Foreground="#38BDF8" Margin="0,2,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#38BDF8" Opacity="0.25"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="High-Performance Spatial CAD &amp; Network Automation Engine"
                                   FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Center: Subtle Spatial Specs / Feature highlights -->
                <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,10">
                    <Border Background="#08101E" BorderBrush="#142138" BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="PRECISION CAD" FontSize="9" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text="0.1mm Accuracy" FontSize="10.5" FontWeight="SemiBold" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Rectangle Grid.Column="1" Fill="#1E2F4C"/>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="NETWORK ENGINE" FontSize="9" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text="Sequential IP &amp; MAC" FontSize="10.5" FontWeight="SemiBold" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Rectangle Grid.Column="3" Fill="#1E2F4C"/>

                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock Text="OFFLINE-FIRST" FontSize="9" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text="Encrypted DPAPI" FontSize="10.5" FontWeight="SemiBold" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Bottom Row: Status, Progress Bar & Footer -->
                <StackPanel Grid.Row="2">
                    <!-- Status Label & Percentage -->
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="⚡" FontSize="11" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtStatus" Text="Initializing application services..." FontSize="11"
                                       Foreground="#CBD5E1" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtPercent" Text="0%" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#38BDF8" FontFamily="Consolas, monospace"
                                   HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- High-Tech Progress Bar Track -->
                    <Border x:Name="ProgressBarTrack" Height="4" Background="#141E33" CornerRadius="2" Margin="0,0,0,10">
                        <Border x:Name="ProgressBarIndicator" Height="4" Background="{StaticResource SplashProgressBarBrush}"
                                CornerRadius="2" HorizontalAlignment="Left" Width="0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#38BDF8" Opacity="0.7"/>
                            </Border.Effect>
                        </Border>
                    </Border>

                    <!-- Footer: Version Badge & Engine Tag -->
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Background="#0C253B" BorderBrush="#0369A1" BorderThickness="1"
                                CornerRadius="4" Padding="6,2">
                            <TextBlock Text="v1.0.0 • Professional Edition" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="#7DD3FC"/>
                        </Border>
                        <TextBlock Text="Powered by .NET 10 &amp; WPF Native Acceleration" FontSize="10"
                                   Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
