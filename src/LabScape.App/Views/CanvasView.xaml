<UserControl x:Class="LabScape.App.Views.CanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:LabScape.App.Controls"
             xmlns:items="clr-namespace:LabScape.ViewModels.Items;assembly=LabScape.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             Focusable="True"
             ClipToBounds="True">

    <UserControl.Resources>
        <!-- Canvas Item Context Menu -->
        <ContextMenu x:Key="ItemContextMenu">
            <MenuItem Header="Cut" Command="{Binding PlacementTarget.Tag.CutSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+X">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconCut}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy" Command="{Binding PlacementTarget.Tag.CopySelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+C">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconCopy}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Paste" Command="{Binding PlacementTarget.Tag.PasteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+V">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconPaste}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Duplicate" Command="{Binding PlacementTarget.Tag.DuplicateSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+D">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconDuplicate}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Delete" Command="{Binding PlacementTarget.Tag.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Del">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconDelete}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Order">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconLayers}" Width="15" Height="15"/>
                </MenuItem.Icon>
                <MenuItem Header="Move to Front" Command="{Binding PlacementTarget.Tag.MoveToFrontCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+Shift+]">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconMoveToFront}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Move Forward" Command="{Binding PlacementTarget.Tag.MoveForwardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+]">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconMoveForward}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Send Backward" Command="{Binding PlacementTarget.Tag.SendBackwardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+[">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconSendBackward}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Send to Back" Command="{Binding PlacementTarget.Tag.SendToBackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+Shift+[">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconSendToBack}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Grouping">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconGroup}" Width="15" Height="15"/>
                </MenuItem.Icon>
                <MenuItem Header="Group" Command="{Binding PlacementTarget.Tag.GroupSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+G">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconGroup}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Ungroup" Command="{Binding PlacementTarget.Tag.UngroupSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+Shift+G">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconUngroup}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Alignment">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconAlignCenter}" Width="15" Height="15"/>
                </MenuItem.Icon>
                <MenuItem Header="Align Left" Command="{Binding PlacementTarget.Tag.AlignLeftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconAlignLeft}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Align Center" Command="{Binding PlacementTarget.Tag.AlignCenterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconAlignCenter}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Align Right" Command="{Binding PlacementTarget.Tag.AlignRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconAlignRight}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Align Top" Command="{Binding PlacementTarget.Tag.AlignTopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconAlignTop}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Align Middle" Command="{Binding PlacementTarget.Tag.AlignMiddleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconAlignMiddle}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Align Bottom" Command="{Binding PlacementTarget.Tag.AlignBottomCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconAlignBottom}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </ContextMenu>

        <!-- Canvas Background Context Menu -->
        <ContextMenu x:Key="CanvasContextMenu">
            <MenuItem Header="Paste" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconPaste}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Select All" Command="{Binding SelectAllCommand}" InputGestureText="Ctrl+A">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconSelectAll}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Zoom In" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconZoomIn}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Zoom Out" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconZoomOut}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Reset Zoom (100%)" Command="{Binding ResetZoomCommand}" InputGestureText="Ctrl+0">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconResetZoom}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Show Grid" IsCheckable="True" IsChecked="{Binding ShowGrid}">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconShowGrid}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Snap to Grid" IsCheckable="True" IsChecked="{Binding SnapToGrid}">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconSnapToGrid}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Show Rulers" IsCheckable="True" IsChecked="{Binding ShowRulers}">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconShowRulers}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconUndo}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconRedo}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid Background="{DynamicResource CanvasWorkspaceBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Top-Left Corner Block -->
        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource CanvasRulerBackgroundBrush}" BorderBrush="{DynamicResource CanvasRulerBorderBrush}" BorderThickness="0,0,1,1">
            <TextBlock Text="px" FontSize="9" Foreground="{DynamicResource CanvasRulerForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Top Horizontal Ruler -->
        <controls:RulerControl x:Name="HorizontalRuler"
                               Grid.Row="0" Grid.Column="1"
                               Orientation="Horizontal"
                               ZoomLevel="{Binding ZoomLevel}"
                               Offset="{Binding PanX}"
                               CursorPosition="{Binding CursorX}"
                               Visibility="{Binding ShowRulers, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Left Vertical Ruler -->
        <controls:RulerControl x:Name="VerticalRuler"
                               Grid.Row="1" Grid.Column="0"
                               Orientation="Vertical"
                               ZoomLevel="{Binding ZoomLevel}"
                               Offset="{Binding PanY}"
                               CursorPosition="{Binding CursorY}"
                               Visibility="{Binding ShowRulers, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Viewport Container -->
        <Border Grid.Row="1" Grid.Column="1" 
                Background="{DynamicResource CanvasWorkspaceBackgroundBrush}" 
                ClipToBounds="True"
                Focusable="True"
                AllowDrop="True"
                ContextMenu="{StaticResource CanvasContextMenu}"
                MouseDown="Viewport_MouseDown"
                MouseMove="Viewport_MouseMove"
                MouseUp="Viewport_MouseUp"
                MouseWheel="Viewport_MouseWheel"
                Drop="Viewport_Drop"
                DragOver="Viewport_DragOver">

            <Grid>
            <Canvas x:Name="CanvasSurface"
                    Width="{Binding CanvasWidth}"
                    Height="{Binding CanvasHeight}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">

                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CanvasScale" ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                        <TranslateTransform x:Name="CanvasTranslate" X="{Binding PanX}" Y="{Binding PanY}"/>
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- Dynamic Grid Pattern -->
                <Canvas.Background>
                    <DrawingBrush x:Name="GridBrush" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="{DynamicResource CanvasPaperBackgroundBrush}">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,20,20"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="{DynamicResource CanvasGridLineBrush}">
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="{DynamicResource CanvasGridLineBrush}" Thickness="0.75"/>
                                    </GeometryDrawing.Pen>
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="0,20" EndPoint="20,20"/>
                                            <LineGeometry StartPoint="20,0" EndPoint="20,20"/>
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Canvas.Background>

                <!-- Interactive Items Container with Local Adorner Decorator -->
                <AdornerDecorator Canvas.Left="0" Canvas.Top="0" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" ClipToBounds="False">
                    <ItemsControl x:Name="ItemsHost" ItemsSource="{Binding Items}" ClipToBounds="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas ClipToBounds="False"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            <Setter Property="Panel.ZIndex" Value="{Binding Z}"/>
                            <Setter Property="ClipToBounds" Value="False"/>
                            <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}"/>
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.Resources>
                        <!-- Device DataTemplate -->
                        <DataTemplate DataType="{x:Type items:DeviceItemViewModel}">
                            <Grid Width="{Binding Width}" Height="{Binding Height}"
                                  Cursor="SizeAll"
                                  MouseDown="Item_MouseDown"
                                  Background="Transparent">

                                <Grid.RenderTransform>
                                    <RotateTransform Angle="{Binding Rotation}" CenterX="{Binding Width, Converter={StaticResource HalfValueConverter}}" CenterY="{Binding Height, Converter={StaticResource HalfValueConverter}}"/>
                                </Grid.RenderTransform>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" MinHeight="24"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Device Stencil Drawing -->
                                <Image Grid.Row="0" Source="{Binding DeviceType, Converter={StaticResource DeviceTypeToImageConverter}}" Stretch="Uniform" Margin="4"/>

                                <!-- Validation Badge (Top-Right) -->
                                <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2"
                                        CornerRadius="8" Padding="3,1"
                                        Visibility="{Binding ValidationStatus, Converter={StaticResource ValidationBadgeVisibilityConverter}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ValidationStatus}" Value="Unassigned">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ValidationStatus}" Value="DuplicateIp">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                    <Setter Property="BorderBrush" Value="#EF4444"/>
                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="10" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ValidationStatus}" Value="Unassigned">
                                                        <Setter Property="Text" Value="⚠️"/>
                                                        <Setter Property="ToolTip" Value="Warning: No IP Address assigned!"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ValidationStatus}" Value="DuplicateIp">
                                                        <Setter Property="Text" Value="⛔"/>
                                                        <Setter Property="ToolTip" Value="Conflict: Duplicate IP Address assigned!"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Label Below Device (ONLY DEVICES SHOW LABELS; IP NOT SHOWN ON CANVAS; WRAPS ON BOUNDARY) -->
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Name, Converter={StaticResource DeviceLabelWrapConverter}}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"
                                           MaxWidth="{Binding Width}"
                                           ToolTip="{Binding Name}"
                                           Margin="2,2,2,0"/>
                            </Grid>
                        </DataTemplate>

                        <!-- Furniture DataTemplate -->
                        <DataTemplate DataType="{x:Type items:FurnitureItemViewModel}">
                            <Grid Width="{Binding Width}" Height="{Binding Height}"
                                  Cursor="SizeAll"
                                  MouseDown="Item_MouseDown"
                                  Background="Transparent">

                                <Grid.RenderTransform>
                                    <RotateTransform Angle="{Binding Rotation}" CenterX="{Binding Width, Converter={StaticResource HalfValueConverter}}" CenterY="{Binding Height, Converter={StaticResource HalfValueConverter}}"/>
                                </Grid.RenderTransform>

                                <Image Source="{Binding FurnitureType, Converter={StaticResource FurnitureTypeToImageConverter}}" Stretch="Fill"/>
                            </Grid>
                        </DataTemplate>

                        <!-- Shape DataTemplate -->
                        <DataTemplate DataType="{x:Type items:ShapeItemViewModel}">
                            <Grid ClipToBounds="False"
                                  Cursor="SizeAll"
                                  MouseDown="Item_MouseDown">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Width" Value="{Binding Width}"/>
                                        <Setter Property="Height" Value="{Binding Height}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShapeType}" Value="Line">
                                                <Setter Property="Background" Value="{x:Null}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ShapeType}" Value="Bezier">
                                                <Setter Property="Width" Value="Auto"/>
                                                <Setter Property="Height" Value="Auto"/>
                                                <Setter Property="Background" Value="{x:Null}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Grid.RenderTransform>
                                    <RotateTransform Angle="{Binding Rotation}" CenterX="{Binding Width, Converter={StaticResource HalfValueConverter}}" CenterY="{Binding Height, Converter={StaticResource HalfValueConverter}}"/>
                                </Grid.RenderTransform>

                                <!-- Visual Path -->
                                <Path x:Name="VisiblePath"
                                      Stroke="{Binding Stroke, Converter={StaticResource HexToBrushConverter}}"
                                      StrokeThickness="{Binding StrokeThickness}"
                                      ClipToBounds="False"
                                      Stretch="None">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{Binding Fill, Converter={StaticResource HexToBrushConverter}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShapeType}" Value="Line">
                                                    <Setter Property="Fill" Value="{x:Null}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ShapeType}" Value="Bezier">
                                                    <Setter Property="Fill" Value="{x:Null}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                    <Path.Data>
                                        <MultiBinding Converter="{StaticResource ShapeToGeometryConverter}">
                                            <Binding />
                                            <Binding Path="CornerRadius" />
                                            <Binding Path="InnerRadius" />
                                            <Binding Path="ShapeType" />
                                            <Binding Path="Width" />
                                            <Binding Path="Height" />
                                            <Binding Path="ControlPoint1X" />
                                            <Binding Path="ControlPoint1Y" />
                                            <Binding Path="ControlPoint2X" />
                                            <Binding Path="ControlPoint2Y" />
                                            <Binding Path="StartX" />
                                            <Binding Path="StartY" />
                                            <Binding Path="EndX" />
                                            <Binding Path="EndY" />
                                        </MultiBinding>
                                    </Path.Data>
                                </Path>

                                <!-- Hit-test buffer: makes clicking thin lines/curves effortless without selecting on whitespace -->
                                <Path Stroke="Transparent"
                                      StrokeThickness="12"
                                      ClipToBounds="False"
                                      Stretch="None"
                                      Data="{Binding Data, ElementName=VisiblePath}"/>
                            </Grid>
                        </DataTemplate>

                        <!-- Group DataTemplate -->
                        <DataTemplate DataType="{x:Type items:GroupItemViewModel}">
                            <Grid Width="{Binding Width}" Height="{Binding Height}"
                                  Cursor="SizeAll"
                                  MouseDown="Item_MouseDown"
                                  Background="Transparent">

                                <Grid.RenderTransform>
                                    <RotateTransform Angle="{Binding Rotation}" CenterX="{Binding Width, Converter={StaticResource HalfValueConverter}}" CenterY="{Binding Height, Converter={StaticResource HalfValueConverter}}"/>
                                </Grid.RenderTransform>

                                <!-- Subtle bounding box for group -->
                                <Rectangle Stroke="#9CA3AF" StrokeThickness="1" StrokeDashArray="4 2" IsHitTestVisible="False"/>

                                <!-- Children Items -->
                                <ItemsControl ItemsSource="{Binding Children}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource RelativeOffsetConverter}">
                                                        <Binding Path="X"/>
                                                        <Binding Path="DataContext.X" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Canvas.Top">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource RelativeOffsetConverter}">
                                                        <Binding Path="Y"/>
                                                        <Binding Path="DataContext.Y" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Panel.ZIndex" Value="{Binding Z}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>
                </AdornerDecorator>

                <!-- Marquee Selection Rectangle -->
                <Rectangle x:Name="RubberbandRect"
                           Stroke="#3B82F6" StrokeThickness="1.5" StrokeDashArray="3 2"
                           Fill="#203B82F6"
                           Visibility="Collapsed"
                           Panel.ZIndex="9998"
                           IsHitTestVisible="False"/>

                <!-- Dynamic Magnetic Snap Guide Lines -->
                <Line x:Name="SnapGuideVertical"
                      Stroke="#EC4899" StrokeThickness="1.5" StrokeDashArray="4 2"
                      Visibility="Collapsed"
                      Panel.ZIndex="9999"
                      IsHitTestVisible="False"/>
                <Line x:Name="SnapGuideHorizontal"
                      Stroke="#EC4899" StrokeThickness="1.5" StrokeDashArray="4 2"
                      Visibility="Collapsed"
                      Panel.ZIndex="9999"
                      IsHitTestVisible="False"/>

                <!-- Drag & Drop Ghost Preview -->
                <Border x:Name="DragGhost"
                        BorderBrush="#3B82F6" BorderThickness="2"
                        Background="#253B82F6" CornerRadius="4"
                        Visibility="Collapsed"
                        Panel.ZIndex="10000"
                        IsHitTestVisible="False"/>

            </Canvas>
            </Grid>
        </Border>
    </Grid>
</UserControl>
