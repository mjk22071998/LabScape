<UserControl x:Class="LabScape.App.Views.CanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:LabScape.App.Controls"
             xmlns:items="clr-namespace:LabScape.ViewModels.Items;assembly=LabScape.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             Focusable="True"
             ClipToBounds="True">

    <UserControl.Resources>
        <!-- Canvas Item Context Menu -->
        <ContextMenu x:Key="ItemContextMenu">
            <MenuItem Header="Cut" Command="{Binding PlacementTarget.Tag.CutSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+X">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconCut}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy" Command="{Binding PlacementTarget.Tag.CopySelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+C">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconCopy}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Paste" Command="{Binding PlacementTarget.Tag.PasteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+V">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconPaste}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Duplicate" Command="{Binding PlacementTarget.Tag.DuplicateSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+D">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconDuplicate}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Delete" Command="{Binding PlacementTarget.Tag.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Del">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconDelete}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Order">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconLayers}" Width="15" Height="15"/>
                </MenuItem.Icon>
                <MenuItem Header="Move to Front" Command="{Binding PlacementTarget.Tag.MoveToFrontCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+Shift+]">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconMoveToFront}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Move Forward" Command="{Binding PlacementTarget.Tag.MoveForwardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+]">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconMoveForward}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Send Backward" Command="{Binding PlacementTarget.Tag.SendBackwardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+[">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconSendBackward}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Send to Back" Command="{Binding PlacementTarget.Tag.SendToBackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+Shift+[">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconSendToBack}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Grouping">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconGroup}" Width="15" Height="15"/>
                </MenuItem.Icon>
                <MenuItem Header="Group" Command="{Binding PlacementTarget.Tag.GroupSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+G">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconGroup}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Ungroup" Command="{Binding PlacementTarget.Tag.UngroupSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+Shift+G">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconUngroup}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Alignment">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconAlignCenter}" Width="15" Height="15"/>
                </MenuItem.Icon>
                <MenuItem Header="Align Left" Command="{Binding PlacementTarget.Tag.AlignLeftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconAlignLeft}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Align Center" Command="{Binding PlacementTarget.Tag.AlignCenterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconAlignCenter}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Align Right" Command="{Binding PlacementTarget.Tag.AlignRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconAlignRight}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Align Top" Command="{Binding PlacementTarget.Tag.AlignTopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconAlignTop}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Align Middle" Command="{Binding PlacementTarget.Tag.AlignMiddleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconAlignMiddle}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Align Bottom" Command="{Binding PlacementTarget.Tag.AlignBottomCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource IconAlignBottom}" Width="15" Height="15"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Assign IP Address (Manual / Batch)..." Click="ItemContextMenu_AssignIp_Click">
                <MenuItem.Icon>
                    <Path Data="M 7 1 A 6 6 0 1 0 7 13 A 6 6 0 1 0 7 1 M 1 7 H 13 M 7 1 C 4.5 3 4.5 11 7 13 C 9.5 11 9.5 3 7 1" 
                          Stroke="{DynamicResource AppTextPrimaryBrush}" StrokeThickness="1" Fill="Transparent" Width="13" Height="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Change Custom Image..." Click="ItemContextMenu_ChangeImage_Click">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconImage}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Remove Custom Image" Click="ItemContextMenu_RemoveImage_Click"/>
        </ContextMenu>

        <!-- Canvas Background Context Menu -->
        <ContextMenu x:Key="CanvasContextMenu">
            <MenuItem Header="Insert Custom Image..." Click="CanvasContextMenu_InsertImage_Click">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconImage}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Batch Assign Workstation IPs..." Click="CanvasContextMenu_BatchAssignIp_Click">
                <MenuItem.Icon>
                    <Path Data="M 7 1 A 6 6 0 1 0 7 13 A 6 6 0 1 0 7 1 M 1 7 H 13 M 7 1 C 4.5 3 4.5 11 7 13 C 9.5 11 9.5 3 7 1" 
                          Stroke="{DynamicResource AppTextPrimaryBrush}" StrokeThickness="1" Fill="Transparent" Width="13" Height="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Paste" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconPaste}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Select All" Command="{Binding SelectAllCommand}" InputGestureText="Ctrl+A">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconSelectAll}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Zoom In" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconZoomIn}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Zoom Out" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconZoomOut}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Reset Zoom (100%)" Command="{Binding ResetZoomCommand}" InputGestureText="Ctrl+0">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconResetZoom}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Show Grid" IsCheckable="True" IsChecked="{Binding ShowGrid}">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconShowGrid}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Snap to Grid" IsCheckable="True" IsChecked="{Binding SnapToGrid}">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconSnapToGrid}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Show Rulers" IsCheckable="True" IsChecked="{Binding ShowRulers}">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconShowRulers}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconUndo}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconRedo}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid Background="{DynamicResource CanvasWorkspaceBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Top-Left Corner Block -->
        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource CanvasRulerBackgroundBrush}" BorderBrush="{DynamicResource CanvasRulerBorderBrush}" BorderThickness="0,0,1,1">
            <TextBlock Text="px" FontSize="9" Foreground="{DynamicResource CanvasRulerForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Top Horizontal Ruler -->
        <controls:RulerControl x:Name="HorizontalRuler"
                               Grid.Row="0" Grid.Column="1"
                               Orientation="Horizontal"
                               ZoomLevel="{Binding ZoomLevel}"
                               Offset="{Binding PanX}"
                               CursorPosition="{Binding CursorX}"
                               Visibility="{Binding ShowRulers, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Left Vertical Ruler -->
        <controls:RulerControl x:Name="VerticalRuler"
                               Grid.Row="1" Grid.Column="0"
                               Orientation="Vertical"
                               ZoomLevel="{Binding ZoomLevel}"
                               Offset="{Binding PanY}"
                               CursorPosition="{Binding CursorY}"
                               Visibility="{Binding ShowRulers, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Viewport Container -->
        <Border Grid.Row="1" Grid.Column="1" 
                Background="{DynamicResource CanvasWorkspaceBackgroundBrush}" 
                ClipToBounds="True"
                Focusable="True"
                AllowDrop="True"
                RenderOptions.BitmapScalingMode="HighQuality"
                RenderOptions.ClearTypeHint="Enabled"
                ContextMenu="{StaticResource CanvasContextMenu}"
                MouseDown="Viewport_MouseDown"
                MouseMove="Viewport_MouseMove"
                MouseUp="Viewport_MouseUp"
                MouseWheel="Viewport_MouseWheel"
                Drop="Viewport_Drop"
                DragOver="Viewport_DragOver">

            <Grid>
            <Canvas x:Name="CanvasSurface"
                    Width="{Binding CanvasWidth}"
                    Height="{Binding CanvasHeight}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    RenderOptions.ClearTypeHint="Enabled"
                    RenderOptions.EdgeMode="Unspecified">

                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CanvasScale" ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                        <TranslateTransform x:Name="CanvasTranslate" X="{Binding PanX}" Y="{Binding PanY}"/>
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- Dynamic Grid Pattern -->
                <Canvas.Background>
                    <DrawingBrush x:Name="GridBrush" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute"
                                  RenderOptions.BitmapScalingMode="NearestNeighbor"
                                  RenderOptions.EdgeMode="Aliased">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="{DynamicResource CanvasPaperBackgroundBrush}">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,20,20"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="{DynamicResource CanvasGridLineBrush}">
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="{DynamicResource CanvasGridLineBrush}" Thickness="0.75"/>
                                    </GeometryDrawing.Pen>
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="0,20" EndPoint="20,20"/>
                                            <LineGeometry StartPoint="20,0" EndPoint="20,20"/>
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Canvas.Background>

                <!-- Multi-Page Visio Sheet Grid & Page Dividers -->
                <ItemsControl ItemsSource="{Binding PageTiles}" IsHitTestVisible="False" Panel.ZIndex="0"
                              RenderOptions.EdgeMode="Aliased">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="{Binding Width}" Height="{Binding Height}">
                                <!-- Page Perimeter Border (Visio Tile Frame) -->
                                <Border BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        Background="Transparent"/>

                                <!-- Page Number & Preset Stamp (Top-Left of each page tile) -->
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="12,8,0,0"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="6,2"
                                        Opacity="0.75">
                                    <TextBlock Text="{Binding DisplayText}"
                                               FontSize="9.5" FontFamily="Consolas, Segoe UI"
                                               Foreground="{DynamicResource AppTextMutedBrush}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Outer Canvas Boundary (Total Drawing Sheet Perimeter) -->
                <Rectangle Canvas.Left="0" Canvas.Top="0"
                           Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                           Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1.5"
                           IsHitTestVisible="False"/>

                <!-- Interactive Items Container with Local Adorner Decorator -->
                <AdornerDecorator Canvas.Left="0" Canvas.Top="0" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" ClipToBounds="False">
                    <ItemsControl x:Name="ItemsHost" ItemsSource="{Binding Items}" ClipToBounds="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas ClipToBounds="False"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            <Setter Property="Panel.ZIndex" Value="{Binding Z}"/>
                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Setter Property="ClipToBounds" Value="False"/>
                            <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}"/>
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.Resources>
                        <!-- Device DataTemplate -->
                        <DataTemplate DataType="{x:Type items:DeviceItemViewModel}">
                            <Grid Width="{Binding Width}" Height="{Binding Height}"
                                  Cursor="SizeAll"
                                  MouseDown="Item_MouseDown"
                                  Background="Transparent">

                                <Grid.RenderTransform>
                                    <RotateTransform Angle="{Binding Rotation}" CenterX="{Binding Width, Converter={StaticResource HalfValueConverter}}" CenterY="{Binding Height, Converter={StaticResource HalfValueConverter}}"/>
                                </Grid.RenderTransform>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" MinHeight="24"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Device Stencil Drawing (Supports Real-Time Vector Recoloring) -->
                                <Image Grid.Row="0" Stretch="Uniform" Margin="4">
                                    <Image.Source>
                                        <MultiBinding Converter="{StaticResource StencilImageMultiConverter}">
                                            <Binding Path="DeviceType"/>
                                            <Binding Path="Fill"/>
                                            <Binding Path="Stroke"/>
                                            <Binding Path="StrokeThickness"/>
                                            <Binding Path="CustomImagePath"/>
                                            <Binding Path="CustomImageData"/>
                                        </MultiBinding>
                                    </Image.Source>
                                </Image>

                                <!-- Validation Badge (Top-Right) -->
                                <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2"
                                        CornerRadius="8" Padding="3,1"
                                        Visibility="{Binding ValidationStatus, Converter={StaticResource ValidationBadgeVisibilityConverter}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ValidationStatus}" Value="Unassigned">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ValidationStatus}" Value="DuplicateIp">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                    <Setter Property="BorderBrush" Value="#EF4444"/>
                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ValidationStatus}" Value="InvalidIpFormat">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                    <Setter Property="BorderBrush" Value="#EF4444"/>
                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="10" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ValidationStatus}" Value="Unassigned">
                                                        <Setter Property="Text" Value="!"/>
                                                        <Setter Property="ToolTip" Value="Warning: No IP Address assigned!"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ValidationStatus}" Value="DuplicateIp">
                                                        <Setter Property="Text" Value="×"/>
                                                        <Setter Property="ToolTip" Value="Conflict: Duplicate IP Address assigned!"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ValidationStatus}" Value="InvalidIpFormat">
                                                        <Setter Property="Text" Value="!"/>
                                                        <Setter Property="ToolTip" Value="Error: Invalid IPv4 Address format!"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Label Below Device (ONLY DEVICES SHOW LABELS; IP NOT SHOWN ON CANVAS; WRAPS ON BOUNDARY) -->
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Name, Converter={StaticResource DeviceLabelWrapConverter}}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"
                                           MaxWidth="{Binding Width}"
                                           ToolTip="{Binding Name}"
                                           Margin="2,2,2,0"/>
                            </Grid>
                        </DataTemplate>

                        <!-- Furniture DataTemplate -->
                        <DataTemplate DataType="{x:Type items:FurnitureItemViewModel}">
                            <Grid Width="{Binding Width}" Height="{Binding Height}"
                                  Cursor="SizeAll"
                                  MouseDown="Item_MouseDown"
                                  Background="Transparent">

                                <Grid.RenderTransform>
                                    <RotateTransform Angle="{Binding Rotation}" CenterX="{Binding Width, Converter={StaticResource HalfValueConverter}}" CenterY="{Binding Height, Converter={StaticResource HalfValueConverter}}"/>
                                </Grid.RenderTransform>

                                <!-- Furniture Stencil Drawing (Supports Real-Time Vector Recoloring) -->
                                <Image Stretch="Fill">
                                    <Image.Source>
                                        <MultiBinding Converter="{StaticResource StencilImageMultiConverter}">
                                            <Binding Path="FurnitureType"/>
                                            <Binding Path="Fill"/>
                                            <Binding Path="Stroke"/>
                                            <Binding Path="StrokeThickness"/>
                                            <Binding Path="CustomImagePath"/>
                                            <Binding Path="CustomImageData"/>
                                        </MultiBinding>
                                    </Image.Source>
                                </Image>
                            </Grid>
                        </DataTemplate>

                        <!-- Shape DataTemplate -->
                        <DataTemplate DataType="{x:Type items:ShapeItemViewModel}">
                            <Grid ClipToBounds="False"
                                  Cursor="SizeAll"
                                  MouseDown="Item_MouseDown">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Width" Value="{Binding Width}"/>
                                        <Setter Property="Height" Value="{Binding Height}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShapeType}" Value="Line">
                                                <Setter Property="Background" Value="{x:Null}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ShapeType}" Value="Bezier">
                                                <Setter Property="Width" Value="Auto"/>
                                                <Setter Property="Height" Value="Auto"/>
                                                <Setter Property="Background" Value="{x:Null}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Grid.RenderTransform>
                                    <RotateTransform Angle="{Binding Rotation}" CenterX="{Binding Width, Converter={StaticResource HalfValueConverter}}" CenterY="{Binding Height, Converter={StaticResource HalfValueConverter}}"/>
                                </Grid.RenderTransform>

                                <!-- Visual Path -->
                                <Path x:Name="VisiblePath"
                                      Stroke="{Binding Stroke, Converter={StaticResource HexToBrushConverter}}"
                                      StrokeThickness="{Binding StrokeThickness}"
                                      ClipToBounds="False"
                                      Stretch="None">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{Binding Fill, Converter={StaticResource HexToBrushConverter}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShapeType}" Value="Line">
                                                    <Setter Property="Fill" Value="{x:Null}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ShapeType}" Value="Bezier">
                                                    <Setter Property="Fill" Value="{x:Null}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                    <Path.Data>
                                        <MultiBinding Converter="{StaticResource ShapeToGeometryConverter}">
                                            <Binding />
                                            <Binding Path="CornerRadius" />
                                            <Binding Path="InnerRadius" />
                                            <Binding Path="ShapeType" />
                                            <Binding Path="Width" />
                                            <Binding Path="Height" />
                                            <Binding Path="ControlPoint1X" />
                                            <Binding Path="ControlPoint1Y" />
                                            <Binding Path="ControlPoint2X" />
                                            <Binding Path="ControlPoint2Y" />
                                            <Binding Path="StartX" />
                                            <Binding Path="StartY" />
                                            <Binding Path="EndX" />
                                            <Binding Path="EndY" />
                                        </MultiBinding>
                                    </Path.Data>
                                </Path>

                                <!-- Hit-test buffer: makes clicking thin lines/curves effortless without selecting on whitespace -->
                                <Path Stroke="Transparent"
                                      StrokeThickness="12"
                                      ClipToBounds="False"
                                      Stretch="None"
                                      Data="{Binding Data, ElementName=VisiblePath}"/>
                            </Grid>
                        </DataTemplate>

                        <!-- Text Item DataTemplate -->
                        <DataTemplate DataType="{x:Type items:TextItemViewModel}">
                            <Grid Width="{Binding Width}" Height="{Binding Height}"
                                  Cursor="SizeAll"
                                  MouseDown="Item_MouseDown"
                                  Background="Transparent">

                                <Grid.RenderTransform>
                                    <RotateTransform Angle="{Binding Rotation}" CenterX="{Binding Width, Converter={StaticResource HalfValueConverter}}" CenterY="{Binding Height, Converter={StaticResource HalfValueConverter}}"/>
                                </Grid.RenderTransform>

                                <Border Background="{Binding Background, Converter={StaticResource HexToBrushConverter}}"
                                        BorderBrush="{Binding BorderColor, Converter={StaticResource HexToBrushConverter}}"
                                        BorderThickness="{Binding BorderThickness}"
                                        CornerRadius="3"
                                        Padding="4">
                                    <Grid>
                                        <!-- Display TextBlock (when NOT editing) -->
                                        <TextBlock Text="{Binding Text}"
                                                   FontSize="{Binding FontSize}"
                                                   FontFamily="{Binding FontFamily}"
                                                   FontWeight="{Binding FontWeight}"
                                                   FontStyle="{Binding FontStyle}"
                                                   TextAlignment="{Binding TextAlignment, Converter={StaticResource TextAlignmentConverter}}"
                                                   Foreground="{Binding TextColor, Converter={StaticResource HexToBrushConverter}}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                        <!-- In-Place Editable TextBox (when editing) -->
                                        <TextBox x:Name="InPlaceTextBox"
                                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="{Binding FontSize}"
                                                 FontFamily="{Binding FontFamily}"
                                                 FontWeight="{Binding FontWeight}"
                                                 FontStyle="{Binding FontStyle}"
                                                 TextAlignment="{Binding TextAlignment, Converter={StaticResource TextAlignmentConverter}}"
                                                 Foreground="{Binding TextColor, Converter={StaticResource HexToBrushConverter}}"
                                                 Background="White"
                                                 BorderBrush="#3B82F6"
                                                 BorderThickness="1.5"
                                                 Padding="2"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalAlignment="Stretch"
                                                 HorizontalAlignment="Stretch"
                                                 Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 IsVisibleChanged="InPlaceTextBox_IsVisibleChanged"
                                                 KeyDown="InPlaceTextBox_KeyDown"
                                                 LostFocus="InPlaceTextBox_LostFocus"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>

                        <!-- Group DataTemplate -->
                        <DataTemplate DataType="{x:Type items:GroupItemViewModel}">
                            <Grid Width="{Binding Width}" Height="{Binding Height}"
                                  Cursor="SizeAll"
                                  MouseDown="Item_MouseDown"
                                  Background="Transparent">

                                <Grid.RenderTransform>
                                    <RotateTransform Angle="{Binding Rotation}" CenterX="{Binding Width, Converter={StaticResource HalfValueConverter}}" CenterY="{Binding Height, Converter={StaticResource HalfValueConverter}}"/>
                                </Grid.RenderTransform>

                                <!-- Subtle bounding box for group -->
                                <Rectangle Stroke="#9CA3AF" StrokeThickness="1" StrokeDashArray="4 2" IsHitTestVisible="False"/>

                                <!-- Children Items -->
                                <ItemsControl ItemsSource="{Binding Children}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource RelativeOffsetConverter}">
                                                        <Binding Path="X"/>
                                                        <Binding Path="DataContext.X" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Canvas.Top">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource RelativeOffsetConverter}">
                                                        <Binding Path="Y"/>
                                                        <Binding Path="DataContext.Y" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Panel.ZIndex" Value="{Binding Z}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>
                </AdornerDecorator>

                <!-- Marquee Selection Rectangle -->
                <Rectangle x:Name="RubberbandRect"
                           Stroke="{DynamicResource AccentPrimaryBrush}" StrokeThickness="1.5" StrokeDashArray="3 2"
                           Fill="{DynamicResource AccentSubtleBrush}" Opacity="0.7"
                           Visibility="Collapsed"
                           Panel.ZIndex="9998"
                           IsHitTestVisible="False"/>

                <!-- Dynamic Magnetic Snap Guide Lines -->
                <Line x:Name="SnapGuideVertical"
                      Stroke="#EC4899" StrokeThickness="1.5" StrokeDashArray="4 2"
                      Visibility="Collapsed"
                      Panel.ZIndex="9999"
                      IsHitTestVisible="False"/>
                <Line x:Name="SnapGuideHorizontal"
                      Stroke="#EC4899" StrokeThickness="1.5" StrokeDashArray="4 2"
                      Visibility="Collapsed"
                      Panel.ZIndex="9999"
                      IsHitTestVisible="False"/>

                <!-- Drag & Drop Ghost Preview -->
                <Border x:Name="DragGhost"
                        BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1.5"
                        Background="{DynamicResource AccentSubtleBrush}" CornerRadius="4" Opacity="0.75"
                        Visibility="Collapsed"
                        Panel.ZIndex="10000"
                        IsHitTestVisible="False"/>

                <!-- Canvas Paper Sheet Border Outline -->
                <Rectangle Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                           Stroke="{DynamicResource CanvasPaperBorderBrush}" StrokeThickness="1"
                           IsHitTestVisible="False" Panel.ZIndex="0"/>

            </Canvas>

            <!-- ==================================================== -->
            <!-- FLOATING MODERN VIEWPORT HUD TOOLBAR (Bottom-Right)  -->
            <!-- ==================================================== -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,20"
                    Background="{DynamicResource HudBackgroundBrush}"
                    BorderBrush="{DynamicResource HudBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="5,3"
                    Panel.ZIndex="50000"
                    Focusable="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.14" Color="#000000"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Zoom Out Button -->
                    <Button Command="{Binding ZoomOutCommand}" ToolTip="Zoom Out (Ctrl+-)"
                            Style="{StaticResource HudButtonStyle}">
                        <TextBlock Text="−" FontSize="15" FontWeight="Bold" Margin="0,-2,0,0"/>
                    </Button>

                    <!-- Zoom Level Pill / Reset -->
                    <Button Command="{Binding ResetZoomCommand}" ToolTip="Reset Zoom to 100% (Ctrl+0)"
                            Style="{StaticResource HudPillButtonStyle}">
                        <TextBlock Text="{Binding ZoomLevel, StringFormat='{}{0:P0}'}" FontSize="11" FontWeight="SemiBold"/>
                    </Button>

                    <!-- Zoom In Button -->
                    <Button Command="{Binding ZoomInCommand}" ToolTip="Zoom In (Ctrl++)"
                            Style="{StaticResource HudButtonStyle}">
                        <TextBlock Text="+" FontSize="14" FontWeight="Bold" Margin="0,-1,0,0"/>
                    </Button>

                    <!-- Separator -->
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource HudBorderBrush}" Margin="4,0"/>

                    <!-- Fit to Page -->
                    <Button Command="{Binding FitToPageCommand}" ToolTip="Fit Page to View"
                            Style="{StaticResource HudButtonStyle}">
                        <Image Source="{StaticResource IconFitPage}" Width="14" Height="14"/>
                    </Button>

                    <!-- Fit to Content -->
                    <Button Command="{Binding FitToContentCommand}" ToolTip="Fit Content to View"
                            Style="{StaticResource HudButtonStyle}">
                        <Image Source="{StaticResource IconResetZoom}" Width="14" Height="14"/>
                    </Button>

                    <!-- Grid Toggle -->
                    <ToggleButton IsChecked="{Binding ShowGrid}" ToolTip="Toggle Grid (G)"
                                  Style="{StaticResource HudToggleButtonStyle}">
                        <Image Source="{StaticResource IconShowGrid}" Width="14" Height="14"/>
                    </ToggleButton>

                    <!-- Snap to Grid Toggle -->
                    <ToggleButton IsChecked="{Binding SnapToGrid}" ToolTip="Toggle Snap to Grid (S)"
                                  Style="{StaticResource HudToggleButtonStyle}">
                        <Image Source="{StaticResource IconSnapToGrid}" Width="14" Height="14"/>
                    </ToggleButton>
                </StackPanel>
            </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
