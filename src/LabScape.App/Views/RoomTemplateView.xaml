<UserControl x:Class="LabScape.App.Views.RoomTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:templates="clr-namespace:LabScape.ViewModels.Templates;assembly=LabScape.ViewModels"
             xmlns:enums="clr-namespace:LabScape.Core.Enums;assembly=LabScape.Core"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="280">

    <Grid Background="{DynamicResource PanelBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10,12,10,16">

                <!-- Header Banner -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource IconRoomTemplate}" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Room Templates" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Automated lab &amp; room generator with modular desks and line walls."
                                   TextWrapping="Wrap" FontSize="10.5"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="28,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 1. Wall Boundary & Sides -->
                <GroupBox Header="1. Room Walls &amp; Shape" FontWeight="SemiBold"
                          Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,10">
                    <StackPanel Margin="4,6" TextElement.FontWeight="Normal">
                        <TextBlock Text="Select boundary configuration:" FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,8"/>

                        <!-- Radio Buttons for Sides -->
                        <StackPanel Margin="2,0,0,8">
                            <RadioButton Content="4 Sides (Full Enclosed Room)"
                                         GroupName="RoomSidesGroup"
                                         IsChecked="{Binding Sides, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=4}"
                                         Margin="0,0,0,7" FontWeight="SemiBold"/>
                            <RadioButton Content="3 Sides (U-Shape / Open Entrance)"
                                         GroupName="RoomSidesGroup"
                                         IsChecked="{Binding Sides, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=3}"
                                         Margin="0,0,0,7" FontWeight="SemiBold"/>
                            <RadioButton Content="2 Sides (Corner / Opposite Rows)"
                                         GroupName="RoomSidesGroup"
                                         IsChecked="{Binding Sides, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=2}"
                                         Margin="0,0,0,7" FontWeight="SemiBold"/>
                            <RadioButton Content="1 Side (Bench / Single Wall)"
                                         GroupName="RoomSidesGroup"
                                         IsChecked="{Binding Sides, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=1}"
                                         Margin="0,0,0,7" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Open Side Selector (For 3 Sides) -->
                        <StackPanel Visibility="{Binding Is3SidesVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,2,0,8">
                            <TextBlock Text="Open Entrance Side:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                            <ComboBox SelectedValue="{Binding OpenSide}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="South (Bottom Entrance)" Tag="{x:Static enums:WallSide.South}"/>
                                <ComboBoxItem Content="North (Top Entrance)" Tag="{x:Static enums:WallSide.North}"/>
                                <ComboBoxItem Content="East (Right Entrance)" Tag="{x:Static enums:WallSide.East}"/>
                                <ComboBoxItem Content="West (Left Entrance)" Tag="{x:Static enums:WallSide.West}"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- 2-Side Selector (For 2 Sides: Corner or Opposite) -->
                        <StackPanel Visibility="{Binding Is2SidesVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,2,0,8">
                            <TextBlock Text="2-Side Layout &amp; Orientation:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                            <ComboBox SelectedValue="{Binding CornerOption}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="North &amp; South (Opposite Facing Rows)" Tag="NorthSouth"/>
                                <ComboBoxItem Content="West &amp; East (Opposite Facing Columns)" Tag="EastWest"/>
                                <ComboBoxItem Content="North &amp; West (L-Corner Top-Left)" Tag="NorthWest"/>
                                <ComboBoxItem Content="North &amp; East (L-Corner Top-Right)" Tag="NorthEast"/>
                                <ComboBoxItem Content="South &amp; West (L-Corner Bottom-Left)" Tag="SouthWest"/>
                                <ComboBoxItem Content="South &amp; East (L-Corner Bottom-Right)" Tag="SouthEast"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Single Side Selector (For 1 Side) -->
                        <StackPanel Visibility="{Binding Is1SideVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,2,0,8">
                            <TextBlock Text="Wall Direction:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                            <ComboBox SelectedValue="{Binding SingleSide}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="North (Top Wall)" Tag="{x:Static enums:WallSide.North}"/>
                                <ComboBoxItem Content="South (Bottom Wall)" Tag="{x:Static enums:WallSide.South}"/>
                                <ComboBoxItem Content="West (Left Wall)" Tag="{x:Static enums:WallSide.West}"/>
                                <ComboBoxItem Content="East (Right Wall)" Tag="{x:Static enums:WallSide.East}"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Autonomy Line Notice -->
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,4,0,0">
                            <TextBlock Text="💡 Boundaries are generated as individual Line segments (never a rigid rectangle) for custom doors &amp; openings."
                                       TextWrapping="Wrap" FontSize="10" Foreground="#15803D" LineHeight="14"/>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- 2. Workstations & Equipment -->
                <GroupBox Header="2. Workstations &amp; Equipment" FontWeight="SemiBold"
                          Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,10">
                    <StackPanel Margin="4,6" TextElement.FontWeight="Normal">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PCs:" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,8,0"/>
                            <Slider Grid.Column="1" Minimum="1" Maximum="48"
                                    Value="{Binding PcCount, Mode=TwoWay}"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    VerticalAlignment="Center" Margin="4,0"/>
                            <TextBox Grid.Column="2" Text="{Binding PcCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextAlignment="Center" FontWeight="Bold" Padding="2" FontSize="11"/>
                        </Grid>

                        <CheckBox Content="Modular Desks (120×70)" IsChecked="{Binding IncludeDesks}"
                                  Margin="0,0,0,6" FontSize="11"/>
                        <CheckBox Content="Swivel Chairs (Facing Desks)" IsChecked="{Binding IncludeChairs}"
                                  Margin="0,0,0,6" FontSize="11"/>
                        <CheckBox Content="Group Components (Ctrl+G)" IsChecked="{Binding GroupElements}"
                                  FontWeight="SemiBold" Margin="0,0,0,2" FontSize="11"/>
                    </StackPanel>
                </GroupBox>

                <!-- 3. Live Preview & Drag Card -->
                <GroupBox Header="3. Layout Preview &amp; Drag" FontWeight="SemiBold"
                          Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,12">
                    <StackPanel Margin="4,6" TextElement.FontWeight="Normal">
                        <Border x:Name="DragCard"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10"
                                Cursor="Hand"
                                ToolTip="Click and drag onto canvas, or click 'Generate Room' below"
                                MouseLeftButtonDown="DragCard_MouseLeftButtonDown"
                                MouseMove="DragCard_MouseMove">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock Text="📐 Room Dimensions:" FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SummaryDimensions}" FontWeight="Bold" FontSize="11"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock Text="🧱 Boundary Walls:" FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SummaryWalls}" FontSize="10.5"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock Text="🖥️ Workstation Breakdown:" FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,2"/>
                                <TextBlock Text="{Binding SummaryDistribution}" FontWeight="SemiBold" FontSize="10.5"
                                           Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap" Margin="4,0,0,6"/>

                                <Border Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="6,4" Margin="0,4,0,0">
                                    <TextBlock Text="🖱️ Drag this card onto the canvas" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- Actions -->
                <StackPanel Margin="0,0,0,4">
                    <Button x:Name="BtnGenerateRoom"
                            Content="➕ Generate Room on Canvas"
                            Command="{Binding GenerateRoomCommand}"
                            Click="BtnGenerateRoom_Click"
                            Padding="14,9" FontWeight="Bold" FontSize="12"
                            Foreground="White" Cursor="Hand"
                            Margin="0,0,0,8">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="BtnResetDefaults"
                            Content="Reset Defaults"
                            Command="{Binding ResetDefaultsCommand}"
                            Click="BtnResetDefaults_Click"
                            Padding="10,6" FontSize="11"
                            Foreground="{DynamicResource AppTextSecondaryBrush}"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="rstBorder" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="rstBorder" Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}"/>
                                                    <Setter TargetName="rstBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="rstBorder" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
