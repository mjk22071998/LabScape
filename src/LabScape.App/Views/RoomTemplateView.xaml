<UserControl x:Class="LabScape.App.Views.RoomTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:templates="clr-namespace:LabScape.ViewModels.Templates;assembly=LabScape.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="280">

    <Grid Background="{DynamicResource PanelBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10,12,10,16">

                <!-- 1. Header Banner -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource IconRoomTemplate}" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Room Templates" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Catalog of persistent CAD room templates with modular workstations &amp; walls."
                                   TextWrapping="Wrap" FontSize="10.5"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="28,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 2. Primary Action: Create New Template -->
                <Button x:Name="BtnCreateNew"
                        Content="➕ Create New Template..."
                        Click="BtnCreateNew_Click"
                        Padding="12,9" FontWeight="Bold" FontSize="12"
                        Foreground="White" Cursor="Hand"
                        Margin="0,0,0,12">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 3. Saved Templates Catalog (Persistent List) -->
                <GroupBox Header="Saved Templates Catalog" FontWeight="SemiBold"
                          Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,12">
                    <StackPanel Margin="2,6" TextElement.FontWeight="Normal">
                        <TextBlock Text="Select a template, drag onto canvas, or insert directly:"
                                   FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="2,0,0,8"/>

                        <!-- Template Items List -->
                        <ItemsControl ItemsSource="{Binding SavedTemplates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type templates:SavedRoomTemplate}">
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="7" Padding="9,8" Margin="0,0,0,8"
                                            Cursor="Hand"
                                            ToolTip="Click to select, drag onto canvas, or click Insert"
                                            MouseLeftButtonDown="TemplateCard_MouseLeftButtonDown"
                                            MouseMove="TemplateCard_MouseMove">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                                        <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Title & Badges -->
                                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                                <!-- Delete button for custom templates -->
                                                <Button DockPanel.Dock="Right" Content="✕"
                                                        ToolTip="Delete saved template"
                                                        Click="BtnDeleteTemplate_Click"
                                                        Tag="{Binding}"
                                                        Width="18" Height="18" FontSize="10" FontWeight="Bold"
                                                        Foreground="#E11D48" Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" Margin="4,0,0,0"/>

                                                <!-- Template Name -->
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DockPanel>

                                            <!-- Row 1: Badges & Dimensions -->
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,6">
                                                <!-- PCs Pill -->
                                                <Border Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding SummaryBadge}" FontSize="9.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                                </Border>
                                                <!-- Dimensions Pill -->
                                                <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="5,1">
                                                    <TextBlock Text="{Binding SummaryDimensions}" FontSize="9.5" FontFamily="Consolas, Segoe UI"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Row 2: Description & Insert Action Button -->
                                            <DockPanel Grid.Row="2">
                                                <Button DockPanel.Dock="Right"
                                                        Content="➕ Insert"
                                                        ToolTip="Insert into active canvas"
                                                        Click="BtnInsertTemplate_Click"
                                                        Tag="{Binding}"
                                                        Padding="8,3" FontSize="10.5" FontWeight="SemiBold"
                                                        Background="{DynamicResource AccentSubtleBrush}"
                                                        Foreground="{DynamicResource AccentPrimaryBrush}"
                                                        BorderBrush="{DynamicResource AccentBorderBrush}"
                                                        BorderThickness="1" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

                <!-- 4. Selected Template Quick Drag Card -->
                <GroupBox Header="Interactive Canvas Placement" FontWeight="SemiBold"
                          Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,12">
                    <StackPanel Margin="4,6" TextElement.FontWeight="Normal">
                        <Border x:Name="DragCard"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10"
                                Cursor="Hand"
                                ToolTip="Click and drag onto canvas, or click 'Generate Room' below"
                                MouseLeftButtonDown="DragCard_MouseLeftButtonDown"
                                MouseMove="DragCard_MouseMove">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock Text="📐 Room Dimensions:" FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SummaryDimensions}" FontWeight="Bold" FontSize="11"
                                               FontFamily="Consolas, Segoe UI"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock Text="🧱 Boundary Walls:" FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SummaryWalls}" FontSize="10.5"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock Text="🖥️ Workstation Breakdown:" FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,2"/>
                                <TextBlock Text="{Binding SummaryDistribution}" FontWeight="SemiBold" FontSize="10.5"
                                           Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap" Margin="4,0,0,6"/>

                                <Border Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}"
                                        BorderThickness="1" CornerRadius="5" Padding="6,4" Margin="0,4,0,0">
                                    <TextBlock Text="🖱️ Drag this card directly onto canvas" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- Actions -->
                <StackPanel Margin="0,0,0,4">
                    <Button x:Name="BtnGenerateRoom"
                            Content="➕ Generate Room at Canvas Center"
                            Command="{Binding GenerateRoomCommand}"
                            Click="BtnGenerateRoom_Click"
                            Padding="12,8" FontWeight="Bold" FontSize="11.5"
                            Foreground="White" Cursor="Hand"
                            Margin="0,0,0,8">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="BtnResetDefaults"
                            Content="Restore Built-in Presets"
                            Command="{Binding ResetDefaultsCommand}"
                            Click="BtnResetDefaults_Click"
                            Padding="10,6" FontSize="11"
                            Foreground="{DynamicResource AppTextSecondaryBrush}"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="rstBorder" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="rstBorder" Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}"/>
                                                    <Setter TargetName="rstBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="rstBorder" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
