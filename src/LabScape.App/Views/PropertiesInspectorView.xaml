<UserControl x:Class="LabScape.App.Views.PropertiesInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:LabScape.Core.Models;assembly=LabScape.Core"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="300">

    <Grid Background="#F9FAFB">
        <!-- When No Item Selected -->
        <TextBlock Text="No item selected&#x0a;Click an item on the canvas to inspect its properties."
                   Foreground="#9CA3AF" FontSize="12" TextAlignment="Center" VerticalAlignment="Center"
                   Margin="16" TextWrapping="Wrap"
                   Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelection}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasSelection}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- When Item Selected -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelection}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasSelection}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel Margin="12">

                <!-- Header / Item Type Banner -->
                <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedItem.ItemType, StringFormat='ITEM TYPE: {0}'}"
                                   FontWeight="Bold" FontSize="11" Foreground="#4338CA"/>
                        <TextBlock Text="{Binding SelectedItem.Name}" FontSize="13" FontWeight="SemiBold" Foreground="#1E1B4B" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 1. Identity & Name -->
                <GroupBox Header="Identity" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="#374151">
                    <StackPanel Margin="6" TextElement.FontWeight="Normal">
                        <TextBlock Text="Item Name:" FontSize="11" Foreground="#4B5563" Margin="0,2,0,2"/>
                        <TextBox Text="{Binding SelectedItem.Name, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,6"/>

                        <!-- Note for Group Name -->
                        <TextBlock Text="ℹ️ Group name is saved in schema and exported, but hidden from canvas layout."
                                   FontSize="10" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Visibility="{Binding IsGroup, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </GroupBox>

                <!-- 2. Device IP Configuration (Searchable Dropdown) -->
                <GroupBox Header="Network &amp; IP Configuration" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="#374151"
                          Visibility="{Binding IsDevice, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="6" TextElement.FontWeight="Normal">
                        <TextBlock Text="IP Address (Manual or from Database):" FontSize="11" Foreground="#4B5563" Margin="0,2,0,2"/>
                        <TextBox Text="{Binding SelectedItem.IpAddress, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,6"/>

                        <TextBlock Text="MAC Address:" FontSize="11" Foreground="#4B5563" Margin="0,2,0,2"/>
                        <TextBox Text="{Binding SelectedItem.MacAddress, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,8"/>

                        <!-- Searchable Inventory Picker -->
                        <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="6">
                            <StackPanel>
                                <TextBlock Text="Link from Database Inventory:" FontWeight="SemiBold" FontSize="11" Foreground="#1F2937" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding IpSearchQuery, UpdateSourceTrigger=PropertyChanged}" Padding="3" Margin="0,0,0,4"/>
                                <ListBox ItemsSource="{Binding FilteredDatabaseDevices}" MaxHeight="140"
                                         SelectionChanged="DatabaseDevicesListBox_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:DatabaseDevice}">
                                            <StackPanel Margin="2">
                                                <TextBlock FontWeight="SemiBold" FontSize="11" Text="{Binding DisplayName}"/>
                                                <TextBlock FontSize="10" Foreground="#4B5563" Text="{Binding PrimaryIp, StringFormat='IP: {0}'}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- 3. Coordinates & Layering (All Items) -->
                <GroupBox Header="Transform &amp; Coordinates" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="#374151">
                    <Grid Margin="6" TextElement.FontWeight="Normal">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- X -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="X (px):" VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.X, UpdateSourceTrigger=PropertyChanged}" Padding="3" Margin="0,3"/>

                        <!-- Y -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Y (px):" VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.Y, UpdateSourceTrigger=PropertyChanged}" Padding="3" Margin="0,3"/>

                        <!-- Z (Layering) -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Z (Layer):" VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.Z, UpdateSourceTrigger=PropertyChanged}" Padding="3" Margin="0,3"/>

                        <!-- Layer Order Action Buttons -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,6">
                            <Button Content="▲ Front" Command="{Binding MoveToFrontCommand}" ToolTip="Move to Front (Ctrl+Shift+])" Padding="5,2" Margin="1,0" FontSize="10"/>
                            <Button Content="↑ Forward" Command="{Binding MoveForwardCommand}" ToolTip="Move Forward (Ctrl+])" Padding="5,2" Margin="1,0" FontSize="10"/>
                            <Button Content="↓ Backward" Command="{Binding SendBackwardCommand}" ToolTip="Send Backward (Ctrl+[)" Padding="5,2" Margin="1,0" FontSize="10"/>
                            <Button Content="▼ Back" Command="{Binding SendToBackCommand}" ToolTip="Send to Back (Ctrl+Shift+[)" Padding="5,2" Margin="1,0" FontSize="10"/>
                        </StackPanel>

                        <!-- Width -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Width:" VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedItem.Width, UpdateSourceTrigger=PropertyChanged}" Padding="3" Margin="0,3"/>

                        <!-- Height -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Height:" VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedItem.Height, UpdateSourceTrigger=PropertyChanged}" Padding="3" Margin="0,3"/>
                    </Grid>
                </GroupBox>

                <!-- 4. Shape Parameters (Corner Radius & Donut Inner Radius) -->
                <GroupBox Header="Shape Parameters" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="#374151"
                          Visibility="{Binding IsShape, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="6" TextElement.FontWeight="Normal">

                        <!-- Corner Radius -->
                        <StackPanel Visibility="{Binding IsRoundedShape, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="Corner Radius (px):" FontSize="11" Foreground="#4B5563"/>
                                <TextBlock Text="{Binding SelectedItem.CornerRadius, StringFormat='{}{0:F0} px'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="60" Value="{Binding SelectedItem.CornerRadius}" TickFrequency="2" IsSnapToTickEnabled="True"/>
                        </StackPanel>

                        <!-- Donut Inner Radius -->
                        <StackPanel Visibility="{Binding IsDonut, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="Donut Inner Radius (%):" FontSize="11" Foreground="#4B5563"/>
                                <TextBlock Text="{Binding SelectedItem.InnerRadius, StringFormat='{}{0:F0}'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </DockPanel>
                            <Slider Minimum="5" Maximum="45" Value="{Binding SelectedItem.InnerRadius}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </StackPanel>

                        <!-- Stroke Thickness -->
                        <DockPanel Margin="0,4,0,2">
                            <TextBlock Text="Stroke Thickness:" FontSize="11" Foreground="#4B5563"/>
                            <TextBlock Text="{Binding SelectedItem.StrokeThickness, StringFormat='{}{0:F0} px'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </DockPanel>
                        <Slider Minimum="1" Maximum="10" Value="{Binding SelectedItem.StrokeThickness}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
