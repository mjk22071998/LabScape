<UserControl x:Class="LabScape.App.Views.PropertiesInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:LabScape.Core.Models;assembly=LabScape.Core"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="300">

    <Grid Background="{DynamicResource PanelBackgroundBrush}">
        <!-- When No Item Selected -->
        <Border VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelection}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="No item selected"
                           FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource AppTextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="Click an item on the canvas to view and edit its properties."
                           FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="220"/>
            </StackPanel>
        </Border>

        <!-- When Item Selected -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelection}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel Margin="12">

                <!-- Header / Item Type Banner -->
                <Border Background="{DynamicResource SectionHeaderBackgroundBrush}" BorderBrush="{DynamicResource SectionHeaderBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding HeaderTitle}"
                                   FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SectionHeaderForegroundBrush}"/>
                        <TextBlock Text="{Binding HeaderSubtitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SectionHeaderSubForegroundBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 1. Identity & Name -->
                <GroupBox Header="Identity" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}">
                    <StackPanel Margin="6" TextElement.FontWeight="Normal">
                        <TextBlock Text="Item Name:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,2"/>
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSingleSelection}" Padding="4" Margin="0,0,0,6"/>

                        <!-- Note for Group Name -->
                        <TextBlock Text="ℹ️ Group name is saved in schema and exported, but hidden from canvas layout."
                                   FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Visibility="{Binding IsGroup, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="ℹ️ Name editing disabled for multiple selected items."
                                   FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Visibility="{Binding IsMultiSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </GroupBox>

                <!-- 2. Device IP Configuration (Searchable Dropdown) -->
                <GroupBox Header="Network &amp; IP Configuration" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"
                          Visibility="{Binding IsSingleDevice, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="6" TextElement.FontWeight="Normal">
                        <TextBlock Text="IP Address (Manual or from Database):" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,2"/>
                        <TextBox Text="{Binding SelectedItem.IpAddress, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,6"/>

                        <TextBlock Text="MAC Address:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,2"/>
                        <TextBox Text="{Binding SelectedItem.MacAddress, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,8"/>

                        <!-- Searchable Inventory Picker -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
                            <StackPanel>
                                <TextBlock Text="Link from Database Inventory:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding IpSearchQuery, UpdateSourceTrigger=PropertyChanged}" Padding="3" Margin="0,0,0,4"/>
                                <ListBox ItemsSource="{Binding FilteredDatabaseDevices}" MaxHeight="140"
                                         SelectionChanged="DatabaseDevicesListBox_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:DatabaseDevice}">
                                            <StackPanel Margin="2">
                                                <TextBlock FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding DisplayName}"/>
                                                <TextBlock FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding PrimaryIp, StringFormat='IP: {0}'}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- 3. Transform & Coordinates (Geometric Dimensions) -->
                <GroupBox Header="Transform &amp; Coordinates" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}">
                    <Grid Margin="6" TextElement.FontWeight="Normal">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- X (Disabled on multi-selection as requested) -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="X (px):" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DisplayX, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditCoordinates}"
                                 ToolTip="{Binding CoordinatesToolTip}" Padding="3" Margin="0,3"/>

                        <!-- Y (Disabled on multi-selection as requested) -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Y (px):" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DisplayY, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditCoordinates}"
                                 ToolTip="{Binding CoordinatesToolTip}" Padding="3" Margin="0,3"/>

                        <!-- Width (Common Property) -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Width:" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CommonWidth, UpdateSourceTrigger=PropertyChanged}" Padding="3" Margin="0,3"/>

                        <!-- Height (Common Property) -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Height:" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CommonHeight, UpdateSourceTrigger=PropertyChanged}" Padding="3" Margin="0,3"/>

                        <!-- Rotation (Common Property) -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Rotation:" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CommonRotation, UpdateSourceTrigger=PropertyChanged}" Padding="3" Margin="0,3"/>
                    </Grid>
                </GroupBox>

                <!-- 4. Layering & Stacking Order (Dedicated Proper Section) -->
                <GroupBox Header="Layering &amp; Order" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}">
                    <StackPanel Margin="6" TextElement.FontWeight="Normal">
                        <!-- Z-Index Input -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Z (Layer):" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding CommonZ, UpdateSourceTrigger=PropertyChanged}" Padding="3"/>
                        </Grid>

                        <!-- Standard Layer Action Buttons with Vector Icons -->
                        <UniformGrid Columns="2" Rows="2" Margin="0,2,0,2">
                            <Button Command="{Binding MoveToFrontCommand}" ToolTip="Bring to Front (Ctrl+Shift+])" Margin="2" Padding="6,5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource IconMoveToFront}" Width="15" Height="15" Margin="0,0,6,0"/>
                                    <TextBlock Text="To Front" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding MoveForwardCommand}" ToolTip="Bring Forward (Ctrl+])" Margin="2" Padding="6,5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource IconMoveForward}" Width="15" Height="15" Margin="0,0,6,0"/>
                                    <TextBlock Text="Forward" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SendBackwardCommand}" ToolTip="Send Backward (Ctrl+[)" Margin="2" Padding="6,5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource IconSendBackward}" Width="15" Height="15" Margin="0,0,6,0"/>
                                    <TextBlock Text="Backward" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SendToBackCommand}" ToolTip="Send to Back (Ctrl+Shift+[)" Margin="2" Padding="6,5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource IconSendToBack}" Width="15" Height="15" Margin="0,0,6,0"/>
                                    <TextBlock Text="To Back" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </GroupBox>

                <!-- 5. Appearance & Style (Fill & Stroke) -->
                <GroupBox Header="Appearance &amp; Style" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"
                          Visibility="{Binding IsShape, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="6" TextElement.FontWeight="Normal">

                        <!-- FILL SECTION (Hidden for open paths: Line and Bezier) -->
                        <StackPanel Visibility="{Binding IsFillApplicable, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12">
                            <!-- Fill Header & Live Preview -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Fill Appearance:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right" Width="70" Height="18" CornerRadius="3"
                                        BorderBrush="{DynamicResource SectionHeaderBorderBrush}" BorderThickness="1"
                                        Background="{Binding FillBrushString, Converter={StaticResource HexToBrushConverter}}"
                                        ToolTip="Live Fill Preview"/>
                            </DockPanel>

                            <!-- Fill Type Selector -->
                            <ComboBox ItemsSource="{Binding AvailableFillTypesList}" SelectedItem="{Binding FillType}" DropDownClosed="FillTypeComboBox_DropDownClosed" Margin="0,0,0,6" Padding="4,3"/>

                            <!-- Solid Fill Controls -->
                            <StackPanel Visibility="{Binding IsSolidFill, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="3" BorderBrush="#94A3B8" BorderThickness="1"
                                            Background="{Binding FillColor1, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding FillColor1, UpdateSourceTrigger=PropertyChanged}" LostFocus="FillTextBox_LostFocus" KeyDown="FillTextBox_KeyDown" Padding="3" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- Quick Swatches -->
                                <ItemsControl ItemsSource="{Binding AvailablePresetColors}" Margin="0,2,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="18" Height="18" Margin="1" Padding="0" Cursor="Hand"
                                                    Command="{Binding DataContext.SetFillColor1Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{Binding Converter={StaticResource HexToBrushConverter}}"
                                                                BorderBrush="#64748B" BorderThickness="0.5" CornerRadius="2"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Linear Gradient Fill Controls -->
                            <StackPanel Visibility="{Binding IsLinearGradientFill, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <!-- Start Color -->
                                <TextBlock Text="Start Color:" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,2"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="3" BorderBrush="#94A3B8" BorderThickness="1"
                                            Background="{Binding FillColor1, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding FillColor1, UpdateSourceTrigger=PropertyChanged}" LostFocus="FillTextBox_LostFocus" KeyDown="FillTextBox_KeyDown" Padding="3" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding AvailablePresetColors}" Margin="0,1,0,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="18" Height="18" Margin="1" Padding="0" Cursor="Hand"
                                                    Command="{Binding DataContext.SetFillColor1Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{Binding Converter={StaticResource HexToBrushConverter}}"
                                                                BorderBrush="#64748B" BorderThickness="0.5" CornerRadius="2"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- End Color -->
                                <DockPanel Margin="0,2,0,2">
                                    <TextBlock Text="End Color:" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Button Command="{Binding SwapFillColorsCommand}" HorizontalAlignment="Right" Padding="4,1" Margin="0" FontSize="10"
                                            ToolTip="Swap Start and End Colors" Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}">
                                        <TextBlock Text="⇄ Swap" FontSize="10"/>
                                    </Button>
                                </DockPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="3" BorderBrush="#94A3B8" BorderThickness="1"
                                            Background="{Binding FillColor2, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding FillColor2, UpdateSourceTrigger=PropertyChanged}" LostFocus="FillTextBox_LostFocus" KeyDown="FillTextBox_KeyDown" Padding="3" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding AvailablePresetColors}" Margin="0,1,0,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="18" Height="18" Margin="1" Padding="0" Cursor="Hand"
                                                    Command="{Binding DataContext.SetFillColor2Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{Binding Converter={StaticResource HexToBrushConverter}}"
                                                                BorderBrush="#64748B" BorderThickness="0.5" CornerRadius="2"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Direction -->
                                <TextBlock Text="Gradient Direction:" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableDirectionOptions}" SelectedItem="{Binding SelectedFillDirection}" DropDownClosed="FillTypeComboBox_DropDownClosed" DisplayMemberPath="Name" Margin="0,0,0,4" Padding="4,3"/>
                            </StackPanel>

                            <!-- Radial Gradient Fill Controls -->
                            <StackPanel Visibility="{Binding IsRadialGradientFill, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <!-- Center Color -->
                                <TextBlock Text="Center Color:" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,2"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="3" BorderBrush="#94A3B8" BorderThickness="1"
                                            Background="{Binding FillColor1, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding FillColor1, UpdateSourceTrigger=PropertyChanged}" LostFocus="FillTextBox_LostFocus" KeyDown="FillTextBox_KeyDown" Padding="3" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding AvailablePresetColors}" Margin="0,1,0,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="18" Height="18" Margin="1" Padding="0" Cursor="Hand"
                                                    Command="{Binding DataContext.SetFillColor1Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{Binding Converter={StaticResource HexToBrushConverter}}"
                                                                BorderBrush="#64748B" BorderThickness="0.5" CornerRadius="2"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Outer Color -->
                                <DockPanel Margin="0,2,0,2">
                                    <TextBlock Text="Outer Color:" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Button Command="{Binding SwapFillColorsCommand}" HorizontalAlignment="Right" Padding="4,1" Margin="0" FontSize="10"
                                            ToolTip="Swap Colors" Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}">
                                        <TextBlock Text="⇄ Swap" FontSize="10"/>
                                    </Button>
                                </DockPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="3" BorderBrush="#94A3B8" BorderThickness="1"
                                            Background="{Binding FillColor2, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding FillColor2, UpdateSourceTrigger=PropertyChanged}" LostFocus="FillTextBox_LostFocus" KeyDown="FillTextBox_KeyDown" Padding="3" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding AvailablePresetColors}" Margin="0,1,0,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="18" Height="18" Margin="1" Padding="0" Cursor="Hand"
                                                    Command="{Binding DataContext.SetFillColor2Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{Binding Converter={StaticResource HexToBrushConverter}}"
                                                                BorderBrush="#64748B" BorderThickness="0.5" CornerRadius="2"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- No Fill Note -->
                            <TextBlock Text="🚫 No fill (transparent background)" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"
                                       Visibility="{Binding IsNoFill, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,2,0,2"/>
                        </StackPanel>

                        <!-- STROKE SECTION -->
                        <StackPanel Margin="0,4,0,0">
                            <!-- Stroke Header & Live Preview -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Stroke (Border) Appearance:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right" Width="70" Height="18" CornerRadius="3"
                                        BorderThickness="3"
                                        BorderBrush="{Binding StrokeBrushString, Converter={StaticResource HexToBrushConverter}}"
                                        Background="Transparent"
                                        ToolTip="Live Stroke Preview"/>
                            </DockPanel>

                            <!-- Stroke Type Selector -->
                            <ComboBox ItemsSource="{Binding AvailableStrokeTypesList}" SelectedItem="{Binding StrokeType}" DropDownClosed="StrokeTypeComboBox_DropDownClosed" Margin="0,0,0,6" Padding="4,3"/>

                            <!-- Solid Stroke Controls -->
                            <StackPanel Visibility="{Binding IsSolidStroke, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="3" BorderBrush="#94A3B8" BorderThickness="1"
                                            Background="{Binding StrokeColor1, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding StrokeColor1, UpdateSourceTrigger=PropertyChanged}" LostFocus="StrokeTextBox_LostFocus" KeyDown="StrokeTextBox_KeyDown" Padding="3" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- Quick Swatches for Stroke -->
                                <ItemsControl ItemsSource="{Binding AvailablePresetColors}" Margin="0,2,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="18" Height="18" Margin="1" Padding="0" Cursor="Hand"
                                                    Command="{Binding DataContext.SetStrokeColor1Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{Binding Converter={StaticResource HexToBrushConverter}}"
                                                                BorderBrush="#64748B" BorderThickness="0.5" CornerRadius="2"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Linear Gradient Stroke Controls -->
                            <StackPanel Visibility="{Binding IsLinearGradientStroke, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <!-- Start Color -->
                                <TextBlock Text="Start Color:" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,2"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="3" BorderBrush="#94A3B8" BorderThickness="1"
                                            Background="{Binding StrokeColor1, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding StrokeColor1, UpdateSourceTrigger=PropertyChanged}" LostFocus="StrokeTextBox_LostFocus" KeyDown="StrokeTextBox_KeyDown" Padding="3" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding AvailablePresetColors}" Margin="0,1,0,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="18" Height="18" Margin="1" Padding="0" Cursor="Hand"
                                                    Command="{Binding DataContext.SetStrokeColor1Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{Binding Converter={StaticResource HexToBrushConverter}}"
                                                                BorderBrush="#64748B" BorderThickness="0.5" CornerRadius="2"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- End Color -->
                                <DockPanel Margin="0,2,0,2">
                                    <TextBlock Text="End Color:" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Button Command="{Binding SwapStrokeColorsCommand}" HorizontalAlignment="Right" Padding="4,1" Margin="0" FontSize="10"
                                            ToolTip="Swap Stroke Colors" Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}">
                                        <TextBlock Text="⇄ Swap" FontSize="10"/>
                                    </Button>
                                </DockPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="3" BorderBrush="#94A3B8" BorderThickness="1"
                                            Background="{Binding StrokeColor2, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding StrokeColor2, UpdateSourceTrigger=PropertyChanged}" LostFocus="StrokeTextBox_LostFocus" KeyDown="StrokeTextBox_KeyDown" Padding="3" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding AvailablePresetColors}" Margin="0,1,0,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="18" Height="18" Margin="1" Padding="0" Cursor="Hand"
                                                    Command="{Binding DataContext.SetStrokeColor2Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{Binding Converter={StaticResource HexToBrushConverter}}"
                                                                BorderBrush="#64748B" BorderThickness="0.5" CornerRadius="2"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Direction -->
                                <TextBlock Text="Gradient Direction:" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableDirectionOptions}" SelectedItem="{Binding SelectedStrokeDirection}" DropDownClosed="StrokeTypeComboBox_DropDownClosed" DisplayMemberPath="Name" Margin="0,0,0,4" Padding="4,3"/>
                            </StackPanel>

                            <!-- No Stroke Note -->
                            <TextBlock Text="🚫 No stroke outline (borderless)" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"
                                       Visibility="{Binding IsNoStroke, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,2,0,2"/>

                            <!-- Stroke Thickness -->
                            <DockPanel Margin="0,6,0,2">
                                <TextBlock Text="Stroke Thickness:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CommonStrokeThickness, StringFormat='{}{0:F0} px'}" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="20" Value="{Binding CommonStrokeThickness}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </StackPanel>

                    </StackPanel>
                </GroupBox>

                <!-- 6. Shape Parameters (Corner Radius & Donut Inner Radius) -->
                <GroupBox Header="Geometry Parameters" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"
                          Visibility="{Binding IsShape, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="6" TextElement.FontWeight="Normal">

                        <!-- Corner Radius -->
                        <StackPanel Visibility="{Binding IsRoundedShape, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="Corner Radius (px):" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CommonCornerRadius, StringFormat='{}{0:F0} px'}" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="60" Value="{Binding CommonCornerRadius}" TickFrequency="2" IsSnapToTickEnabled="True"/>
                        </StackPanel>

                        <!-- Donut Inner Radius -->
                        <StackPanel Visibility="{Binding IsDonut, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="Donut Inner Radius (%):" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CommonInnerRadius, StringFormat='{}{0:F0}'}" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </DockPanel>
                            <Slider Minimum="5" Maximum="45" Value="{Binding CommonInnerRadius}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
