<UserControl x:Class="LabScape.App.Views.PropertiesInspectorView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 

             xmlns:models="clr-namespace:LabScape.Core.Models;assembly=LabScape.Core"

             xmlns:enums="clr-namespace:LabScape.Core.Enums;assembly=LabScape.Core"

             mc:Ignorable="d" 

             d:DesignHeight="700" d:DesignWidth="300">



    <UserControl.Resources>

        <!-- Modern Circular Color Chip Template -->

        <ControlTemplate x:Key="ColorSwatchTemplate" TargetType="Button">

            <Border x:Name="swatchBorder"

                    Background="{Binding Converter={StaticResource HexToBrushConverter}}"

                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9">

            </Border>

            <ControlTemplate.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter TargetName="swatchBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>

                    <Setter TargetName="swatchBorder" Property="BorderThickness" Value="1.5"/>

                </Trigger>

            </ControlTemplate.Triggers>

        </ControlTemplate>

    </UserControl.Resources>



    <Grid Background="{DynamicResource PanelBackgroundBrush}">

        <!-- When No Item Selected: Canvas & Page Setup Inspector -->

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

            <ScrollViewer.Style>

                <Style TargetType="ScrollViewer">

                    <Setter Property="Visibility" Value="Collapsed"/>

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding HasSelection}" Value="False">

                            <Setter Property="Visibility" Value="Visible"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </ScrollViewer.Style>



            <StackPanel Margin="10,12,10,16">

                <!-- Header Banner -->

                <Border Background="{DynamicResource SectionHeaderBackgroundBrush}" BorderBrush="{DynamicResource SectionHeaderBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">

                    <StackPanel>

                        <DockPanel>

                            <TextBlock Text="CANVAS &amp; PAGE SETUP"

                                       FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource SectionHeaderForegroundBrush}" VerticalAlignment="Center"/>

                            <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1">

                                <TextBlock Text="PAGE" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource SectionHeaderForegroundBrush}"/>

                            </Border>

                        </DockPanel>

                        <TextBlock Text="Standard Page Size &amp; Paper Boundary" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SectionHeaderSubForegroundBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>



                <!-- Visio-Style Auto-Size & Multi-Page Grid -->

                <GroupBox Header="Auto Size &amp; Page Grid" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}">

                    <StackPanel Margin="4,6" TextElement.FontWeight="Normal">

                        <CheckBox Content="Auto-Expand Pages (Visio Style)" IsChecked="{Binding AutoSize}" Margin="0,2,0,6"

                                  ToolTip="Automatically add pages as shapes cross boundaries, and shrink to minimum possible pages"/>



                        <!-- Live Multi-Page Badge -->

                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,2,0,4">

                            <StackPanel>

                                <DockPanel Margin="0,0,0,3">

                                    <TextBlock Text="Current Grid:" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"/>

                                    <TextBlock Text="{Binding PageGridSummary}" DockPanel.Dock="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>

                                </DockPanel>

                                <DockPanel>

                                    <TextBlock Text="Canvas Size:" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"/>

                                    <TextBlock Text="{Binding Canvas.PageSizeDisplayText}" DockPanel.Dock="Right" FontSize="10" FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                                </DockPanel>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </GroupBox>



                <!-- 1. Page Size Preset Selection -->

                <GroupBox Header="Page Size Preset" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}">

                    <StackPanel Margin="4,6" TextElement.FontWeight="Normal">

                        <TextBlock Text="Standard Preset:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,4"/>

                        <ComboBox ItemsSource="{Binding AvailablePresets}"

                                  SelectedItem="{Binding SelectedPresetOption, Mode=TwoWay}"

                                  DisplayMemberPath="DisplayName"

                                  Margin="0,0,0,8"/>



                        <!-- Quick-Pick Preset Pills -->

                        <TextBlock Text="Quick Presets:" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,0,4"/>

                        <WrapPanel Margin="0,0,0,4">

                            <Button Content="A3 (Lab Standard)" Command="{Binding SetPagePresetCommand}" CommandParameter="{x:Static enums:PageSizePreset.A3}"

                                    Margin="0,0,4,4" Padding="6,3" FontSize="10" Cursor="Hand"/>

                            <Button Content="A4" Command="{Binding SetPagePresetCommand}" CommandParameter="{x:Static enums:PageSizePreset.A4}"

                                    Margin="0,0,4,4" Padding="6,3" FontSize="10" Cursor="Hand"/>

                            <Button Content="US Letter" Command="{Binding SetPagePresetCommand}" CommandParameter="{x:Static enums:PageSizePreset.Letter}"

                                    Margin="0,0,4,4" Padding="6,3" FontSize="10" Cursor="Hand"/>

                            <Button Content="1080p Screen" Command="{Binding SetPagePresetCommand}" CommandParameter="{x:Static enums:PageSizePreset.Screen1080p}"

                                    Margin="0,0,4,4" Padding="6,3" FontSize="10" Cursor="Hand"/>

                        </WrapPanel>

                    </StackPanel>

                </GroupBox>



                <!-- 2. Page Orientation -->

                <GroupBox Header="Page Orientation" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}">

                    <StackPanel Margin="4,6" TextElement.FontWeight="Normal">

                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,2,0,6">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <!-- Landscape Button -->

                                <Button Grid.Column="0" Command="{Binding SetOrientationCommand}" CommandParameter="{x:Static enums:PageOrientation.Landscape}"

                                        Padding="4,5" BorderThickness="1" Cursor="Hand" Margin="1">

                                    <Button.Style>

                                        <Style TargetType="Button">

                                            <Setter Property="Background" Value="Transparent"/>

                                            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>

                                            <Setter Property="BorderBrush" Value="Transparent"/>

                                            <Setter Property="Template">

                                                <Setter.Value>

                                                    <ControlTemplate TargetType="Button">

                                                        <Border Background="{TemplateBinding Background}"

                                                                BorderBrush="{TemplateBinding BorderBrush}"

                                                                BorderThickness="{TemplateBinding BorderThickness}"

                                                                CornerRadius="4" Padding="{TemplateBinding Padding}">

                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                        </Border>

                                                    </ControlTemplate>

                                                </Setter.Value>

                                            </Setter>

                                            <Style.Triggers>

                                                <Trigger Property="IsMouseOver" Value="True">

                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}"/>

                                                    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>

                                                </Trigger>

                                                <DataTrigger Binding="{Binding IsLandscape}" Value="True">

                                                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>

                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>

                                                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>

                                                    <Setter Property="FontWeight" Value="SemiBold"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Button.Style>

                                    <StackPanel Orientation="Horizontal">

                                        <Image Source="{StaticResource IconLandscape}" Width="14" Height="14" Margin="0,0,5,0"/>

                                        <TextBlock Text="Landscape" FontSize="11" VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Button>



                                <!-- Portrait Button -->

                                <Button Grid.Column="1" Command="{Binding SetOrientationCommand}" CommandParameter="{x:Static enums:PageOrientation.Portrait}"

                                        Padding="4,5" BorderThickness="1" Cursor="Hand" Margin="1">

                                    <Button.Style>

                                        <Style TargetType="Button">

                                            <Setter Property="Background" Value="Transparent"/>

                                            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>

                                            <Setter Property="BorderBrush" Value="Transparent"/>

                                            <Setter Property="Template">

                                                <Setter.Value>

                                                    <ControlTemplate TargetType="Button">

                                                        <Border Background="{TemplateBinding Background}"

                                                                BorderBrush="{TemplateBinding BorderBrush}"

                                                                BorderThickness="{TemplateBinding BorderThickness}"

                                                                CornerRadius="4" Padding="{TemplateBinding Padding}">

                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                        </Border>

                                                    </ControlTemplate>

                                                </Setter.Value>

                                            </Setter>

                                            <Style.Triggers>

                                                <Trigger Property="IsMouseOver" Value="True">

                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}"/>

                                                    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>

                                                </Trigger>

                                                <DataTrigger Binding="{Binding IsPortrait}" Value="True">

                                                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>

                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>

                                                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>

                                                    <Setter Property="FontWeight" Value="SemiBold"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Button.Style>

                                    <StackPanel Orientation="Horizontal">

                                        <Image Source="{StaticResource IconPortrait}" Width="14" Height="14" Margin="0,0,5,0"/>

                                        <TextBlock Text="Portrait" FontSize="11" VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Button>

                            </Grid>

                        </Border>

                    </StackPanel>

                </GroupBox>



                <!-- 3. Physical & Pixel Dimensions -->

                <GroupBox Header="Page Dimensions (Pixels @ 96 DPI)" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}">

                    <StackPanel Margin="4,6" TextElement.FontWeight="Normal">

                        <Grid Margin="0,2,0,6">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <!-- Width -->

                            <StackPanel Grid.Column="0" Margin="0,0,4,0">

                                <TextBlock Text="Width (px):" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>

                                <TextBox Text="{Binding CanvasWidthText, UpdateSourceTrigger=LostFocus}"

                                         Style="{StaticResource NumericCoordinateTextBoxStyle}"/>

                            </StackPanel>

                            <!-- Height -->

                            <StackPanel Grid.Column="1" Margin="4,0,0,0">

                                <TextBlock Text="Height (px):" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>

                                <TextBox Text="{Binding CanvasHeightText, UpdateSourceTrigger=LostFocus}"

                                         Style="{StaticResource NumericCoordinateTextBoxStyle}"/>

                            </StackPanel>

                        </Grid>

                        <TextBlock Text="Standard 96 DPI: 1 mm ≈ 3.78 px | 1 in = 96 px" FontSize="9.5" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap"/>

                    </StackPanel>

                </GroupBox>



                <!-- 4. Viewport & Navigation -->

                <GroupBox Header="Page Viewport" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}">

                    <StackPanel Margin="4,6" TextElement.FontWeight="Normal">

                        <Button Command="{Binding FitPageCommand}" Margin="0,2,0,6" Padding="6,5" Cursor="Hand">

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                <Image Source="{StaticResource IconFitPage}" Width="14" Height="14" Margin="0,0,6,0"/>

                                <TextBlock Text="Fit Page to Screen" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                        <Button Command="{Binding Canvas.ResetZoomCommand}" Margin="0,0,0,6" Padding="6,4" Cursor="Hand">

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                <Image Source="{StaticResource IconResetZoom}" Width="13" Height="13" Margin="0,0,6,0"/>

                                <TextBlock Text="Reset Zoom (100%)" FontSize="11" VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </GroupBox>



                <!-- 5. Grid & Guides -->

                <GroupBox Header="Grid &amp; Guides" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}">

                    <StackPanel Margin="4,6" TextElement.FontWeight="Normal">

                        <CheckBox Content="Show Alignment Grid" IsChecked="{Binding Canvas.ShowGrid}" Margin="0,2,0,4"/>

                        <CheckBox Content="Snap to Grid" IsChecked="{Binding Canvas.SnapToGrid}" Margin="0,2,0,4"/>

                        <CheckBox Content="Show Metric Rulers" IsChecked="{Binding Canvas.ShowRulers}" Margin="0,2,0,4"/>

                    </StackPanel>

                </GroupBox>



                <!-- Help Tip Footer -->

                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,8" Margin="0,4,0,0">

                    <StackPanel Orientation="Horizontal">

                        <Path Data="M 4 1 A 3 3 0 0 1 7 4 C 7 5.5 5.5 6.5 5.5 7.5 H 2.5 C 2.5 6.5 1 5.5 1 4 A 3 3 0 0 1 4 1 Z M 2.5 8.5 H 5.5" Stroke="{DynamicResource AccentPrimaryBrush}" StrokeThickness="1" Fill="Transparent" Width="9" Height="10" Margin="0,0,6,0" VerticalAlignment="Top"/>

                        <TextBlock Text="Drag stencils from the library onto the canvas to place lab devices and furniture."

                                   FontSize="10.5" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap" LineHeight="14"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>



        <!-- When Item Selected -->

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

            <ScrollViewer.Style>

                <Style TargetType="ScrollViewer">

                    <Setter Property="Visibility" Value="Collapsed"/>

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding HasSelection}" Value="True">

                            <Setter Property="Visibility" Value="Visible"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </ScrollViewer.Style>



            <StackPanel Margin="10,12,10,16">



                <!-- Header / Item Type Banner -->

                <Border Background="{DynamicResource SectionHeaderBackgroundBrush}" BorderBrush="{DynamicResource SectionHeaderBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">

                    <StackPanel>

                        <DockPanel>

                            <TextBlock Text="{Binding HeaderTitle}"

                                       FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource SectionHeaderForegroundBrush}" VerticalAlignment="Center"/>

                            <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1">

                                <TextBlock Text="PROPERTIES" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource SectionHeaderForegroundBrush}"/>

                            </Border>

                        </DockPanel>

                        <TextBlock Text="{Binding HeaderSubtitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SectionHeaderSubForegroundBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>



                <!-- 1. Identity & Name -->

                <GroupBox Header="Identity" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}">

                    <StackPanel Margin="4,6" TextElement.FontWeight="Normal">

                        <TextBlock Text="Item Name:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,4"/>

                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSingleSelection}" Padding="6,4" Margin="0,0,0,6"/>



                        <!-- Note for Group Name -->

                        <TextBlock Text="Group name is saved in schema and exported, but hidden from canvas layout."

                                   FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"

                                   Visibility="{Binding IsGroup, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <TextBlock Text="Name editing disabled for multiple selected items."

                                   FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"

                                   Visibility="{Binding IsMultiSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    </StackPanel>

                </GroupBox>

                <!-- Custom Image Section -->
                <GroupBox Header="Custom Image" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"
                          Visibility="{Binding IsSingleSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="4,6" TextElement.FontWeight="Normal">
                        <Border Visibility="{Binding SelectedItem.HasCustomImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Custom Graphic Active" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding SelectedItem.CustomImagePath, TargetNullValue='Embedded Custom Image'}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                <DockPanel LastChildFill="False">
                                    <Button Content="Change..." Click="Properties_ChangeCustomImage_Click" Width="80" Padding="4,2" Cursor="Hand" Margin="0,0,6,0"/>
                                    <Button Content="Clear Image" Click="Properties_ClearCustomImage_Click" Width="80" Padding="4,2" Cursor="Hand"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding SelectedItem.HasCustomImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Using standard vector stencil." FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,0,6"/>
                                <Button Content="Attach Custom Image..." Click="Properties_ChangeCustomImage_Click" Padding="6,3" Cursor="Hand" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>



                <!-- 2. Device IP Configuration (Single Device: Manual Static IP or Database Linked) -->

                <GroupBox Header="Network &amp; IP Configuration" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"

                          Visibility="{Binding IsSingleDevice, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <StackPanel Margin="4,6" TextElement.FontWeight="Normal">

                        <!-- Mode Segmented Pill Buttons -->

                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,0,10">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding SetManualModeCommand}" Padding="4,4" BorderThickness="0" Cursor="Hand" Margin="1">

                                    <Button.Style>

                                        <Style TargetType="Button">

                                            <Setter Property="Background" Value="Transparent"/>

                                            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>

                                            <Setter Property="BorderThickness" Value="1"/>

                                            <Setter Property="BorderBrush" Value="Transparent"/>

                                            <Setter Property="Template">

                                                <Setter.Value>

                                                    <ControlTemplate TargetType="Button">

                                                        <Border Background="{TemplateBinding Background}"

                                                                BorderBrush="{TemplateBinding BorderBrush}"

                                                                BorderThickness="{TemplateBinding BorderThickness}"

                                                                CornerRadius="4" Padding="{TemplateBinding Padding}">

                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                        </Border>

                                                    </ControlTemplate>

                                                </Setter.Value>

                                            </Setter>

                                            <Style.Triggers>

                                                <Trigger Property="IsMouseOver" Value="True">

                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}"/>

                                                    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>

                                                </Trigger>

                                                <DataTrigger Binding="{Binding IsManualIpMode}" Value="True">

                                                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>

                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>

                                                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>

                                                    <Setter Property="FontWeight" Value="SemiBold"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Button.Style>

                                    <TextBlock Text="Manual IP" FontSize="11" HorizontalAlignment="Center"/>

                                </Button>

                                <Button Grid.Column="1" Command="{Binding SetDatabaseModeCommand}" Padding="4,4" BorderThickness="0" Cursor="Hand" Margin="1">

                                    <Button.Style>

                                        <Style TargetType="Button">

                                            <Setter Property="Background" Value="Transparent"/>

                                            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>

                                            <Setter Property="BorderThickness" Value="1"/>

                                            <Setter Property="BorderBrush" Value="Transparent"/>

                                            <Setter Property="Template">

                                                <Setter.Value>

                                                    <ControlTemplate TargetType="Button">

                                                        <Border Background="{TemplateBinding Background}"

                                                                BorderBrush="{TemplateBinding BorderBrush}"

                                                                BorderThickness="{TemplateBinding BorderThickness}"

                                                                CornerRadius="4" Padding="{TemplateBinding Padding}">

                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                        </Border>

                                                    </ControlTemplate>

                                                </Setter.Value>

                                            </Setter>

                                            <Style.Triggers>

                                                <Trigger Property="IsMouseOver" Value="True">

                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}"/>

                                                    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>

                                                </Trigger>

                                                <DataTrigger Binding="{Binding IsManualIpMode}" Value="False">

                                                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>

                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>

                                                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>

                                                    <Setter Property="FontWeight" Value="SemiBold"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Button.Style>

                                    <TextBlock Text="Database Link" FontSize="11" HorizontalAlignment="Center"/>

                                </Button>

                            </Grid>

                        </Border>



                        <!-- A. MANUAL STATIC IP PANEL -->

                        <StackPanel Visibility="{Binding IsManualIpMode, Converter={StaticResource BooleanToVisibilityConverter}}">

                            <!-- IP Address Input -->

                            <TextBlock Text="Manual Static IPv4 Address:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>

                            <TextBox Text="{Binding DeviceIpAddress, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,4"

                                     FontFamily="Consolas, Segoe UI" FontSize="11.5" FontWeight="SemiBold"/>



                            <!-- Live Validation Feedback Badge -->

                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{Binding DeviceValidationColor, Converter={StaticResource HexToBrushConverter}}"

                                    BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,0,8">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <TextBlock Text="{Binding DeviceValidationFeedback}" FontSize="10.5" FontWeight="SemiBold"

                                               Foreground="{Binding DeviceValidationColor, Converter={StaticResource HexToBrushConverter}}"/>

                                </StackPanel>

                            </Border>



                            <!-- Quick Action Buttons for Manual IP -->

                            <Grid Margin="0,0,0,8">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="6"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="Next Available IP" Command="{Binding SuggestNextIpCommand}"

                                        Padding="4,3" FontSize="10.5" ToolTip="Scan canvas and auto-fill the next available IP in subnet"/>

                                <Button Grid.Column="2" Content="Clear IP" Command="{Binding ClearDeviceIpCommand}" Foreground="{DynamicResource StatusErrorBrush}"

                                        Padding="4,3" FontSize="10.5" ToolTip="Reset device to unassigned IP state"/>

                            </Grid>



                            <!-- MAC Address Input -->

                            <DockPanel Margin="0,0,0,3">

                                <TextBlock Text="MAC Address:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>

                                <Button Content="Auto-Gen" Command="{Binding AutoGenerateMacCommand}" DockPanel.Dock="Right"

                                        Padding="6,1" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource AccentPrimaryBrush}"

                                        BorderBrush="{DynamicResource CardBorderBrush}" ToolTip="Generate standard locally-administered MAC"/>

                            </DockPanel>

                            <TextBox Text="{Binding DeviceMacAddress, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,8"

                                     FontFamily="Consolas, Segoe UI" FontSize="11"/>



                            <!-- Device ID / Hardware Tag -->

                            <TextBlock Text="Workstation ID / Asset Tag:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>

                            <TextBox Text="{Binding DeviceId, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,4"

                                     FontFamily="Consolas, Segoe UI" FontSize="11"/>

                        </StackPanel>



                        <!-- B. DATABASE INVENTORY PANEL -->

                        <StackPanel Visibility="{Binding IsManualIpMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                            <!-- Linked Card (if already linked) -->

                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}"

                                    BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8"

                                    Visibility="{Binding LinkedDatabaseDeviceName, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">

                                <StackPanel>

                                    <TextBlock Text="Linked to Database Device:" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                                    <TextBlock Text="{Binding LinkedDatabaseDeviceName}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,2,0,4"/>

                                    <Button Content="Unlink (Convert to Manual Static)" Command="{Binding SwitchToManualModeCommand}"

                                            Padding="4,2" FontSize="10" HorizontalAlignment="Left" Foreground="{DynamicResource StatusWarningBrush}"

                                            BorderBrush="{DynamicResource CardBorderBrush}"/>

                                </StackPanel>

                            </Border>



                            <!-- Searchable Inventory Picker -->

                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">

                                <StackPanel>

                                    <!-- Header & Available Count -->

                                    <DockPanel Margin="0,0,0,6">

                                        <TextBlock Text="Link from Database Inventory:" FontWeight="SemiBold" FontSize="11"

                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>

                                        <Border HorizontalAlignment="Right" Background="{DynamicResource AccentSubtleBrush}"

                                                BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="3"

                                                Padding="5,1">

                                            <TextBlock Text="{Binding FilteredDatabaseDevices.Count, StringFormat='{}{0} available'}"

                                                       FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>

                                        </Border>

                                    </DockPanel>



                                    <!-- Search Input with Magnifier & Watermark -->

                                    <Grid Margin="0,0,0,6">

                                        <TextBox x:Name="TxtSearchDevices"

                                                 Text="{Binding IpSearchQuery, UpdateSourceTrigger=PropertyChanged}"

                                                 Padding="22,4,6,4" FontSize="11"/>

                                        <Path Data="M 4 1 A 3 3 0 1 0 4 7 A 3 3 0 0 0 4 1 M 6 6 L 9 9" Stroke="{DynamicResource AppTextMutedBrush}" StrokeThickness="1.2" Width="9" Height="9"

                                                   

                                                   VerticalAlignment="Center" Margin="6,0,0,0"

                                                   IsHitTestVisible="False"/>

                                        <TextBlock Text="Filter by name, IP, or MAC..."

                                                   FontSize="11"

                                                   Foreground="{DynamicResource AppTextMutedBrush}"

                                                   VerticalAlignment="Center" Margin="24,0,0,0"

                                                   IsHitTestVisible="False">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Visibility" Value="Collapsed"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearchDevices}" Value="">

                                                            <Setter Property="Visibility" Value="Visible"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                    </Grid>



                                    <!-- Devices ListBox with dark-theme styled card items -->

                                    <Border Background="{DynamicResource InputBackgroundBrush}"

                                            BorderBrush="{DynamicResource InputBorderBrush}"

                                            BorderThickness="1" CornerRadius="5" Padding="2"

                                            Visibility="{Binding FilteredDatabaseDevices.Count, Converter={StaticResource IntToVisibilityConverter}}">

                                        <ListBox ItemsSource="{Binding FilteredDatabaseDevices}"

                                                 MaxHeight="150"

                                                 Background="Transparent"

                                                 BorderThickness="0"

                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"

                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"

                                                 SelectionChanged="DatabaseDevicesListBox_SelectionChanged">

                                            <ListBox.ItemContainerStyle>

                                                <Style TargetType="ListBoxItem">

                                                    <Setter Property="Background" Value="Transparent"/>

                                                    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>

                                                    <Setter Property="BorderThickness" Value="1"/>

                                                    <Setter Property="BorderBrush" Value="Transparent"/>

                                                    <Setter Property="Padding" Value="6,4"/>

                                                    <Setter Property="Margin" Value="0,1"/>

                                                    <Setter Property="Cursor" Value="Hand"/>

                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                                                    <Setter Property="Template">

                                                        <Setter.Value>

                                                            <ControlTemplate TargetType="ListBoxItem">

                                                                <Border x:Name="itemBorder"

                                                                        Background="{TemplateBinding Background}"

                                                                        BorderBrush="{TemplateBinding BorderBrush}"

                                                                        BorderThickness="{TemplateBinding BorderThickness}"

                                                                        CornerRadius="4"

                                                                        Padding="{TemplateBinding Padding}"

                                                                        SnapsToDevicePixels="True">

                                                                    <ContentPresenter/>

                                                                </Border>

                                                                <ControlTemplate.Triggers>

                                                                    <Trigger Property="IsMouseOver" Value="True">

                                                                        <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}"/>

                                                                        <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource CardBorderHoverBrush}"/>

                                                                    </Trigger>

                                                                    <Trigger Property="IsSelected" Value="True">

                                                                        <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>

                                                                        <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>

                                                                    </Trigger>

                                                                </ControlTemplate.Triggers>

                                                            </ControlTemplate>

                                                        </Setter.Value>

                                                    </Setter>

                                                </Style>

                                            </ListBox.ItemContainerStyle>

                                            <ListBox.ItemTemplate>

                                                <DataTemplate DataType="{x:Type models:DatabaseDevice}">

                                                    <Grid Margin="1,1">

                                                        <Grid.ColumnDefinitions>

                                                            <ColumnDefinition Width="Auto"/>

                                                            <ColumnDefinition Width="*"/>

                                                            <ColumnDefinition Width="Auto"/>

                                                        </Grid.ColumnDefinitions>



                                                        <!-- Workstation Icon Badge -->

                                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="4"

                                                                Background="{DynamicResource CardBackgroundBrush}"

                                                                BorderBrush="{DynamicResource CardBorderBrush}"

                                                                BorderThickness="1" Margin="0,0,7,0"

                                                                VerticalAlignment="Center">

                                                            <Path Data="M 2 2 H 8 V 6 H 2 Z M 1 7 H 9" Stroke="{DynamicResource AccentPrimaryBrush}" StrokeThickness="1" Fill="Transparent" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                        </Border>



                                                        <!-- Name & Device ID -->

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11"

                                                                       Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>

                                                            <TextBlock Text="{Binding DeviceId, StringFormat='ID: {0}'}" FontSize="9.5"

                                                                       Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis"/>

                                                        </StackPanel>



                                                        <!-- Monospace IP Chip Badge -->

                                                        <Border Grid.Column="2" VerticalAlignment="Center"

                                                                Background="{DynamicResource CardBackgroundBrush}"

                                                                BorderBrush="{DynamicResource CardBorderBrush}"

                                                                BorderThickness="1" CornerRadius="3"

                                                                Padding="5,1.5" Margin="4,0,0,0">

                                                            <TextBlock Text="{Binding PrimaryIp}"

                                                                       FontFamily="Consolas, Segoe UI Variable Display, Segoe UI"

                                                                       FontSize="10" FontWeight="SemiBold"

                                                                       Foreground="{DynamicResource AccentPrimaryBrush}"/>

                                                        </Border>

                                                    </Grid>

                                                </DataTemplate>

                                            </ListBox.ItemTemplate>

                                        </ListBox>

                                    </Border>



                                    <!-- Empty State Message when FilteredDatabaseDevices is empty -->

                                    <Border Background="{DynamicResource InputBackgroundBrush}"

                                            BorderBrush="{DynamicResource InputBorderBrush}"

                                            BorderThickness="1" CornerRadius="5" Padding="12,14"

                                            Visibility="{Binding FilteredDatabaseDevices.Count, Converter={StaticResource ZeroToVisibilityConverter}}">

                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                            <Path Data="M 5 1 A 4 4 0 1 0 5 9 A 4 4 0 0 0 5 1 M 8 8 L 12 12" Stroke="{DynamicResource AppTextMutedBrush}" StrokeThickness="1.2" Width="13" Height="13" HorizontalAlignment="Center" Margin="0,0,0,4" Opacity="0.6"/>

                                            <TextBlock Text="No unassigned workstations match filter."

                                                       FontSize="11" FontWeight="SemiBold"

                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"

                                                       HorizontalAlignment="Center" TextAlignment="Center"/>

                                            <TextBlock Text="Try a different query or switch to Manual IP."

                                                       FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"

                                                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,2,0,0"/>

                                        </StackPanel>

                                    </Border>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </StackPanel>

                </GroupBox>



                <!-- 2b. Batch Workstation IP Configuration (When Multiple Devices Selected) -->

                <GroupBox Header="Batch Workstation IP Configuration" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"

                          Visibility="{Binding IsMultipleDevices, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <StackPanel Margin="4,6" TextElement.FontWeight="Normal">

                        <TextBlock Text="{Binding SelectedDevicesCount, StringFormat='Configure {0} Selected Workstations'}"

                                   FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,4"/>

                        <TextBlock Text="Assign sequential manual static IPs in spatial canvas row/column order."

                                   FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>



                        <!-- Start IP & Step -->

                        <Grid Margin="0,0,0,6">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="6"/>

                                <ColumnDefinition Width="70"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Start IPv4:" FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,2"/>

                                <TextBox Text="{Binding BatchStartIp, UpdateSourceTrigger=PropertyChanged}" Padding="5,3"

                                         FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Step:" FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,2"/>

                                <TextBox Text="{Binding BatchIpStep, UpdateSourceTrigger=PropertyChanged}" Padding="5,3"

                                         FontFamily="Consolas, Segoe UI" FontSize="11"/>

                            </StackPanel>

                        </Grid>



                        <!-- Hostname Auto-Rename -->

                        <TextBlock Text="Hostname Prefix:" FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,2"/>

                        <TextBox Text="{Binding BatchNamePrefix, UpdateSourceTrigger=PropertyChanged}" Padding="5,3" Margin="0,0,0,4"

                                 FontFamily="Consolas, Segoe UI" FontSize="11"/>

                        <CheckBox Content="Auto-number names (PC-01, PC-02...)" IsChecked="{Binding BatchRenameDevices}"

                                  FontSize="10.5" Margin="0,0,0,10" Foreground="{DynamicResource AppTextPrimaryBrush}"/>



                        <!-- Action Buttons -->

                        <Button Content="Batch Assign Sequential IPs" Command="{Binding BatchAssignSequentialIpsCommand}"

                                Style="{StaticResource AccentButtonStyle}"

                                Padding="8,5" Margin="0,0,0,6"/>

                        <Button Content="Clear Selected IPs" Command="{Binding BatchClearIpsCommand}"

                                Style="{StaticResource DangerButtonStyle}"

                                Padding="8,4" FontSize="10.5"/>

                    </StackPanel>

                </GroupBox>



                <!-- 3. Transform & Coordinates (Figma / Webflow 2-Column Compact Layout) -->

                <GroupBox Header="Transform &amp; Dimensions" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}">

                    <StackPanel Margin="4,6" TextElement.FontWeight="Normal">

                        <!-- Row 1: X and Y -->

                        <Grid Margin="0,0,0,6">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="8"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <!-- X Input with micro-prefix -->

                            <Border Grid.Column="0" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="4,2">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="18"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="X" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                    <TextBox Grid.Column="1" Text="{Binding DisplayX, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditCoordinates}"

                                             ToolTip="{Binding CoordinatesToolTip}" BorderThickness="0" Background="Transparent" Padding="2" FontSize="11.5"

                                             FontFamily="Consolas, Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold"/>

                                </Grid>

                            </Border>

                            <!-- Y Input with micro-prefix -->

                            <Border Grid.Column="2" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="4,2">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="18"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Y" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                    <TextBox Grid.Column="1" Text="{Binding DisplayY, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditCoordinates}"

                                             ToolTip="{Binding CoordinatesToolTip}" BorderThickness="0" Background="Transparent" Padding="2" FontSize="11.5"

                                             FontFamily="Consolas, Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold"/>

                                </Grid>

                            </Border>

                        </Grid>



                        <!-- Row 2: W and H -->

                        <Grid Margin="0,0,0,6">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="8"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <!-- Width Input -->

                            <Border Grid.Column="0" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="4,2">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="18"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="W" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                    <TextBox Grid.Column="1" Text="{Binding CommonWidth, UpdateSourceTrigger=PropertyChanged}"

                                             BorderThickness="0" Background="Transparent" Padding="2" FontSize="11.5"

                                             FontFamily="Consolas, Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold"/>

                                </Grid>

                            </Border>

                            <!-- Height Input -->

                            <Border Grid.Column="2" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="4,2">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="18"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="H" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                    <TextBox Grid.Column="1" Text="{Binding CommonHeight, UpdateSourceTrigger=PropertyChanged}"

                                             BorderThickness="0" Background="Transparent" Padding="2" FontSize="11.5"

                                             FontFamily="Consolas, Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold"/>

                                </Grid>

                            </Border>

                        </Grid>



                        <!-- Row 3: Rotation -->

                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="4,2">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="18"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="∠" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                <TextBox Grid.Column="1" Text="{Binding CommonRotation, UpdateSourceTrigger=PropertyChanged}"

                                         BorderThickness="0" Background="Transparent" Padding="2" FontSize="11.5"

                                         FontFamily="Consolas, Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold"/>

                            </Grid>

                        </Border>

                    </StackPanel>

                </GroupBox>



                <!-- Text & Typography (for Text Items) -->

                <GroupBox Header="Text &amp; Typography" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"

                          Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <StackPanel Margin="4,6" TextElement.FontWeight="Normal">

                        <!-- Content -->

                        <TextBlock Text="Content:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,4"/>

                        <TextBox Text="{Binding ItemText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="50" MaxHeight="100" TextWrapping="Wrap" Padding="6,4" Margin="0,0,0,8" VerticalScrollBarVisibility="Auto"/>



                        <!-- Font Family & Font Size -->

                        <Grid Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="8"/>

                                <ColumnDefinition Width="70"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Font Family:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>

                                <ComboBox ItemsSource="{Binding FontFamiliesList}" SelectedItem="{Binding ItemFontFamily}"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Size:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>

                                <ComboBox ItemsSource="{Binding FontSizesList}" SelectedItem="{Binding ItemFontSize}" IsEditable="True"/>

                            </StackPanel>

                        </Grid>



                        <!-- Formatting Toolbar: Bold, Italic, Alignments (Segmented Button Group) -->

                        <TextBlock Text="Style &amp; Alignment:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,4"/>

                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,0,8" HorizontalAlignment="Left">

                            <StackPanel Orientation="Horizontal">

                                <ToggleButton IsChecked="{Binding IsBold}" ToolTip="Bold (Ctrl+B)" Width="28" Height="26" FontWeight="Bold" Content="B" Margin="0,0,2,0"/>

                                <ToggleButton IsChecked="{Binding IsItalic}" ToolTip="Italic (Ctrl+I)" Width="28" Height="26" FontStyle="Italic" FontWeight="SemiBold" Content="I" Margin="0,0,6,0"/>

                                <Rectangle Width="1" Height="16" Fill="{DynamicResource CardBorderBrush}" Margin="0,0,6,0"/>

                                <Button Command="{Binding SetAlignLeftCommand}" ToolTip="Align Left" Width="28" Height="26" Margin="0,0,2,0">

                                    <Image Source="{StaticResource IconAlignLeft}" Width="14" Height="14"/>

                                </Button>

                                <Button Command="{Binding SetAlignCenterCommand}" ToolTip="Align Center" Width="28" Height="26" Margin="0,0,2,0">

                                    <Image Source="{StaticResource IconAlignCenter}" Width="14" Height="14"/>

                                </Button>

                                <Button Command="{Binding SetAlignRightCommand}" ToolTip="Align Right" Width="28" Height="26">

                                    <Image Source="{StaticResource IconAlignRight}" Width="14" Height="14"/>

                                </Button>

                            </StackPanel>

                        </Border>



                        <!-- Text Color -->

                        <TextBlock Text="Text Color:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,4"/>

                        <Grid Margin="0,0,0,4">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="26"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" BorderBrush="#94A3B8" BorderThickness="1"

                                    Background="{Binding ItemTextColor, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1" Text="{Binding ItemTextColor, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>

                        </Grid>



                        <!-- Preset Colors for Text Color -->

                        <ItemsControl ItemsSource="{Binding AvailablePresetColors}" Margin="0,2,0,8">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <WrapPanel Orientation="Horizontal"/>

                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Button Width="18" Height="18" Margin="2" Padding="0" Cursor="Hand"

                                            Command="{Binding DataContext.SetItemTextColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                            CommandParameter="{Binding}"

                                            ToolTip="{Binding}"

                                            Template="{StaticResource ColorSwatchTemplate}"/>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>



                        <!-- Background Fill -->

                        <TextBlock Text="Background Fill:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,4"/>

                        <Grid Margin="0,0,0,4">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="26"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" BorderBrush="#94A3B8" BorderThickness="1"

                                    Background="{Binding ItemTextBackground, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1" Text="{Binding ItemTextBackground, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>

                        </Grid>

                        <!-- Preset Colors for Text Background -->

                        <ItemsControl ItemsSource="{Binding AvailablePresetColors}" Margin="0,2,0,8">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <WrapPanel Orientation="Horizontal"/>

                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Button Width="18" Height="18" Margin="2" Padding="0" Cursor="Hand"

                                            Command="{Binding DataContext.SetItemTextBackgroundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                            CommandParameter="{Binding}"

                                            ToolTip="{Binding}"

                                            Template="{StaticResource ColorSwatchTemplate}"/>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>



                        <!-- Border -->

                        <DockPanel Margin="0,4,0,2">

                            <TextBlock Text="Border Thickness:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                            <TextBlock Text="{Binding ItemBorderThickness, StringFormat='{}{0:F0} px'}" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Right" FontWeight="SemiBold"/>

                        </DockPanel>

                        <Slider Minimum="0" Maximum="10" Value="{Binding ItemBorderThickness}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,6"/>



                        <TextBlock Text="Border Color:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,4"/>

                        <Grid Margin="0,0,0,4">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="26"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" BorderBrush="#94A3B8" BorderThickness="1"

                                    Background="{Binding ItemBorderColor, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1" Text="{Binding ItemBorderColor, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>

                        </Grid>

                        <ItemsControl ItemsSource="{Binding AvailablePresetColors}" Margin="0,2,0,4">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <WrapPanel Orientation="Horizontal"/>

                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Button Width="18" Height="18" Margin="2" Padding="0" Cursor="Hand"

                                            Command="{Binding DataContext.SetItemBorderColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                            CommandParameter="{Binding}"

                                            ToolTip="{Binding}"

                                            Template="{StaticResource ColorSwatchTemplate}"/>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </GroupBox>



                <!-- 4. Layering & Stacking Order (Dedicated Proper Section) -->

                <GroupBox Header="Layering &amp; Order" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}">

                    <StackPanel Margin="4,6" TextElement.FontWeight="Normal">

                        <!-- Z-Index Input -->

                        <Grid Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="65"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Z (Layer):" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1" Text="{Binding CommonZ, UpdateSourceTrigger=PropertyChanged}"

                                     FontFamily="Consolas, Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold"/>

                        </Grid>



                        <!-- Standard Layer Action Buttons with Vector Icons -->

                        <UniformGrid Columns="2" Rows="2" Margin="0,2,0,2">

                            <Button Command="{Binding MoveToFrontCommand}" ToolTip="Bring to Front (Ctrl+Shift+])" Margin="2" Padding="6,6">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <Image Source="{StaticResource IconMoveToFront}" Width="14" Height="14" Margin="0,0,6,0"/>

                                    <TextBlock Text="To Front" FontSize="11" VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                            <Button Command="{Binding MoveForwardCommand}" ToolTip="Bring Forward (Ctrl+])" Margin="2" Padding="6,6">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <Image Source="{StaticResource IconMoveForward}" Width="14" Height="14" Margin="0,0,6,0"/>

                                    <TextBlock Text="Forward" FontSize="11" VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                            <Button Command="{Binding SendBackwardCommand}" ToolTip="Send Backward (Ctrl+[)" Margin="2" Padding="6,6">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <Image Source="{StaticResource IconSendBackward}" Width="14" Height="14" Margin="0,0,6,0"/>

                                    <TextBlock Text="Backward" FontSize="11" VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                            <Button Command="{Binding SendToBackCommand}" ToolTip="Send to Back (Ctrl+Shift+[)" Margin="2" Padding="6,6">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <Image Source="{StaticResource IconSendToBack}" Width="14" Height="14" Margin="0,0,6,0"/>

                                    <TextBlock Text="To Back" FontSize="11" VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                        </UniformGrid>

                    </StackPanel>

                </GroupBox>



                <!-- 5. Appearance & Style (Fill & Stroke) -->

                <GroupBox Header="Appearance &amp; Style" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"

                          Visibility="{Binding IsAppearanceApplicable, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <StackPanel Margin="4,6" TextElement.FontWeight="Normal">



                        <!-- FILL SECTION (Hidden for open paths: Line and Bezier) -->

                        <StackPanel Visibility="{Binding IsFillApplicable, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12">

                            <!-- Fill Header & Live Preview -->

                            <DockPanel Margin="0,0,0,6">

                                <TextBlock Text="Fill Appearance:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>

                                <Border HorizontalAlignment="Right" Width="70" Height="18" CornerRadius="4"

                                        BorderBrush="{DynamicResource SectionHeaderBorderBrush}" BorderThickness="1"

                                        Background="{Binding FillBrushString, Converter={StaticResource HexToBrushConverter}}"

                                        ToolTip="Live Fill Preview"/>

                            </DockPanel>



                            <!-- Fill Type Selector -->

                            <ComboBox ItemsSource="{Binding AvailableFillTypesList}" SelectedItem="{Binding FillType}" DropDownClosed="FillTypeComboBox_DropDownClosed" Margin="0,0,0,6"/>



                            <!-- Solid Fill Controls -->

                            <StackPanel Visibility="{Binding IsSolidFill, Converter={StaticResource BooleanToVisibilityConverter}}">

                                <Grid Margin="0,0,0,4">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="26"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" BorderBrush="#94A3B8" BorderThickness="1"

                                            Background="{Binding FillColor1, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                    <TextBox Grid.Column="1" Text="{Binding FillColor1, UpdateSourceTrigger=PropertyChanged}" LostFocus="FillTextBox_LostFocus" KeyDown="FillTextBox_KeyDown" VerticalAlignment="Center"/>

                                </Grid>

                                <!-- Quick Swatches -->

                                <ItemsControl ItemsSource="{Binding AvailablePresetColors}" Margin="0,2,0,0">

                                    <ItemsControl.ItemsPanel>

                                        <ItemsPanelTemplate>

                                            <WrapPanel Orientation="Horizontal"/>

                                        </ItemsPanelTemplate>

                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Button Width="18" Height="18" Margin="2" Padding="0" Cursor="Hand"

                                                    Command="{Binding DataContext.SetFillColor1Command, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                                    CommandParameter="{Binding}"

                                                    ToolTip="{Binding}"

                                                    Template="{StaticResource ColorSwatchTemplate}"/>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </StackPanel>



                            <!-- Linear Gradient Fill Controls -->

                            <StackPanel Visibility="{Binding IsLinearGradientFill, Converter={StaticResource BooleanToVisibilityConverter}}">

                                <!-- Start Color -->

                                <TextBlock Text="Start Color:" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,2"/>

                                <Grid Margin="0,0,0,4">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="26"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" BorderBrush="#94A3B8" BorderThickness="1"

                                            Background="{Binding FillColor1, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                    <TextBox Grid.Column="1" Text="{Binding FillColor1, UpdateSourceTrigger=PropertyChanged}" LostFocus="FillTextBox_LostFocus" KeyDown="FillTextBox_KeyDown" VerticalAlignment="Center"/>

                                </Grid>

                                <ItemsControl ItemsSource="{Binding AvailablePresetColors}" Margin="0,1,0,4">

                                    <ItemsControl.ItemsPanel>

                                        <ItemsPanelTemplate>

                                            <WrapPanel Orientation="Horizontal"/>

                                        </ItemsPanelTemplate>

                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Button Width="18" Height="18" Margin="2" Padding="0" Cursor="Hand"

                                                    Command="{Binding DataContext.SetFillColor1Command, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                                    CommandParameter="{Binding}"

                                                    ToolTip="{Binding}"

                                                    Template="{StaticResource ColorSwatchTemplate}"/>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>



                                <!-- End Color -->

                                <DockPanel Margin="0,2,0,2">

                                    <TextBlock Text="End Color:" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>

                                    <Button Command="{Binding SwapFillColorsCommand}" HorizontalAlignment="Right" Padding="6,2" Margin="0" FontSize="10"

                                            ToolTip="Swap Start and End Colors" Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}">

                                        <TextBlock Text="⇄ Swap" FontSize="10"/>

                                    </Button>

                                </DockPanel>

                                <Grid Margin="0,0,0,4">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="26"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" BorderBrush="#94A3B8" BorderThickness="1"

                                            Background="{Binding FillColor2, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                    <TextBox Grid.Column="1" Text="{Binding FillColor2, UpdateSourceTrigger=PropertyChanged}" LostFocus="FillTextBox_LostFocus" KeyDown="FillTextBox_KeyDown" VerticalAlignment="Center"/>

                                </Grid>

                                <ItemsControl ItemsSource="{Binding AvailablePresetColors}" Margin="0,1,0,4">

                                    <ItemsControl.ItemsPanel>

                                        <ItemsPanelTemplate>

                                            <WrapPanel Orientation="Horizontal"/>

                                        </ItemsPanelTemplate>

                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Button Width="18" Height="18" Margin="2" Padding="0" Cursor="Hand"

                                                    Command="{Binding DataContext.SetFillColor2Command, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                                    CommandParameter="{Binding}"

                                                    ToolTip="{Binding}"

                                                    Template="{StaticResource ColorSwatchTemplate}"/>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>



                                <!-- Direction -->

                                <TextBlock Text="Gradient Direction:" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,2"/>

                                <ComboBox ItemsSource="{Binding AvailableDirectionOptions}" SelectedItem="{Binding SelectedFillDirection}" DropDownClosed="FillTypeComboBox_DropDownClosed" DisplayMemberPath="Name" Margin="0,0,0,4"/>

                            </StackPanel>



                            <!-- Radial Gradient Fill Controls -->

                            <StackPanel Visibility="{Binding IsRadialGradientFill, Converter={StaticResource BooleanToVisibilityConverter}}">

                                <!-- Center Color -->

                                <TextBlock Text="Center Color:" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,2"/>

                                <Grid Margin="0,0,0,4">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="26"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" BorderBrush="#94A3B8" BorderThickness="1"

                                            Background="{Binding FillColor1, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                    <TextBox Grid.Column="1" Text="{Binding FillColor1, UpdateSourceTrigger=PropertyChanged}" LostFocus="FillTextBox_LostFocus" KeyDown="FillTextBox_KeyDown" VerticalAlignment="Center"/>

                                </Grid>

                                <ItemsControl ItemsSource="{Binding AvailablePresetColors}" Margin="0,1,0,4">

                                    <ItemsControl.ItemsPanel>

                                        <ItemsPanelTemplate>

                                            <WrapPanel Orientation="Horizontal"/>

                                        </ItemsPanelTemplate>

                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Button Width="18" Height="18" Margin="2" Padding="0" Cursor="Hand"

                                                    Command="{Binding DataContext.SetFillColor1Command, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                                    CommandParameter="{Binding}"

                                                    ToolTip="{Binding}"

                                                    Template="{StaticResource ColorSwatchTemplate}"/>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>



                                <!-- Outer Color -->

                                <DockPanel Margin="0,2,0,2">

                                    <TextBlock Text="Outer Color:" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>

                                    <Button Command="{Binding SwapFillColorsCommand}" HorizontalAlignment="Right" Padding="6,2" Margin="0" FontSize="10"

                                            ToolTip="Swap Colors" Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}">

                                        <TextBlock Text="⇄ Swap" FontSize="10"/>

                                    </Button>

                                </DockPanel>

                                <Grid Margin="0,0,0,4">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="26"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" BorderBrush="#94A3B8" BorderThickness="1"

                                            Background="{Binding FillColor2, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                    <TextBox Grid.Column="1" Text="{Binding FillColor2, UpdateSourceTrigger=PropertyChanged}" LostFocus="FillTextBox_LostFocus" KeyDown="FillTextBox_KeyDown" VerticalAlignment="Center"/>

                                </Grid>

                                <ItemsControl ItemsSource="{Binding AvailablePresetColors}" Margin="0,1,0,4">

                                    <ItemsControl.ItemsPanel>

                                        <ItemsPanelTemplate>

                                            <WrapPanel Orientation="Horizontal"/>

                                        </ItemsPanelTemplate>

                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Button Width="18" Height="18" Margin="2" Padding="0" Cursor="Hand"

                                                    Command="{Binding DataContext.SetFillColor2Command, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                                    CommandParameter="{Binding}"

                                                    ToolTip="{Binding}"

                                                    Template="{StaticResource ColorSwatchTemplate}"/>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </StackPanel>



                            <!-- No Fill Note -->

                            <TextBlock Text="No fill (transparent background)" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"

                                       Visibility="{Binding IsNoFill, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,2,0,2"/>

                        </StackPanel>



                        <!-- STROKE SECTION -->

                        <StackPanel Margin="0,4,0,0">

                            <!-- Stroke Header & Live Preview -->

                            <DockPanel Margin="0,0,0,6">

                                <TextBlock Text="Stroke (Border) Appearance:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>

                                <Border HorizontalAlignment="Right" Width="70" Height="18" CornerRadius="4"

                                        BorderThickness="3"

                                        BorderBrush="{Binding StrokeBrushString, Converter={StaticResource HexToBrushConverter}}"

                                        Background="Transparent"

                                        ToolTip="Live Stroke Preview"/>

                            </DockPanel>



                            <!-- Stroke Type Selector -->

                            <ComboBox ItemsSource="{Binding AvailableStrokeTypesList}" SelectedItem="{Binding StrokeType}" DropDownClosed="StrokeTypeComboBox_DropDownClosed" Margin="0,0,0,6"/>



                            <!-- Solid Stroke Controls -->

                            <StackPanel Visibility="{Binding IsSolidStroke, Converter={StaticResource BooleanToVisibilityConverter}}">

                                <Grid Margin="0,0,0,4">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="26"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" BorderBrush="#94A3B8" BorderThickness="1"

                                            Background="{Binding StrokeColor1, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                    <TextBox Grid.Column="1" Text="{Binding StrokeColor1, UpdateSourceTrigger=PropertyChanged}" LostFocus="StrokeTextBox_LostFocus" KeyDown="StrokeTextBox_KeyDown" VerticalAlignment="Center"/>

                                </Grid>

                                <!-- Quick Swatches for Stroke -->

                                <ItemsControl ItemsSource="{Binding AvailablePresetColors}" Margin="0,2,0,0">

                                    <ItemsControl.ItemsPanel>

                                        <ItemsPanelTemplate>

                                            <WrapPanel Orientation="Horizontal"/>

                                        </ItemsPanelTemplate>

                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Button Width="18" Height="18" Margin="2" Padding="0" Cursor="Hand"

                                                    Command="{Binding DataContext.SetStrokeColor1Command, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                                    CommandParameter="{Binding}"

                                                    ToolTip="{Binding}"

                                                    Template="{StaticResource ColorSwatchTemplate}"/>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </StackPanel>



                            <!-- Linear Gradient Stroke Controls -->

                            <StackPanel Visibility="{Binding IsLinearGradientStroke, Converter={StaticResource BooleanToVisibilityConverter}}">

                                <!-- Start Color -->

                                <TextBlock Text="Start Color:" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,2"/>

                                <Grid Margin="0,0,0,4">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="26"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" BorderBrush="#94A3B8" BorderThickness="1"

                                            Background="{Binding StrokeColor1, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                    <TextBox Grid.Column="1" Text="{Binding StrokeColor1, UpdateSourceTrigger=PropertyChanged}" LostFocus="StrokeTextBox_LostFocus" KeyDown="StrokeTextBox_KeyDown" VerticalAlignment="Center"/>

                                </Grid>

                                <ItemsControl ItemsSource="{Binding AvailablePresetColors}" Margin="0,1,0,4">

                                    <ItemsControl.ItemsPanel>

                                        <ItemsPanelTemplate>

                                            <WrapPanel Orientation="Horizontal"/>

                                        </ItemsPanelTemplate>

                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Button Width="18" Height="18" Margin="2" Padding="0" Cursor="Hand"

                                                    Command="{Binding DataContext.SetStrokeColor1Command, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                                    CommandParameter="{Binding}"

                                                    ToolTip="{Binding}"

                                                    Template="{StaticResource ColorSwatchTemplate}"/>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>



                                <!-- End Color -->

                                <DockPanel Margin="0,2,0,2">

                                    <TextBlock Text="End Color:" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>

                                    <Button Command="{Binding SwapStrokeColorsCommand}" HorizontalAlignment="Right" Padding="6,2" Margin="0" FontSize="10"

                                            ToolTip="Swap Stroke Colors" Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}">

                                        <TextBlock Text="⇄ Swap" FontSize="10"/>

                                    </Button>

                                </DockPanel>

                                <Grid Margin="0,0,0,4">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="26"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" BorderBrush="#94A3B8" BorderThickness="1"

                                            Background="{Binding StrokeColor2, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                    <TextBox Grid.Column="1" Text="{Binding StrokeColor2, UpdateSourceTrigger=PropertyChanged}" LostFocus="StrokeTextBox_LostFocus" KeyDown="StrokeTextBox_KeyDown" VerticalAlignment="Center"/>

                                </Grid>

                                <ItemsControl ItemsSource="{Binding AvailablePresetColors}" Margin="0,1,0,4">

                                    <ItemsControl.ItemsPanel>

                                        <ItemsPanelTemplate>

                                            <WrapPanel Orientation="Horizontal"/>

                                        </ItemsPanelTemplate>

                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Button Width="18" Height="18" Margin="2" Padding="0" Cursor="Hand"

                                                    Command="{Binding DataContext.SetStrokeColor2Command, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                                    CommandParameter="{Binding}"

                                                    ToolTip="{Binding}"

                                                    Template="{StaticResource ColorSwatchTemplate}"/>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>



                                <!-- Direction -->

                                <TextBlock Text="Gradient Direction:" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,2"/>

                                <ComboBox ItemsSource="{Binding AvailableDirectionOptions}" SelectedItem="{Binding SelectedStrokeDirection}" DropDownClosed="StrokeTypeComboBox_DropDownClosed" DisplayMemberPath="Name" Margin="0,0,0,4"/>

                            </StackPanel>



                            <!-- No Stroke Note -->

                            <TextBlock Text="No stroke outline (borderless)" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"

                                       Visibility="{Binding IsNoStroke, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,2,0,2"/>



                            <!-- Stroke Thickness -->

                            <DockPanel Margin="0,6,0,2">

                                <TextBlock Text="Stroke Thickness:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                                <TextBlock Text="{Binding CommonStrokeThickness, StringFormat='{}{0:F0} px'}" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Right" FontWeight="SemiBold"/>

                            </DockPanel>

                            <Slider Minimum="0" Maximum="20" Value="{Binding CommonStrokeThickness}" TickFrequency="1" IsSnapToTickEnabled="True"/>

                        </StackPanel>



                    </StackPanel>

                </GroupBox>



                <!-- 6. Shape Parameters (Corner Radius & Donut Inner Radius) -->

                <GroupBox Header="Geometry Parameters" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"

                          Visibility="{Binding IsShape, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <StackPanel Margin="4,6" TextElement.FontWeight="Normal">



                        <!-- Corner Radius -->

                        <StackPanel Visibility="{Binding IsRoundedShape, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">

                            <DockPanel Margin="0,0,0,2">

                                <TextBlock Text="Corner Radius (px):" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                                <TextBlock Text="{Binding CommonCornerRadius, StringFormat='{}{0:F0} px'}" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Right" FontWeight="SemiBold"/>

                            </DockPanel>

                            <Slider Minimum="0" Maximum="60" Value="{Binding CommonCornerRadius}" TickFrequency="2" IsSnapToTickEnabled="True"/>

                        </StackPanel>



                        <!-- Donut Inner Radius -->

                        <StackPanel Visibility="{Binding IsDonut, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">

                            <DockPanel Margin="0,0,0,2">

                                <TextBlock Text="Donut Inner Radius (%):" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                                <TextBlock Text="{Binding CommonInnerRadius, StringFormat='{}{0:F0}'}" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Right" FontWeight="SemiBold"/>

                            </DockPanel>

                            <Slider Minimum="5" Maximum="45" Value="{Binding CommonInnerRadius}" TickFrequency="1" IsSnapToTickEnabled="True"/>

                        </StackPanel>

                    </StackPanel>

                </GroupBox>



            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>

