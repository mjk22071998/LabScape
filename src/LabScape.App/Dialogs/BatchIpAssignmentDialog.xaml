<Window x:Class="LabScape.App.Dialogs.BatchIpAssignmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Manual &amp; Batch IP Address Assignment"
        Height="680"
        Width="580"
        MinHeight="550"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DialogBackgroundBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource SectionHeaderBackgroundBrush}"
                BorderBrush="{DynamicResource SectionHeaderBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌐" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Manual &amp; Batch IP Assignment" FontWeight="Bold" FontSize="15"
                               Foreground="{DynamicResource SectionHeaderForegroundBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Assign static manual IP addresses sequentially or selectively to enterprise lab workstations."
                           FontSize="11" Foreground="{DynamicResource SectionHeaderSubForegroundBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel Margin="0,0,4,0">
                <!-- 1. Scope Selection Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="1. Target Workstation Scope" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,8"/>
                        <RadioButton x:Name="RbSelected" Content="Selected workstations only (0 devices)"
                                     IsChecked="True" Checked="Scope_Changed" Margin="0,2,0,4"
                                     Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        <RadioButton x:Name="RbUnassigned" Content="All unassigned workstations on canvas (0 devices)"
                                     Checked="Scope_Changed" Margin="0,2,0,4"
                                     Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        <RadioButton x:Name="RbAll" Content="All workstations on active canvas (0 devices)"
                                     Checked="Scope_Changed" Margin="0,2,0,2"
                                     Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- 2. Manual IP Parameters Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="2. IP &amp; Network Configuration Parameters" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Starting IPv4 Address:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtStartIp" Text="192.168.1.101" Padding="6,4" TextChanged="Parameters_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Subnet Step:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtStep" Text="1" Padding="6,4" TextChanged="Parameters_Changed"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Hostname Prefix:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtPrefix" Text="PC-" Padding="6,4" TextChanged="Parameters_Changed"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkRename" Content="Auto-number workstation names (PC-01, PC-02...)"
                                      IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                      Checked="Parameters_Changed" Unchecked="Parameters_Changed"
                                      Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        </Grid>

                        <CheckBox x:Name="ChkGenerateMac" Content="Generate standard MAC addresses if not present (02:xx:xx:xx:xx:xx)"
                                  IsChecked="True" Checked="Parameters_Changed" Unchecked="Parameters_Changed"
                                  Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,4,0,2"/>
                    </StackPanel>
                </Border>

                <!-- 3. Assignment Live Preview -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="3. Planned Assignments Preview" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtPreviewCount" Text="0 items" FontSize="11"
                                       Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <ListView x:Name="LvPreview" MaxHeight="220" BorderThickness="1"
                                  BorderBrush="{DynamicResource CardBorderBrush}"
                                  Background="{DynamicResource InputBackgroundBrush}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Current Name" Width="130" DisplayMemberBinding="{Binding CurrentName}"/>
                                    <GridViewColumn Header="New Name" Width="130" DisplayMemberBinding="{Binding NewName}"/>
                                    <GridViewColumn Header="Assigned IPv4" Width="130" DisplayMemberBinding="{Binding AssignedIp}"/>
                                    <GridViewColumn Header="MAC Address" Width="120" DisplayMemberBinding="{Binding MacAddress}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Padding="0,8,0,0">
            <DockPanel>
                <Button Content="Clear / Unassign Selected" Click="Clear_Click"
                        Padding="12,7" Margin="0,0,8,0" DockPanel.Dock="Left"
                        Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="Cancel_Click"
                            Padding="16,7" Margin="0,0,8,0" IsCancel="True"
                            Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}"/>
                    <Button x:Name="BtnAssign" Content="Assign IPs" Click="Assign_Click"
                            Padding="20,7" IsDefault="True" FontWeight="SemiBold"
                            Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
