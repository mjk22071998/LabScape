<Window x:Class="LabScape.App.Dialogs.DatabaseSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PostgreSQL Database Connection &amp; Inventory Settings"
        Height="460" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F9FAFB">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="PostgreSQL Inventory Configuration" FontWeight="Bold" FontSize="14" Foreground="#3730A3"/>
                <TextBlock Text="Connect to the enterprise inventory database (read-only queries on public.devices) or toggle offline simulation."
                           TextWrapping="Wrap" FontSize="11" Foreground="#4B5563" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form Fields -->
        <StackPanel Grid.Row="1">
            <!-- Mock / Offline Toggle -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                <CheckBox x:Name="ChkUseMock" Content="Use Offline Simulated Lab Workstations (No PostgreSQL required)"
                          IsChecked="True" FontWeight="SemiBold" Foreground="#1F2937"
                          Checked="ChkUseMock_Checked" Unchecked="ChkUseMock_Unchecked"/>
            </Border>

            <GroupBox Header="Server Connection Details" FontWeight="SemiBold" Foreground="#374151">
                <Grid Margin="8" TextElement.FontWeight="Normal">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Host / IP:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="TxtHost" Grid.Row="0" Grid.Column="1" Text="127.0.0.1" Padding="4" Margin="0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Port:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="TxtPort" Grid.Row="1" Grid.Column="1" Text="5432" Padding="4" Margin="0,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Database:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="TxtDatabase" Grid.Row="2" Grid.Column="1" Text="inventory_db" Padding="4" Margin="0,4"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="TxtUsername" Grid.Row="3" Grid.Column="1" Text="postgres" Padding="4" Margin="0,4"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,4"/>
                    <PasswordBox x:Name="TxtPassword" Grid.Row="4" Grid.Column="1" Padding="4" Margin="0,4"/>
                </Grid>
            </GroupBox>

            <!-- Test Connection Diagnostic Banner -->
            <Border x:Name="DiagnosticBanner" CornerRadius="4" Padding="8" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock x:Name="TxtDiagnosticResult" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Buttons Footer -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="BtnTest" Content="⚡ Test Connection" Padding="12,6" FontWeight="SemiBold"
                    Click="BtnTest_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save &amp; Connect" Padding="16,6" FontWeight="Bold" Background="#4F46E5" Foreground="White"
                        Click="BtnSave_Click" Margin="0,0,8,0"/>
                <Button Content="Cancel" Padding="12,6" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
