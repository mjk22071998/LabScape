<Window x:Class="LabScape.App.Dialogs.DatabaseSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PostgreSQL Database Connection &amp; Inventory Settings"
        SizeToContent="Height"
        Width="540"
        MinHeight="500"
        MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource DialogBackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource SectionHeaderBackgroundBrush}" BorderBrush="{DynamicResource SectionHeaderBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="PostgreSQL Inventory Configuration" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource SectionHeaderForegroundBrush}"/>
                <TextBlock Text="Connect to your enterprise PostgreSQL inventory database to query live devices from the 'devices' table."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SectionHeaderSubForegroundBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Scrollable Form Fields & Diagnostic Results -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
            <StackPanel Margin="0,0,4,0">
                <!-- Mock / Offline Toggle -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                    <CheckBox x:Name="ChkUseMock" Content="Use Offline Simulated Lab Workstations (No PostgreSQL required)"
                              IsChecked="False" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                </Border>

                <GroupBox Header="Server Connection Details" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}">
                    <Grid Margin="8" TextElement.FontWeight="Normal">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Host / IP:" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox x:Name="TxtHost" Grid.Row="0" Grid.Column="1" Text="127.0.0.1" Padding="4" Margin="0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Port:" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox x:Name="TxtPort" Grid.Row="1" Grid.Column="1" Text="5432" Padding="4" Margin="0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Database:" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox x:Name="TxtDatabase" Grid.Row="2" Grid.Column="1" Text="network_observer" Padding="4" Margin="0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Username:" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox x:Name="TxtUsername" Grid.Row="3" Grid.Column="1" Text="postgres" Padding="4" Margin="0,4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Password:" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,4"/>
                        <PasswordBox x:Name="TxtPassword" Grid.Row="4" Grid.Column="1" Padding="4" Margin="0,4"/>
                    </Grid>
                </GroupBox>

                <!-- Test Connection Diagnostic Banner -->
                <Border x:Name="DiagnosticBanner" CornerRadius="6" Padding="12" Margin="0,12,0,4" Visibility="Collapsed" BorderThickness="1">
                    <TextBlock x:Name="TxtDiagnosticResult" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" LineHeight="18"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons Footer -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button x:Name="BtnTest" Content="⚡ Test Connection" Padding="14,7" FontWeight="SemiBold"
                    Click="BtnTest_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save &amp; Connect" Padding="18,7" FontWeight="Bold" Background="#4F46E5" Foreground="White"
                        Click="BtnSave_Click" Margin="0,0,8,0"/>
                <Button Content="Cancel" Padding="14,7" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
