<Window x:Class="LabScape.App.Dialogs.InsertCustomImageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Insert Custom Image"
        SizeToContent="Height"
        Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource DialogBackgroundBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Banner -->
        <Border Grid.Row="0" Background="{DynamicResource SectionHeaderBackgroundBrush}"
                BorderBrush="{DynamicResource SectionHeaderBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Vector Image Icon -->
                        <Path Data="M 2 3 H 20 A 1 1 0 0 1 21 4 V 18 A 1 1 0 0 1 20 19 H 2 A 1 1 0 0 1 1 18 V 4 A 1 1 0 0 1 2 3 Z M 3 16 L 8 10 L 13 16 M 12 16 L 15 12 L 19 16 M 15 7 A 1.5 1.5 0 1 1 15 6.99 Z"
                              Stroke="{DynamicResource SectionHeaderForegroundBrush}" StrokeThickness="1.4" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Insert Custom Image" FontWeight="Bold" FontSize="15"
                                   Foreground="{DynamicResource SectionHeaderForegroundBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="IMAGE IMPORT" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource SectionHeaderForegroundBrush}"/>
                    </Border>
                </DockPanel>
                <TextBlock Text="Choose how this custom image should function in your layout: active network hardware or visual furniture/asset."
                           FontSize="11" Foreground="{DynamicResource SectionHeaderSubForegroundBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 2. Main Content Body -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">

            <!-- Image File Preview Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Thumbnail Container with Direct3D rendering -->
                    <Border Grid.Column="0" Width="64" Height="64" Background="{DynamicResource DialogBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6"
                            Padding="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Image x:Name="ImgThumbnail" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- Image Info Metadata -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock x:Name="TxtFileName" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtDimensions" FontFamily="Consolas, Segoe UI, monospace" FontSize="10.5"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="TxtFilePath" FontSize="9.5"
                                   Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Prompt Question -->
            <TextBlock Text="Is this item network-related?" FontWeight="Bold" FontSize="12.5"
                       Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="2,0,0,8"/>

            <!-- Selection Card 1: Network-Related Device -->
            <Border x:Name="BorderNetwork" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1.5"
                    CornerRadius="8" Padding="12" Margin="0,0,0,10" Cursor="Hand" MouseDown="CardNetwork_MouseDown">
                <StackPanel>
                    <DockPanel>
                        <RadioButton x:Name="RbNetwork" Content="Network-Related Device" FontWeight="Bold" FontSize="12"
                                     IsChecked="True" Checked="Role_Changed" Foreground="{DynamicResource AppTextPrimaryBrush}"
                                     GroupName="RoleGroup" VerticalAlignment="Center"/>
                        <Border DockPanel.Dock="Right" Background="#150078D4" BorderBrush="#300078D4" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                            <TextBlock Text="NETWORK PARTICIPANT" FontSize="8.5" FontWeight="Bold" Foreground="#0078D4"/>
                        </Border>
                    </DockPanel>
                    <TextBlock Text="Active IT hardware (Switch, Server, PC, AP, IP Camera, Firewall, Gateway)."
                               FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="20,2,0,6"/>
                    <TextBlock Text="• Receives IP &amp; MAC address fields and participation in subnet validation"
                               FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" Margin="20,0,0,2"/>
                    <TextBlock Text="• Displays device name label beneath image on canvas"
                               FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" Margin="20,0,0,8"/>

                    <!-- Network Item Form Fields -->
                    <Grid x:Name="PanelNetworkFields" Margin="20,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Device Name:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtDeviceName" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,0,0,6" VerticalContentAlignment="Center" Padding="4,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Initial IP (Optional):" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtDeviceIp" Grid.Row="1" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Padding="4,0" FontFamily="Consolas, monospace"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Selection Card 2: Non-Network Asset / Furniture -->
            <Border x:Name="BorderNonNetwork" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,0,0,4" Cursor="Hand" MouseDown="CardNonNetwork_MouseDown">
                <StackPanel>
                    <DockPanel>
                        <RadioButton x:Name="RbNonNetwork" Content="Non-Network Asset / Furniture" FontWeight="Bold" FontSize="12"
                                     Checked="Role_Changed" Foreground="{DynamicResource AppTextPrimaryBrush}"
                                     GroupName="RoleGroup" VerticalAlignment="Center"/>
                        <Border DockPanel.Dock="Right" Background="#150D9488" BorderBrush="#300D9488" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                            <TextBlock Text="FURNITURE / ASSET" FontSize="8.5" FontWeight="Bold" Foreground="#0D9488"/>
                        </Border>
                    </DockPanel>
                    <TextBlock Text="Physical furniture, architectural fixture, room layout outline, or background graphic."
                               FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="20,2,0,6"/>
                    <TextBlock Text="• No IP/MAC requirements or unassigned validation warnings"
                               FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" Margin="20,0,0,2"/>
                    <TextBlock Text="• Clean presentation without label clutter"
                               FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" Margin="20,0,0,8"/>

                    <!-- Non-Network Form Fields -->
                    <Grid x:Name="PanelNonNetworkFields" Margin="20,4,0,0" IsEnabled="False" Opacity="0.5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Asset Name:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtFurnitureName" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 3. Action Buttons -->
        <Border Grid.Row="2" Background="{DynamicResource SectionHeaderBackgroundBrush}"
                BorderBrush="{DynamicResource SectionHeaderBorderBrush}"
                BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <DockPanel LastChildFill="False">
                <Button Content="Insert on Canvas" IsDefault="True" Click="Insert_Click" Width="140" Height="30" Cursor="Hand" DockPanel.Dock="Right" Margin="8,0,0,0"
                        Background="{DynamicResource AccentPrimaryBrush}" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Width="85" Height="30" Cursor="Hand" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
