<Window x:Class="LabScape.App.Dialogs.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color Spectrum &amp; Picker"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="NumericSliderTextBox" TargetType="TextBox">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Code, Segoe UI"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2,1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Banner -->
        <Border Grid.Row="0" Background="{DynamicResource SectionHeaderBackgroundBrush}"
                BorderBrush="{DynamicResource SectionHeaderBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 12 2 A 10 10 0 1 0 22 12 A 4 4 0 0 0 18 8 H 15 A 2 2 0 0 1 13 6 V 4 A 2 2 0 0 0 12 2 Z M 6.5 12 A 1.5 1.5 0 1 1 8 10.5 A 1.5 1.5 0 0 1 6.5 12 Z M 9.5 8 A 1.5 1.5 0 1 1 11 6.5 A 1.5 1.5 0 0 1 9.5 8 Z M 14.5 8 A 1.5 1.5 0 1 1 16 6.5 A 1.5 1.5 0 0 1 14.5 8 Z M 17.5 12 A 1.5 1.5 0 1 1 19 10.5 A 1.5 1.5 0 0 1 17.5 12 Z"
                          Fill="{DynamicResource AccentPrimaryBrush}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Color Spectrum &amp; Custom Picker" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource SectionHeaderForegroundBrush}"/>
                        <TextBlock Text="Select any of all 16.7 million colors using spectrum canvas, sliders, or hex code."
                                   FontSize="10.5" Foreground="{DynamicResource SectionHeaderSubForegroundBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="FULL PALETTE" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource SectionHeaderForegroundBrush}"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- 2. Main Color Selection Area -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: 2D Spectrum & Hue Slider -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Spectrum Canvas (Saturation × Brightness):" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,6"/>

                    <!-- 2D Canvas Area -->
                    <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                        <Canvas x:Name="SpectrumCanvas" Width="256" Height="180" Cursor="Cross"
                                MouseDown="SpectrumCanvas_MouseDown" MouseMove="SpectrumCanvas_MouseMove" MouseUp="SpectrumCanvas_MouseUp">
                            <!-- Background base colored by current pure hue -->
                            <Rectangle x:Name="HueBaseRect" Width="256" Height="180" Fill="#FF0000"/>

                            <!-- White gradient (Saturation from left to right) -->
                            <Rectangle Width="256" Height="180">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- Black gradient (Brightness/Value from top to bottom) -->
                            <Rectangle Width="256" Height="180">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0.0"/>
                                        <GradientStop Color="#FF000000" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- Crosshair Selector Thumb -->
                            <Ellipse x:Name="CrosshairThumb" Width="14" Height="14" Canvas.Left="120" Canvas.Top="80"
                                     Stroke="#FFFFFF" StrokeThickness="2" Fill="Transparent" IsHitTestVisible="False">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Border>

                    <!-- Rainbow Hue Slider -->
                    <TextBlock Text="Hue Spectrum (0° - 360°):" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,10,0,4"/>
                    <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Height="18" Margin="0,0,0,2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FF0000" Offset="0.00"/>
                                <GradientStop Color="#FFFF00" Offset="0.17"/>
                                <GradientStop Color="#00FF00" Offset="0.33"/>
                                <GradientStop Color="#00FFFF" Offset="0.50"/>
                                <GradientStop Color="#0000FF" Offset="0.67"/>
                                <GradientStop Color="#FF00FF" Offset="0.83"/>
                                <GradientStop Color="#FF0000" Offset="1.00"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Slider x:Name="HueSlider" Minimum="0" Maximum="360" Value="0"
                            ValueChanged="HueSlider_ValueChanged" Margin="0,0,0,4"/>
                </StackPanel>

                <!-- Right Column: Numeric Inputs, Live Preview & Quick Swatches -->
                <StackPanel Grid.Column="2">
                    <!-- Live Preview Box -->
                    <TextBlock Text="Color Preview:" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Height="36" Margin="0,0,0,10" ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Original / Old Color -->
                            <Border Grid.Column="0" x:Name="OldColorBox" Background="#FFFFFF" ToolTip="Original Color">
                                <TextBlock Text="Original" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#888888" FontWeight="SemiBold"/>
                            </Border>
                            <!-- New / Selected Color -->
                            <Border Grid.Column="1" x:Name="NewColorBox" Background="#FF0000" ToolTip="New Selected Color">
                                <TextBlock Text="New" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#FFFFFF" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Hex Code Field -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Hex Code:" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Width="60"/>
                        <TextBox x:Name="HexTextBox" Height="24" FontSize="12" FontFamily="Consolas, Cascadia Code, Segoe UI"
                                 FontWeight="Bold" TextAlignment="Center" Text="#FF0000"
                                 Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}"
                                 BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                 TextChanged="HexTextBox_TextChanged" LostFocus="HexTextBox_LostFocus" KeyDown="HexTextBox_KeyDown"/>
                    </DockPanel>

                    <!-- RGB Component Controls -->
                    <Grid Margin="0,0,0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="46"/>
                        </Grid.ColumnDefinitions>

                        <!-- Red -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="R (Red):" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Row="0" Grid.Column="1" x:Name="RedSlider" Minimum="0" Maximum="255" Value="255" ValueChanged="RgbSlider_ValueChanged" Margin="4,0"/>
                        <TextBox Grid.Row="0" Grid.Column="2" x:Name="RedTextBox" Style="{StaticResource NumericSliderTextBox}" Text="255" TextChanged="RgbTextBox_TextChanged"/>

                        <!-- Green -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="G (Grn):" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,3,0,0"/>
                        <Slider Grid.Row="1" Grid.Column="1" x:Name="GreenSlider" Minimum="0" Maximum="255" Value="0" ValueChanged="RgbSlider_ValueChanged" Margin="4,3,4,0"/>
                        <TextBox Grid.Row="1" Grid.Column="2" x:Name="GreenTextBox" Style="{StaticResource NumericSliderTextBox}" Text="0" Margin="0,3,0,0" TextChanged="RgbTextBox_TextChanged"/>

                        <!-- Blue -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="B (Blu):" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,3,0,0"/>
                        <Slider Grid.Row="2" Grid.Column="1" x:Name="BlueSlider" Minimum="0" Maximum="255" Value="0" ValueChanged="RgbSlider_ValueChanged" Margin="4,3,4,0"/>
                        <TextBox Grid.Row="2" Grid.Column="2" x:Name="BlueTextBox" Style="{StaticResource NumericSliderTextBox}" Text="0" Margin="0,3,0,0" TextChanged="RgbTextBox_TextChanged"/>
                    </Grid>

                    <!-- Quick Preset Swatches -->
                    <TextBlock Text="Quick Swatches:" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,8,0,4"/>
                    <WrapPanel x:Name="QuickSwatchesPanel" Margin="0,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Bottom Action Buttons -->
        <DockPanel Grid.Row="2">
            <TextBlock Text="Tip: Click anywhere on the 2D canvas or hue slider to explore all colors."
                       FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Click="CancelButton_Click"
                        Width="85" Height="28" Margin="0,0,8,0"/>
                <Button Content="Apply Color" IsDefault="True" Click="ApplyButton_Click"
                        Width="105" Height="28"
                        Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
