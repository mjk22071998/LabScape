<Application x:Class="LabScape.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LabScape.App.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Fluent;component/Themes/Generic.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Fluent;component/Themes/Themes/Light.Cobalt.xaml"/>
                <ResourceDictionary Source="Resources/Icons.xaml"/>
                <ResourceDictionary Source="Resources/Stencils.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Standard Converters -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:HalfValueConverter x:Key="HalfValueConverter"/>
            <converters:HexToBrushConverter x:Key="HexToBrushConverter"/>
            <converters:ValidationBadgeVisibilityConverter x:Key="ValidationBadgeVisibilityConverter"/>
            <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
            <converters:DeviceTypeToImageConverter x:Key="DeviceTypeToImageConverter"/>
            <converters:FurnitureTypeToImageConverter x:Key="FurnitureTypeToImageConverter"/>
            <converters:ShapeToGeometryConverter x:Key="ShapeToGeometryConverter"/>
            <converters:ResourceKeyToImageConverter x:Key="ResourceKeyToImageConverter"/>
            <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
