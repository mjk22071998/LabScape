<fluent:RibbonWindow x:Class="LabScape.App.MainWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:fluent="urn:fluent-ribbon"
                     xmlns:dock="https://github.com/Dirkster99/AvalonDock"
                     xmlns:views="clr-namespace:LabScape.App.Views"
                     mc:Ignorable="d"
                     Title="LabScape - Enterprise Physical Layout Designer" Height="800" Width="1200"
                     WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ==================================================== -->
        <!-- 1. OFFICE FLUENT RIBBON                              -->
        <!-- ==================================================== -->
        <fluent:Ribbon Grid.Row="0">

            <!-- Backstage / Application Menu -->
            <fluent:Ribbon.Menu>
                <fluent:Backstage Header="File">
                    <fluent:BackstageTabControl>
                        <fluent:Button Header="New Floorplan" Command="{Binding NewDocumentCommand}"/>
                        <fluent:Button Header="Save As JSON..." Click="ExportJson_Click"/>
                        <fluent:Button Header="Open JSON..." Click="OpenJson_Click"/>
                        <fluent:Button Header="Exit" Click="Exit_Click"/>
                    </fluent:BackstageTabControl>
                </fluent:Backstage>
            </fluent:Ribbon.Menu>

            <!-- Quick Access Toolbar -->
            <fluent:Ribbon.QuickAccessItems>
                <fluent:QuickAccessMenuItem Target="{Binding ElementName=BtnUndo}"/>
                <fluent:QuickAccessMenuItem Target="{Binding ElementName=BtnRedo}"/>
            </fluent:Ribbon.QuickAccessItems>

            <!-- 1. Home Tab -->
            <fluent:RibbonTabItem Header="Home">
                <!-- Undo/Redo & Clipboard -->
                <fluent:RibbonGroupBox Header="History &amp; Clipboard">
                    <fluent:Button x:Name="BtnUndo" Header="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" LargeIcon="Undo"/>
                    <fluent:Button x:Name="BtnRedo" Header="Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" LargeIcon="Redo"/>
                    <fluent:Button Header="Delete" Command="{Binding Canvas.DeleteSelectedCommand}" LargeIcon="Delete"/>
                </fluent:RibbonGroupBox>

                <!-- Tools -->
                <fluent:RibbonGroupBox Header="Navigation &amp; Tools">
                    <fluent:ToggleButton Header="Select" IsChecked="True"/>
                    <fluent:Button Header="Zoom 100%" Command="{Binding Canvas.ResetZoomCommand}"/>
                    <fluent:Button Header="Zoom In" Command="{Binding Canvas.ZoomInCommand}"/>
                    <fluent:Button Header="Zoom Out" Command="{Binding Canvas.ZoomOutCommand}"/>
                </fluent:RibbonGroupBox>

                <!-- Grouping & Hierarchy -->
                <fluent:RibbonGroupBox Header="Grouping (Ctrl+G)">
                    <fluent:Button Header="Group" Command="{Binding Canvas.GroupSelectedCommand}"
                                   ToolTip="Group selected items (Ctrl+G)"/>
                    <fluent:Button Header="Ungroup" Command="{Binding Canvas.UngroupSelectedCommand}"
                                   ToolTip="Ungroup selected items (Ctrl+Shift+G)"/>
                </fluent:RibbonGroupBox>

                <!-- Layering & Z-Index -->
                <fluent:RibbonGroupBox Header="Z-Index Layering">
                    <fluent:Button Header="Bring to Front" Command="{Binding Canvas.BringToFrontCommand}"/>
                    <fluent:Button Header="Send to Back" Command="{Binding Canvas.SendToBackCommand}"/>
                    <fluent:Button Header="Bring Forward" Command="{Binding Canvas.BringForwardCommand}"/>
                    <fluent:Button Header="Send Backward" Command="{Binding Canvas.SendBackwardCommand}"/>
                </fluent:RibbonGroupBox>

                <!-- Align & Distribute -->
                <fluent:RibbonGroupBox Header="Alignment">
                    <fluent:Button Header="Align Left" Command="{Binding Canvas.AlignLeftCommand}"/>
                    <fluent:Button Header="Align Center" Command="{Binding Canvas.AlignCenterCommand}"/>
                    <fluent:Button Header="Align Right" Command="{Binding Canvas.AlignRightCommand}"/>
                    <fluent:Button Header="Align Top" Command="{Binding Canvas.AlignTopCommand}"/>
                    <fluent:Button Header="Align Middle" Command="{Binding Canvas.AlignMiddleCommand}"/>
                    <fluent:Button Header="Align Bottom" Command="{Binding Canvas.AlignBottomCommand}"/>
                </fluent:RibbonGroupBox>

                <!-- Canvas Surface & Grid View -->
                <fluent:RibbonGroupBox Header="Grid &amp; Guides">
                    <fluent:CheckBox Header="Show Grid" IsChecked="{Binding Canvas.ShowGrid}"/>
                    <fluent:CheckBox Header="Snap to Grid" IsChecked="{Binding Canvas.SnapToGrid}"/>
                    <fluent:CheckBox Header="Show Rulers" IsChecked="{Binding Canvas.ShowRulers}"/>
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>

            <!-- 2. Database Tab -->
            <fluent:RibbonTabItem Header="Database">
                <fluent:RibbonGroupBox Header="PostgreSQL Inventory Connection">
                    <fluent:Button Header="Connect Database..." Click="DatabaseConnect_Click"/>
                    <fluent:Button Header="Sync Inventory" Click="SyncInventory_Click"/>
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>

            <!-- 3. Export & Web Tab -->
            <fluent:RibbonTabItem Header="Export &amp; Web">
                <fluent:RibbonGroupBox Header="HTML5 &amp; JSON Interchange">
                    <fluent:Button Header="Export JSON..." Click="ExportJson_Click" ToolTip="Export lossless layout JSON for downstream web canvas"/>
                    <fluent:Button Header="Open in Web Viewer" Click="PreviewWebViewer_Click" ToolTip="Launch standalone HTML5 2D Canvas viewer in browser"/>
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>
        </fluent:Ribbon>

        <!-- ==================================================== -->
        <!-- 2. AVALONDOCK WORKSPACE (Left, Center, Right)         -->
        <!-- ==================================================== -->
        <dock:DockingManager Grid.Row="1" x:Name="DockManager">
            <dock:LayoutRoot>
                <dock:LayoutPanel Orientation="Horizontal">

                    <!-- Left: Stencils Palette -->
                    <dock:LayoutAnchorablePane DockWidth="260">
                        <dock:LayoutAnchorable Title="Stencils Library" CanClose="False" CanHide="False">
                            <views:StencilsPaletteView DataContext="{Binding Stencils}"/>
                        </dock:LayoutAnchorable>
                    </dock:LayoutAnchorablePane>

                    <!-- Center: Interactive Floorplan Canvas -->
                    <dock:LayoutDocumentPane>
                        <dock:LayoutDocument Title="Floorplan Canvas" CanClose="False">
                            <views:CanvasView DataContext="{Binding Canvas}"/>
                        </dock:LayoutDocument>
                    </dock:LayoutDocumentPane>

                    <!-- Right: Properties Inspector -->
                    <dock:LayoutAnchorablePane DockWidth="280">
                        <dock:LayoutAnchorable Title="Properties &amp; Inspector" CanClose="False" CanHide="False">
                            <views:PropertiesInspectorView DataContext="{Binding Properties}"/>
                        </dock:LayoutAnchorable>
                    </dock:LayoutAnchorablePane>

                </dock:LayoutPanel>
            </dock:LayoutRoot>
        </dock:DockingManager>

        <!-- ==================================================== -->
        <!-- 3. STATUS BAR                                        -->
        <!-- ==================================================== -->
        <StatusBar Grid.Row="2" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- Cursor X, Y -->
            <StatusBarItem Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Cursor: " Foreground="#6B7280" FontSize="11"/>
                    <TextBlock Text="{Binding Canvas.CursorX, StringFormat='X: {0}px, '}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Canvas.CursorY, StringFormat='Y: {0}px'}" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
            </StatusBarItem>

            <!-- Selection Count -->
            <StatusBarItem Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="{Binding Canvas.SelectedItems.Count, StringFormat='Selected: {0} items'}" FontSize="11" Foreground="#4B5563"/>
            </StatusBarItem>

            <!-- Validation Counters -->
            <StatusBarItem Grid.Column="3" Margin="10,0">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                        <TextBlock Text="{Binding ValidationWarningCount, StringFormat='⚠️ {0} Unassigned'}" FontSize="10" FontWeight="SemiBold" Foreground="#92400E"/>
                    </Border>
                    <Border Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="3" Padding="4,1">
                        <TextBlock Text="{Binding ValidationErrorCount, StringFormat='⛔ {0} IP Conflicts'}" FontSize="10" FontWeight="SemiBold" Foreground="#991B1B"/>
                    </Border>
                </StackPanel>
            </StatusBarItem>

            <!-- Zoom Level -->
            <StatusBarItem Grid.Column="4" Margin="10,0">
                <TextBlock Text="{Binding Canvas.ZoomLevel, StringFormat='Zoom: {0:P0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#1F2937"/>
            </StatusBarItem>

            <!-- Database Status -->
            <StatusBarItem Grid.Column="5" Margin="10,0">
                <TextBlock Text="{Binding DatabaseStatusText}" FontSize="11" Foreground="#6B7280"/>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</fluent:RibbonWindow>
