<fluent:RibbonWindow x:Class="LabScape.App.MainWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:fluent="urn:fluent-ribbon"
                      xmlns:dock="https://github.com/Dirkster99/AvalonDock"
                      xmlns:views="clr-namespace:LabScape.App.Views"
                      mc:Ignorable="d"
                      Title="{Binding WindowTitle}" Height="800" Width="1200"
                      WindowStartupLocation="CenterScreen"
                      PreviewKeyDown="Window_PreviewKeyDown"
                      RenderOptions.BitmapScalingMode="HighQuality"
                      RenderOptions.ClearTypeHint="Enabled"
                      RenderOptions.EdgeMode="Unspecified"
                      TextOptions.TextFormattingMode="Display"
                      TextOptions.TextRenderingMode="ClearType"
                      UseLayoutRounding="True"
                      SnapsToDevicePixels="True">

    <fluent:RibbonWindow.Resources>
        <!-- Browser Tab Context Menu -->
        <ContextMenu x:Key="TabContextMenu">
            <MenuItem Header="Close Tab" Command="{Binding PlacementTarget.Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+W">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconCloseTab}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Close Other Tabs" Command="{Binding PlacementTarget.Tag.CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconCloseOthers}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Close All Tabs" Command="{Binding PlacementTarget.Tag.CloseAllTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconCloseAll}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="New Tab" Command="{Binding PlacementTarget.Tag.NewTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+N">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconNewTab}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Save Floorplan" Click="SaveJson_Click" InputGestureText="Ctrl+S">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconSave}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Save As..." Click="SaveAsJson_Click" InputGestureText="Ctrl+Shift+S">
                <MenuItem.Icon>
                    <Image Source="{StaticResource IconSaveAs}" Width="15" Height="15"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </fluent:RibbonWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ==================================================== -->
        <!-- 1. OFFICE FLUENT RIBBON                              -->
        <!-- ==================================================== -->
        <fluent:Ribbon Grid.Row="0">

            <!-- Office Window TitleBar Integration -->
            <fluent:Ribbon.TitleBar>
                <fluent:RibbonTitleBar Header="{Binding WindowTitle}"/>
            </fluent:Ribbon.TitleBar>

            <!-- Backstage / Application Menu -->
            <fluent:Ribbon.Menu>
                <fluent:Backstage Header="File">
                    <fluent:BackstageTabControl>
                        <fluent:Button Header="New Floorplan (Ctrl+N)" Command="{Binding NewTabCommand}"
                                       Icon="{StaticResource IconNewTab}" LargeIcon="{StaticResource IconNewTab}"/>
                        <fluent:Button Header="Open / Import JSON... (Ctrl+O)" Click="OpenJson_Click"
                                       Icon="{StaticResource IconOpen}" LargeIcon="{StaticResource IconOpen}"/>
                        <fluent:Button Header="Save JSON (Ctrl+S)" Click="SaveJson_Click"
                                       Icon="{StaticResource IconSave}" LargeIcon="{StaticResource IconSave}"/>
                        <fluent:Button Header="Save As JSON... (Ctrl+Shift+S)" Click="SaveAsJson_Click"
                                       Icon="{StaticResource IconSaveAs}" LargeIcon="{StaticResource IconSaveAs}"/>
                        <fluent:Button Header="Close Tab (Ctrl+W)" Command="{Binding CloseActiveTabCommand}"
                                       Icon="{StaticResource IconCloseTab}" LargeIcon="{StaticResource IconCloseTab}"/>
                        <fluent:Button Header="Page Setup... (Ctrl+Shift+P)" Click="OpenPageSetupDialog_Click"
                                       Icon="{StaticResource IconPageSetupDialog}" LargeIcon="{StaticResource IconPageSetupDialog}"/>
                        <fluent:Button Header="Export to Web JSON..." Click="ExportJson_Click"
                                       Icon="{StaticResource IconExport}" LargeIcon="{StaticResource IconExport}"/>
                        <fluent:Button Header="Toggle Light / Dark Theme (F8)" Click="ThemeToggle_Click"
                                       Icon="{StaticResource IconThemeDark}" LargeIcon="{StaticResource IconThemeDark}"/>
                        <fluent:Button Header="Exit" Click="Exit_Click"
                                       Icon="{StaticResource IconExit}" LargeIcon="{StaticResource IconExit}"/>
                    </fluent:BackstageTabControl>
                </fluent:Backstage>
            </fluent:Ribbon.Menu>

            <!-- Quick Access Toolbar -->
            <fluent:Ribbon.QuickAccessItems>
                <fluent:QuickAccessMenuItem Target="{Binding ElementName=BtnSave}"/>
                <fluent:QuickAccessMenuItem Target="{Binding ElementName=BtnUndo}"/>
                <fluent:QuickAccessMenuItem Target="{Binding ElementName=BtnRedo}"/>
                <fluent:QuickAccessMenuItem Target="{Binding ElementName=BtnDarkTheme}"/>
            </fluent:Ribbon.QuickAccessItems>

            <!-- 1. Home Tab -->
            <fluent:RibbonTabItem Header="Home">
                <!-- Documents Management -->
                <fluent:RibbonGroupBox Header="Documents">
                    <fluent:Button Header="New Tab" Command="{Binding NewTabCommand}" ToolTip="New floorplan tab (Ctrl+N)"
                                   Size="Large"
                                   Icon="{StaticResource IconNewTab}" LargeIcon="{StaticResource IconNewTab}"/>
                    <fluent:Button x:Name="BtnSave" Header="Save" Click="SaveJson_Click" ToolTip="Save floorplan JSON (Ctrl+S)"
                                   Size="Middle"
                                   Icon="{StaticResource IconSave}"/>
                    <fluent:Button Header="Close Tab" Command="{Binding CloseActiveTabCommand}" ToolTip="Close current tab (Ctrl+W)"
                                   Size="Middle"
                                   Icon="{StaticResource IconCloseTab}"/>
                </fluent:RibbonGroupBox>

                <!-- History & Clipboard -->
                <fluent:RibbonGroupBox Header="Clipboard &amp; History">
                    <fluent:Button Header="Paste" Command="{Binding Canvas.PasteCommand}" ToolTip="Paste items (Ctrl+V)"
                                   Size="Large"
                                   Icon="{StaticResource IconPaste}" LargeIcon="{StaticResource IconPaste}"/>
                    <fluent:Button Header="Cut" Command="{Binding Canvas.CutSelectedCommand}" ToolTip="Cut selected items (Ctrl+X)"
                                   Size="Small"
                                   Icon="{StaticResource IconCut}"/>
                    <fluent:Button Header="Copy" Command="{Binding Canvas.CopySelectedCommand}" ToolTip="Copy selected items (Ctrl+C)"
                                   Size="Small"
                                   Icon="{StaticResource IconCopy}"/>
                    <fluent:Button Header="Duplicate" Command="{Binding Canvas.DuplicateSelectedCommand}" ToolTip="Duplicate in place (Ctrl+D)"
                                   Size="Small"
                                   Icon="{StaticResource IconDuplicate}"/>
                    <fluent:Button x:Name="BtnUndo" Header="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip="Undo (Ctrl+Z)"
                                   Size="Small"
                                   Icon="{StaticResource IconUndo}"/>
                    <fluent:Button x:Name="BtnRedo" Header="Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTip="Redo (Ctrl+Y / Ctrl+Shift+Z)"
                                   Size="Small"
                                   Icon="{StaticResource IconRedo}"/>
                    <fluent:Button Header="Delete" Command="{Binding Canvas.DeleteSelectedCommand}" ToolTip="Delete selected (Del)"
                                   Size="Small"
                                   Icon="{StaticResource IconDelete}"/>
                </fluent:RibbonGroupBox>

                <!-- Tools & Zoom Navigation -->
                <fluent:RibbonGroupBox Header="Tools &amp; View">
                    <fluent:ToggleButton Header="Select" IsChecked="True"
                                         Size="Large"
                                         Icon="{StaticResource IconSelect}" LargeIcon="{StaticResource IconSelect}"/>
                    <fluent:Button Header="Text" Command="{Binding Canvas.AddTextItemCommand}" ToolTip="Insert Text Box (T)"
                                   Size="Large"
                                   Icon="{StaticResource IconText}" LargeIcon="{StaticResource IconText}"/>
                    <fluent:Button Header="Image" Click="InsertImage_Click" ToolTip="Insert Custom Image (PNG, JPG, BMP...)"
                                   Size="Large"
                                   Icon="{StaticResource IconImage}" LargeIcon="{StaticResource IconImage}"/>
                    <fluent:Button Header="Zoom In" Command="{Binding Canvas.ZoomInCommand}" ToolTip="Zoom In (Ctrl++)"
                                   Size="Small"
                                   Icon="{StaticResource IconZoomIn}"/>
                    <fluent:Button Header="Zoom Out" Command="{Binding Canvas.ZoomOutCommand}" ToolTip="Zoom Out (Ctrl+-)"
                                   Size="Small"
                                   Icon="{StaticResource IconZoomOut}"/>
                    <fluent:Button Header="100%" Command="{Binding Canvas.ResetZoomCommand}" ToolTip="Reset Zoom (Ctrl+0)"
                                   Size="Small"
                                   Icon="{StaticResource IconResetZoom}"/>
                </fluent:RibbonGroupBox>

                <!-- Tool Windows & Panels Management -->
                <fluent:RibbonGroupBox Header="Panels">
                    <fluent:Button Header="Stencils" Click="OpenStencils_Click"
                                   ToolTip="Open and dock Stencils Library window"
                                   Size="Middle"
                                   Icon="{StaticResource IconStencils}"/>
                    <fluent:Button Header="Room Templates" Click="RoomGenerator_Click"
                                   ToolTip="Open and dock Room Templates panel"
                                   Size="Middle"
                                   Icon="{StaticResource IconRoomTemplate}"/>
                    <fluent:Button Header="Properties" Click="OpenProperties_Click"
                                   ToolTip="Open and dock Properties &amp; Inspector window (F4)"
                                   Size="Middle"
                                   Icon="{StaticResource IconInspect}"/>
                    <fluent:Button Header="Layers" Click="OpenLayers_Click"
                                   ToolTip="Open and dock Layers panel"
                                   Size="Middle"
                                   Icon="{StaticResource IconLayers}"/>
                    <fluent:Button Header="Reset Layout" Click="ResetLayout_Click"
                                   ToolTip="Reopen and dock all tool windows to default positions"
                                   Size="Small"
                                   Icon="{StaticResource IconResetZoom}"/>
                </fluent:RibbonGroupBox>

                <!-- Canvas Surface & Grid View -->
                <fluent:RibbonGroupBox Header="Grid &amp; Guides">
                    <fluent:CheckBox Header="Show Grid" IsChecked="{Binding Canvas.ShowGrid}"
                                     Icon="{StaticResource IconShowGrid}"/>
                    <fluent:CheckBox Header="Snap to Grid" IsChecked="{Binding Canvas.SnapToGrid}"
                                     Icon="{StaticResource IconSnapToGrid}"/>
                    <fluent:CheckBox Header="Show Rulers" IsChecked="{Binding Canvas.ShowRulers}"
                                     Icon="{StaticResource IconShowRulers}"/>
                </fluent:RibbonGroupBox>

                <!-- Theme / Appearance -->
                <fluent:RibbonGroupBox Header="Theme">
                    <fluent:ToggleButton x:Name="BtnDarkTheme" Header="Dark Theme"
                                         Click="ThemeToggle_Click"
                                         ToolTip="Toggle Light / Dark Theme (F8)"
                                         Size="Middle"
                                         Icon="{StaticResource IconThemeDark}"/>
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>

            <!-- 2. Page Layout Tab (MS Office Page Setup & Canvas Layout) -->
            <fluent:RibbonTabItem Header="Page Layout">
                <!-- Page Setup Group -->
                <fluent:RibbonGroupBox Header="Page Setup"
                                       LauncherClick="OpenPageSetupDialog_Click"
                                       LauncherToolTip="Open Page Setup Dialog (Ctrl+Shift+P)">
                    <!-- Visio-Style Auto Size Toggle -->
                    <fluent:ToggleButton Header="Auto Size"
                                         IsChecked="{Binding Canvas.AutoSize}"
                                         Size="Large"
                                         Icon="{StaticResource IconAutoSize}"
                                         LargeIcon="{StaticResource IconAutoSize}"
                                         ToolTip="Automatically expand canvas by adding pages when shapes cross boundaries, and shrink to minimum possible pages (Visio style)"/>

                    <!-- Page Size Presets Dropdown -->
                    <fluent:DropDownButton Header="Size"
                                           Size="Large"
                                           Icon="{StaticResource IconPageSize}"
                                           LargeIcon="{StaticResource IconPageSize}"
                                           ToolTip="Select standard base paper size (A4, A3, Letter, etc.) or custom dimensions">
                        <fluent:MenuItem Header="ISO Standard (Lab &amp; Floorplan)">
                            <fluent:MenuItem Header="A3 (420 × 297 mm) - Standard Lab" Tag="A3" Click="SetPageSizePreset_Click" Icon="{StaticResource IconPageSize}"/>
                            <fluent:MenuItem Header="A4 (297 × 210 mm) - Standard Document" Tag="A4" Click="SetPageSizePreset_Click" Icon="{StaticResource IconPageSize}"/>
                            <fluent:MenuItem Header="A2 (594 × 420 mm) - Large Facility" Tag="A2" Click="SetPageSizePreset_Click" Icon="{StaticResource IconPageSize}"/>
                            <fluent:MenuItem Header="A1 (841 × 594 mm) - Full Architectural" Tag="A1" Click="SetPageSizePreset_Click" Icon="{StaticResource IconPageSize}"/>
                        </fluent:MenuItem>
                        <fluent:MenuItem Header="US / ANSI Standard">
                            <fluent:MenuItem Header="US Letter (8.5 × 11 in)" Tag="Letter" Click="SetPageSizePreset_Click" Icon="{StaticResource IconPageSize}"/>
                            <fluent:MenuItem Header="US Legal (8.5 × 14 in)" Tag="Legal" Click="SetPageSizePreset_Click" Icon="{StaticResource IconPageSize}"/>
                            <fluent:MenuItem Header="US Tabloid / Ledger (11 × 17 in)" Tag="Tabloid" Click="SetPageSizePreset_Click" Icon="{StaticResource IconPageSize}"/>
                        </fluent:MenuItem>
                        <fluent:MenuItem Header="Digital Display">
                            <fluent:MenuItem Header="Full HD 1080p (1920 × 1080 px)" Tag="Screen1080p" Click="SetPageSizePreset_Click" Icon="{StaticResource IconPageSize}"/>
                        </fluent:MenuItem>
                        <Separator/>
                        <fluent:MenuItem Header="Custom Dimensions..." Click="CustomPageSize_Click" Icon="{StaticResource IconInspect}"/>
                        <fluent:MenuItem Header="More Page Sizes..." Click="OpenPageSetupDialog_Click" Icon="{StaticResource IconPageSetupDialog}"/>
                    </fluent:DropDownButton>

                    <!-- Page Orientation Dropdown -->
                    <fluent:DropDownButton Header="Orientation"
                                           Size="Large"
                                           Icon="{StaticResource IconOrientation}"
                                           LargeIcon="{StaticResource IconOrientation}"
                                           ToolTip="Change canvas page orientation (Landscape or Portrait)">
                        <fluent:MenuItem Header="Landscape (Horizontal)" Tag="Landscape" Click="SetPageOrientation_Click" Icon="{StaticResource IconLandscape}"/>
                        <fluent:MenuItem Header="Portrait (Vertical)" Tag="Portrait" Click="SetPageOrientation_Click" Icon="{StaticResource IconPortrait}"/>
                    </fluent:DropDownButton>

                    <!-- Page Setup Modal Dialog Button -->
                    <fluent:Button Header="Page Setup"
                                   Click="OpenPageSetupDialog_Click"
                                   Size="Middle"
                                   Icon="{StaticResource IconPageSetupDialog}"
                                   LargeIcon="{StaticResource IconPageSetupDialog}"
                                   ToolTip="Open full Page Setup dialog (Ctrl+Shift+P)"/>

                    <!-- Fit Page to Viewport -->
                    <fluent:Button Header="Fit Page"
                                   Command="{Binding Canvas.FitToPageCommand}"
                                   Size="Middle"
                                   Icon="{StaticResource IconFitPage}"
                                   LargeIcon="{StaticResource IconFitPage}"
                                   ToolTip="Fit entire page into canvas viewport"/>
                </fluent:RibbonGroupBox>

                <!-- Page Dimensions Group -->
                <fluent:RibbonGroupBox Header="Page Dimensions">
                    <StackPanel VerticalAlignment="Center" Margin="4,2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Width:" FontSize="10.5" Width="45" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Canvas.BasePageWidth, StringFormat='{}{0:F0}', UpdateSourceTrigger=LostFocus}" Width="65"
                                     Style="{StaticResource NumericCoordinateTextBoxStyle}"/>
                            <TextBlock Text=" px" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Height:" FontSize="10.5" Width="45" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Canvas.BasePageHeight, StringFormat='{}{0:F0}', UpdateSourceTrigger=LostFocus}" Width="65"
                                     Style="{StaticResource NumericCoordinateTextBoxStyle}"/>
                            <TextBlock Text=" px" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="4,0" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{Binding Canvas.PageSizeDisplayText}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            <TextBlock Text="Standard 96 DPI" FontSize="8.5" Foreground="{DynamicResource AppTextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                </fluent:RibbonGroupBox>

                <!-- Canvas Guides & Surface Group -->
                <fluent:RibbonGroupBox Header="Grid &amp; Guides">
                    <fluent:CheckBox Header="Show Grid" IsChecked="{Binding Canvas.ShowGrid}"
                                     Icon="{StaticResource IconShowGrid}"/>
                    <fluent:CheckBox Header="Snap to Grid" IsChecked="{Binding Canvas.SnapToGrid}"
                                     Icon="{StaticResource IconSnapToGrid}"/>
                    <fluent:CheckBox Header="Show Rulers" IsChecked="{Binding Canvas.ShowRulers}"
                                     Icon="{StaticResource IconShowRulers}"/>
                </fluent:RibbonGroupBox>

                <!-- View & Zoom Navigation -->
                <fluent:RibbonGroupBox Header="View &amp; Zoom">
                    <fluent:Button Header="Zoom In" Command="{Binding Canvas.ZoomInCommand}" ToolTip="Zoom In (Ctrl++)"
                                   Size="Small"
                                   Icon="{StaticResource IconZoomIn}"/>
                    <fluent:Button Header="Zoom Out" Command="{Binding Canvas.ZoomOutCommand}" ToolTip="Zoom Out (Ctrl+-)"
                                   Size="Small"
                                   Icon="{StaticResource IconZoomOut}"/>
                    <fluent:Button Header="100%" Command="{Binding Canvas.ResetZoomCommand}" ToolTip="Reset Zoom (Ctrl+0)"
                                   Size="Small"
                                   Icon="{StaticResource IconResetZoom}"/>
                    <fluent:Button Header="Fit Page" Command="{Binding Canvas.FitToPageCommand}" ToolTip="Fit Page"
                                   Size="Small"
                                   Icon="{StaticResource IconFitPage}"/>
                </fluent:RibbonGroupBox>

                <!-- Theme / Appearance -->
                <fluent:RibbonGroupBox Header="Theme">
                    <fluent:ToggleButton Header="Dark Theme"
                                         IsChecked="{Binding ElementName=BtnDarkTheme, Path=IsChecked}"
                                         Click="ThemeToggle_Click"
                                         ToolTip="Toggle Light / Dark Theme (F8)"
                                         Size="Middle"
                                         Icon="{StaticResource IconThemeDark}"/>
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>

            <!-- 3. Arrange Tab (Grouping, Alignment & Layers) -->
            <fluent:RibbonTabItem Header="Arrange">
                <!-- Grouping & Hierarchy -->
                <fluent:RibbonGroupBox Header="Grouping">
                    <fluent:Button Header="Group" Command="{Binding Canvas.GroupSelectedCommand}"
                                   ToolTip="Group selected items (Ctrl+G)"
                                   Size="Middle"
                                   Icon="{StaticResource IconGroup}"/>
                    <fluent:Button Header="Ungroup" Command="{Binding Canvas.UngroupSelectedCommand}"
                                   ToolTip="Ungroup selected items (Ctrl+Shift+G)"
                                   Size="Middle"
                                   Icon="{StaticResource IconUngroup}"/>
                </fluent:RibbonGroupBox>

                <!-- Align & Distribute -->
                <fluent:RibbonGroupBox Header="Alignment">
                    <fluent:Button Header="Align Left" Command="{Binding Canvas.AlignLeftCommand}"
                                   Size="Small"
                                   Icon="{StaticResource IconAlignLeft}"/>
                    <fluent:Button Header="Align Center" Command="{Binding Canvas.AlignCenterCommand}"
                                   Size="Small"
                                   Icon="{StaticResource IconAlignCenter}"/>
                    <fluent:Button Header="Align Right" Command="{Binding Canvas.AlignRightCommand}"
                                   Size="Small"
                                   Icon="{StaticResource IconAlignRight}"/>
                    <fluent:Button Header="Align Top" Command="{Binding Canvas.AlignTopCommand}"
                                   Size="Small"
                                   Icon="{StaticResource IconAlignTop}"/>
                    <fluent:Button Header="Align Middle" Command="{Binding Canvas.AlignMiddleCommand}"
                                   Size="Small"
                                   Icon="{StaticResource IconAlignMiddle}"/>
                    <fluent:Button Header="Align Bottom" Command="{Binding Canvas.AlignBottomCommand}"
                                   Size="Small"
                                   Icon="{StaticResource IconAlignBottom}"/>
                </fluent:RibbonGroupBox>

                <!-- Layering & Arrange (Layers) -->
                <fluent:RibbonGroupBox Header="Layers">
                    <fluent:Button Header="To Front" Command="{Binding Canvas.MoveToFrontCommand}" ToolTip="Move to Front (Ctrl+Shift+] / Shift+PageUp)"
                                   Size="Small"
                                   Icon="{StaticResource IconMoveToFront}"/>
                    <fluent:Button Header="Forward" Command="{Binding Canvas.MoveForwardCommand}" ToolTip="Move Forward (Ctrl+] / PageUp)"
                                   Size="Small"
                                   Icon="{StaticResource IconMoveForward}"/>
                    <fluent:Button Header="Backward" Command="{Binding Canvas.SendBackwardCommand}" ToolTip="Send Backward (Ctrl+[ / PageDown)"
                                   Size="Small"
                                   Icon="{StaticResource IconSendBackward}"/>
                    <fluent:Button Header="To Back" Command="{Binding Canvas.SendToBackCommand}" ToolTip="Send to Back (Ctrl+Shift+[ / Shift+PageDown)"
                                   Size="Small"
                                   Icon="{StaticResource IconSendToBack}"/>
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>

            <!-- 2. Database Tab -->
            <fluent:RibbonTabItem Header="Database">
                <fluent:RibbonGroupBox Header="Inventory Database">
                    <fluent:Button Header="Connect Database..." Click="DatabaseConnect_Click"
                                   Size="Large"
                                   Icon="{StaticResource IconDatabase}" LargeIcon="{StaticResource IconDatabase}"/>
                    <fluent:Button Header="Sync Inventory" Click="SyncInventory_Click"
                                   Size="Large"
                                   Icon="{StaticResource IconSync}" LargeIcon="{StaticResource IconSync}"/>
                </fluent:RibbonGroupBox>
                <fluent:RibbonGroupBox Header="IP &amp; Workstations">
                    <fluent:Button Header="Batch Assign IPs..." Click="BatchAssignIps_Click"
                                   Size="Large"
                                   Icon="{StaticResource IconSettings}" LargeIcon="{StaticResource IconSettings}"/>
                    <fluent:Button Header="Auto-Assign Available" Click="AutoAssignAllIps_Click"
                                   Size="Small"
                                   Icon="{StaticResource IconCheckmark}"/>
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>

            <!-- 3. Export & Web Tab -->
            <fluent:RibbonTabItem Header="Export &amp; Web">
                <fluent:RibbonGroupBox Header="Web &amp; Document Interchange">
                    <fluent:Button Header="Open in Web Viewer" Click="PreviewWebViewer_Click" ToolTip="Launch standalone HTML5 2D Canvas viewer in browser"
                                   Size="Large"
                                   Icon="{StaticResource IconWebViewer}" LargeIcon="{StaticResource IconWebViewer}"/>
                    <fluent:Button Header="Save JSON" Click="SaveJson_Click" ToolTip="Save current layout to JSON (Ctrl+S)"
                                   Size="Small"
                                   Icon="{StaticResource IconSave}"/>
                    <fluent:Button Header="Save As JSON..." Click="SaveAsJson_Click" ToolTip="Save current layout to new JSON file (Ctrl+Shift+S)"
                                   Size="Small"
                                   Icon="{StaticResource IconSaveAs}"/>
                    <fluent:Button Header="Open JSON..." Click="OpenJson_Click" ToolTip="Open existing JSON file into tab (Ctrl+O)"
                                   Size="Small"
                                   Icon="{StaticResource IconOpen}"/>
                    <fluent:Button Header="Import into Canvas" Click="ImportIntoActive_Click" ToolTip="Import and merge items from JSON into active canvas"
                                   Size="Small"
                                   Icon="{StaticResource IconImport}"/>
                    <fluent:Button Header="Export JSON..." Click="ExportJson_Click" ToolTip="Validate and export JSON for web"
                                   Size="Small"
                                   Icon="{StaticResource IconExport}"/>
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>
        </fluent:Ribbon>

        <!-- ==================================================== -->
        <!-- 2. AVALONDOCK WORKSPACE (Left, Center, Right)         -->
        <!-- ==================================================== -->
        <dock:DockingManager Grid.Row="1" x:Name="DockManager"
                             Background="{DynamicResource AppBackgroundBrush}"
                             AnchorableHeaderTemplate="{StaticResource AvalonDockAnchorableHeaderTemplate}"
                             AnchorableTitleTemplate="{StaticResource AvalonDockAnchorableTitleTemplate}"
                             AnchorablePaneControlStyle="{StaticResource AnchorablePaneControlStyle}">
            <dock:LayoutRoot>
                <dock:LayoutPanel Orientation="Horizontal">

                    <!-- Left: Stencils & Room Templates Dockable Anchorables (Neighbors) -->
                    <dock:LayoutAnchorablePane DockWidth="280">
                        <dock:LayoutAnchorable x:Name="StencilsAnchorable" Title="Stencils Library"
                                               CanClose="False" CanHide="False"
                                               AutoHideWidth="280" AutoHideMinWidth="220" CanDockAsTabbedDocument="False"
                                               IconSource="{StaticResource IconStencils}">
                            <views:StencilsPaletteView x:Name="StencilsPaletteViewControl" DataContext="{Binding Stencils}"/>
                        </dock:LayoutAnchorable>
                        <dock:LayoutAnchorable x:Name="RoomTemplateAnchorable" Title="Room Templates"
                                               CanClose="False" CanHide="False"
                                               AutoHideWidth="280" AutoHideMinWidth="220" CanDockAsTabbedDocument="False"
                                               IconSource="{StaticResource IconRoomTemplate}">
                            <views:RoomTemplateView x:Name="RoomTemplateViewControl" DataContext="{Binding RoomTemplate}"/>
                        </dock:LayoutAnchorable>
                    </dock:LayoutAnchorablePane>

                    <!-- Center: Browser-Style Tabbed Document Workspace -->
                    <dock:LayoutDocumentPane ShowHeader="False">
                        <dock:LayoutDocument Title="Lab Workspace" CanClose="False" CanFloat="False">
                            <Grid Background="{DynamicResource CanvasWorkspaceBackgroundBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Browser Tab Bar Strip -->
                                <Grid Grid.Row="0" Background="{DynamicResource TabBarBackgroundBrush}">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <ItemsControl ItemsSource="{Binding Tabs}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="2,0,2,0"
                                                                CornerRadius="7,7,0,0"
                                                                Padding="12,6,10,6"
                                                                Cursor="Hand"
                                                                ContextMenu="{StaticResource TabContextMenu}"
                                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=fluent:RibbonWindow}}"
                                                                MouseDown="TabItem_MouseDown">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource TabInactiveBackgroundBrush}"/>
                                                                    <Setter Property="BorderThickness" Value="1,1,1,0"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource TabInactiveBorderBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource TabActiveBackgroundBrush}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource TabActiveBorderBrush}"/>
                                                                            <Setter Property="BorderThickness" Value="1,2.5,1,0"/>
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource TabHoverBackgroundBrush}"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <!-- Tab Icon -->
                                                                <Image Source="{StaticResource IconNewTab}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                                                <!-- Tab Title -->
                                                                <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TabTextInactiveBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource TabTextActiveBrush}"/>
                                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <!-- Modified Asterisk Indicator -->
                                                                <TextBlock Text=" *" Foreground="{DynamicResource StatusWarningBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
                                                                           Visibility="{Binding IsModified, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                                                <!-- Close Tab Button -->
                                                                <Button Margin="8,0,0,0" Width="18" Height="18"
                                                                        Content="✕" FontSize="9" FontWeight="Bold"
                                                                        Background="Transparent" BorderThickness="0"
                                                                        Foreground="{DynamicResource TabTextInactiveBrush}"
                                                                        Cursor="Hand"
                                                                        Click="TabClose_Click"
                                                                        ToolTip="Close tab (Ctrl+W)">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="9">
                                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}"/>
                                                                                    <Setter Property="Background" Value="{DynamicResource TabCloseHoverBackgroundBrush}"/>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Add New Tab Button (+) -->
                                            <Button Width="28" Height="28" Margin="4,0,4,2"
                                                    Content="+" FontSize="16" FontWeight="Bold"
                                                    Background="{DynamicResource TabAddButtonBackgroundBrush}" Foreground="{DynamicResource TabTextInactiveBrush}"
                                                    BorderBrush="{DynamicResource TabInactiveBorderBrush}" BorderThickness="1"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Bottom"
                                                    Command="{Binding NewTabCommand}"
                                                    ToolTip="New Tab (Ctrl+N)">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="6">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource TabTextActiveBrush}"/>
                                                                <Setter Property="Background" Value="{DynamicResource TabHoverBackgroundBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource TabActiveBorderBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>

                                <!-- Active Tab Canvas Viewport -->
                                <views:CanvasView Grid.Row="1" DataContext="{Binding ActiveTab.Canvas}"/>
                            </Grid>
                        </dock:LayoutDocument>
                    </dock:LayoutDocumentPane>

                    <!-- Right: Properties Inspector & Layers Panel -->
                    <dock:LayoutAnchorablePane DockWidth="280">
                        <dock:LayoutAnchorable x:Name="PropertiesAnchorable" Title="Properties &amp; Inspector"
                                               CanClose="False" CanHide="False"
                                               AutoHideWidth="280" AutoHideMinWidth="220" CanDockAsTabbedDocument="False"
                                               IconSource="{StaticResource IconInspect}">
                            <views:PropertiesInspectorView x:Name="PropertiesInspectorViewControl" DataContext="{Binding Properties}"/>
                        </dock:LayoutAnchorable>
                        <dock:LayoutAnchorable x:Name="LayersAnchorable" Title="Layers"
                                               CanClose="True" CanHide="True"
                                               AutoHideWidth="280" AutoHideMinWidth="220" CanDockAsTabbedDocument="False"
                                               IconSource="{StaticResource IconLayers}">
                            <views:LayersView x:Name="LayersViewControl" DataContext="{Binding Layers}"/>
                        </dock:LayoutAnchorable>
                    </dock:LayoutAnchorablePane>

                </dock:LayoutPanel>
            </dock:LayoutRoot>
        </dock:DockingManager>

        <!-- ==================================================== -->
        <!-- 3. STATUS BAR                                        -->
        <!-- ==================================================== -->
        <StatusBar Grid.Row="2" Background="{DynamicResource StatusBarBackgroundBrush}" BorderBrush="{DynamicResource StatusBarBorderBrush}" BorderThickness="0,1,0,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- 1. Database Connection Status -->
            <StatusBarItem Grid.Column="0" MouseLeftButtonUp="DatabaseConnect_Click" Cursor="Hand" ToolTip="Click to configure PostgreSQL connection">
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="8,2" Margin="6,0,4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource AppTextMutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDatabaseConnected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource StatusSuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding DatabaseStatusText}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource StatusBarForegroundBrush}"/>
                    </StackPanel>
                </Border>
            </StatusBarItem>

            <!-- 2. Active Tab & Document Info -->
            <StatusBarItem Grid.Column="1">
                <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                    <Path Data="M 2 1 H 7 L 10 4 V 11 A 1 1 0 0 1 9 12 H 3 A 1 1 0 0 1 2 11 Z M 7 1 V 4 H 10" 
                          Stroke="{DynamicResource AppTextMutedBrush}" StrokeThickness="1" Fill="Transparent" Width="10" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ActiveTab.Title, StringFormat='Active: {0}'}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource StatusBarForegroundBrush}"/>
                    <Border Width="1" Height="10" Background="{DynamicResource AppBorderBrush}" Margin="8,0"/>
                    <TextBlock Text="{Binding Canvas.PageSizeDisplayText}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" ToolTip="Page size preset, orientation and pixel dimensions"/>
                </StackPanel>
            </StatusBarItem>

            <!-- 3. Validation Warnings Counter (Unassigned PCs) -->
            <StatusBarItem Grid.Column="2" Visibility="{Binding ValidationWarningCount, Converter={StaticResource IntToVisibilityConverter}}">
                <Border Background="{DynamicResource StatusWarningBackgroundBrush}" BorderBrush="{DynamicResource StatusWarningBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="8,2" Margin="4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 5 0 L 10 9 H 0 Z M 5 3 V 6 M 5 7.5 V 8" Stroke="{DynamicResource StatusWarningForegroundBrush}" StrokeThickness="1" Width="10" Height="9" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ValidationWarningCount, StringFormat='{}{0} Unassigned PC(s)'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusWarningForegroundBrush}"/>
                    </StackPanel>
                </Border>
            </StatusBarItem>

            <!-- 4. Validation Errors Counter (Duplicate IP Conflicts) -->
            <StatusBarItem Grid.Column="3" Visibility="{Binding ValidationErrorCount, Converter={StaticResource IntToVisibilityConverter}}">
                <Border Background="{DynamicResource StatusErrorBackgroundBrush}" BorderBrush="{DynamicResource StatusErrorBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="8,2" Margin="4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 1 5 H 9 M 5 1 A 4 4 0 1 1 4.99 1" Stroke="{DynamicResource StatusErrorForegroundBrush}" StrokeThickness="1.2" Width="9" Height="9" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ValidationErrorCount, StringFormat='{}{0} IP Conflict(s)'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource StatusErrorForegroundBrush}"/>
                    </StackPanel>
                </Border>
            </StatusBarItem>

            <!-- 5. GPU Hardware Acceleration Indicator -->
            <StatusBarItem Grid.Column="4">
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="8,2" Margin="4,0" ToolTip="{Binding GpuStatusTooltip}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 5 0 L 1 6 H 5 L 4 11 L 9 4.5 H 5 Z" Fill="{DynamicResource StatusSuccessBrush}" Width="9" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding GpuStatusText}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource StatusBarForegroundBrush}"/>
                    </StackPanel>
                </Border>
            </StatusBarItem>

            <!-- 6. Zoom & Coordinates -->
            <StatusBarItem Grid.Column="5">
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="8,2" Margin="4,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 4 1 A 3 3 0 1 0 4 7 A 3 3 0 0 0 4 1 M 6 6 L 9 9" Stroke="{DynamicResource StatusBarForegroundBrush}" StrokeThickness="1.2" Width="9" Height="9" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Canvas.ZoomLevel, StringFormat='{}{0:P0}'}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource StatusBarForegroundBrush}" Margin="0,0,10,0" FontFamily="Consolas, Segoe UI"/>
                        <TextBlock Text="{Binding Canvas.CursorX, StringFormat='X: {0:F0}'}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,6,0" FontFamily="Consolas, Segoe UI"/>
                        <TextBlock Text="{Binding Canvas.CursorY, StringFormat='Y: {0:F0}'}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" FontFamily="Consolas, Segoe UI"/>
                    </StackPanel>
                </Border>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</fluent:RibbonWindow>
