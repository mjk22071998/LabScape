    <!-- 22. Reset Zoom (100% / Fit) -->
    <DrawingImage x:Key="IconResetZoom">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 4 Corner Brackets -->
                <GeometryDrawing Geometry="M 3 8 V 3 H 8 M 16 3 H 21 V 8 M 21 16 V 21 H 16 M 8 21 H 3 V 16">
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Center Target Reticle -->
                <GeometryDrawing Geometry="M 12 9 V 15 M 9 12 H 15">
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 12 7 V 8 M 12 16 V 17 M 7 12 H 8 M 16 12 H 17">
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.4" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 23. Group Selected -->
    <DrawingImage x:Key="IconGroup">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Outer Bounding Frame with Corner Nodes -->
                <GeometryDrawing Geometry="M 3 7 V 3 H 7 M 17 3 H 21 V 7 M 21 17 V 21 H 17 M 7 21 H 3 V 17">
                    <GeometryDrawing.Pen><Pen Brush="#4F46E5" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Grouped Objects -->
                <GeometryDrawing Geometry="M 6 8 H 11 V 16 H 6 Z M 13 8 H 18 V 16 H 13 Z">
                    <GeometryDrawing.Brush><SolidColorBrush Color="#124F46E5"/></GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#4F46E5" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 24. Ungroup -->
    <DrawingImage x:Key="IconUngroup">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Separated Elements -->
                <GeometryDrawing Geometry="M 4 4 H 8 V 8 H 4 Z M 16 4 H 20 V 8 H 16 Z M 4 16 H 8 V 20 H 4 Z M 16 16 H 20 V 20 H 16 Z">
                    <GeometryDrawing.Brush><SolidColorBrush Color="#0A64748B"/></GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#64748B" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Expansion Guides -->
                <GeometryDrawing Geometry="M 8 6 H 16 M 8 18 H 16 M 6 8 V 16 M 18 8 V 16">
                    <GeometryDrawing.Pen><Pen Brush="#94A3B8" Thickness="1.2" DashStyle="{x:Static DashStyles.Dash}"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 25. Layers Stack / Reorder -->
    <DrawingImage x:Key="IconLayers">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Top Active Layer with Blueprint Accent -->
                <GeometryDrawing Geometry="M 12 2 L 2 7 L 12 12 L 22 7 Z">
                    <GeometryDrawing.Brush><SolidColorBrush Color="#1E0284C7"/></GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Middle Layer -->
                <GeometryDrawing Geometry="M 2 12 L 12 17 L 22 12">
                    <GeometryDrawing.Pen><Pen Brush="#64748B" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Base Layer -->
                <GeometryDrawing Geometry="M 2 17 L 12 22 L 22 17">
                    <GeometryDrawing.Pen><Pen Brush="#94A3B8" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 26. Move to Front -->
    <DrawingImage x:Key="IconMoveToFront">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Base Layer -->
                <GeometryDrawing Geometry="M 2 18 L 12 23 L 22 18 M 2 13 L 12 18 L 22 13">
                    <GeometryDrawing.Pen><Pen Brush="#94A3B8" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Elevated Top Layer -->
                <GeometryDrawing Geometry="M 12 6 L 2 11 L 12 16 L 22 11 Z">
                    <GeometryDrawing.Brush><SolidColorBrush Color="#1E0284C7"/></GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Upward Arrow to Summit -->
                <GeometryDrawing Geometry="M 12 1 L 9 4 M 12 1 L 15 4 M 12 1 V 10">
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 27. Move Forward -->
    <DrawingImage x:Key="IconMoveForward">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Lower Layer -->
                <GeometryDrawing Geometry="M 2 16 L 12 21 L 22 16">
                    <GeometryDrawing.Pen><Pen Brush="#94A3B8" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Active Layer -->
