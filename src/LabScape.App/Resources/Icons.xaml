<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- LABSCAPE PRECISION CAD VECTOR DRAWINGIMAGE ICON DICTIONARY                 -->
    <!-- Scalable 24x24 vector assets with balanced 1.6px strokes & duotone depth    -->
    <!-- ========================================================================= -->

    <!-- Primary Stroke Color Brushes -->
    <SolidColorBrush x:Key="IconStrokeBrand" Color="#0284C7"/>
    <SolidColorBrush x:Key="IconStrokeSlate" Color="#475569"/>
    <SolidColorBrush x:Key="IconStrokeRed" Color="#E11D48"/>
    <SolidColorBrush x:Key="IconStrokeGreen" Color="#059669"/>
    <SolidColorBrush x:Key="IconStrokeEmerald" Color="#0D9488"/>
    <SolidColorBrush x:Key="IconStrokeAmber" Color="#D97706"/>
    <SolidColorBrush x:Key="IconStrokePurple" Color="#6366F1"/>
    <SolidColorBrush x:Key="IconStrokeIndigo" Color="#4F46E5"/>
    <SolidColorBrush x:Key="IconStrokeCyan" Color="#0284C7"/>
    <SolidColorBrush x:Key="IconStrokeSky" Color="#0284C7"/>

    <!-- Subtle Fill Accents for Depth (Duotone) -->
    <SolidColorBrush x:Key="IconFillBrandSubtle" Color="#180284C7"/>
    <SolidColorBrush x:Key="IconFillSlateSubtle" Color="#12475569"/>
    <SolidColorBrush x:Key="IconFillAmberSubtle" Color="#18D97706"/>
    <SolidColorBrush x:Key="IconFillGreenSubtle" Color="#18059669"/>
    <SolidColorBrush x:Key="IconFillRedSubtle" Color="#18E11D48"/>

    <!-- 1. New Tab / New Floorplan -->
    <DrawingImage x:Key="IconNewTab">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Sheet Outline with Fold -->
                <GeometryDrawing Geometry="M 14 2 H 6 A 2 2 0 0 0 4 4 V 20 A 2 2 0 0 0 6 22 H 18 A 2 2 0 0 0 20 20 V 8 Z">
                    <GeometryDrawing.Brush><SolidColorBrush Color="#080284C7"/></GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Fold Flap -->
                <GeometryDrawing Geometry="M 14 2 V 8 H 20">
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Precision Plus Badge -->
                <GeometryDrawing Geometry="M 12 17 V 11 M 9 14 H 15">
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.7" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 2. Close Tab -->
    <DrawingImage x:Key="IconCloseTab">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Circle boundary -->
                <GeometryDrawing Geometry="M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 0 0 12 2 Z">
                    <GeometryDrawing.Brush><SolidColorBrush Color="#0AE11D48"/></GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#E11D48" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 15 9 L 9 15 M 9 9 L 15 15">
                    <GeometryDrawing.Pen><Pen Brush="#E11D48" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 3. Close Other Tabs -->
    <DrawingImage x:Key="IconCloseOthers">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 3 6 H 15 V 18 H 3 Z M 8 3 H 20 V 15">
                    <GeometryDrawing.Pen><Pen Brush="#E11D48" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 7 10 L 11 14 M 11 10 L 7 14">
                    <GeometryDrawing.Pen><Pen Brush="#E11D48" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 4. Close All Tabs -->
    <DrawingImage x:Key="IconCloseAll">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 2 7 H 14 V 19 H 2 Z M 6 4 H 18 V 16 M 10 1 H 22 V 13">
                    <GeometryDrawing.Pen><Pen Brush="#E11D48" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 6 11 L 10 15 M 10 11 L 6 15">
                    <GeometryDrawing.Pen><Pen Brush="#E11D48" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 5. Save (Floppy Diskette) -->
    <DrawingImage x:Key="IconSave">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Diskette Body -->
                <GeometryDrawing Geometry="M 19 21 H 5 A 2 2 0 0 1 3 19 V 5 A 2 2 0 0 1 5 3 H 16 L 21 8 V 19 A 2 2 0 0 1 19 21 Z">
                    <GeometryDrawing.Brush><SolidColorBrush Color="#0A0284C7"/></GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Bottom Shutter Window -->
                <GeometryDrawing Geometry="M 17 21 V 13 H 7 V 21">
                    <GeometryDrawing.Brush><SolidColorBrush Color="#150284C7"/></GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Top Notch/Label -->
                <GeometryDrawing Geometry="M 7 3 V 8 H 15">
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Slider notch -->
                <GeometryDrawing Geometry="M 10 15 V 19">
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 6. Save As -->
    <DrawingImage x:Key="IconSaveAs">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 15 2 H 6 A 2 2 0 0 0 4 4 V 18 M 19 21 H 8 A 2 2 0 0 1 6 19 V 7 A 2 2 0 0 1 8 5 H 16 L 20 9 V 19 A 2 2 0 0 1 18 21 Z">
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 14 14 V 18 H 10 V 14">
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 7. Open JSON -->
    <DrawingImage x:Key="IconOpen">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Back Folder Folder -->
                <GeometryDrawing Geometry="M 2 8 V 4 A 2 2 0 0 1 4 2 H 9 L 11 4 H 19 A 2 2 0 0 1 21 6 V 8">
                    <GeometryDrawing.Pen><Pen Brush="#D97706" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Front Flap Angled -->
                <GeometryDrawing Geometry="M 2 17 L 4.5 8 H 20.5 L 22 17 H 2 Z">
                    <GeometryDrawing.Brush><SolidColorBrush Color="#12D97706"/></GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#D97706" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 8. Import JSON into Canvas -->
    <DrawingImage x:Key="IconImport">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Import Tray -->
                <GeometryDrawing Geometry="M 4 14 V 19 A 2 2 0 0 0 6 21 H 18 A 2 2 0 0 0 20 19 V 14">
                    <GeometryDrawing.Pen><Pen Brush="#D97706" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Arrow Down -->
                <GeometryDrawing Geometry="M 12 3 V 15 M 7 10 L 12 15 L 17 10">
                    <GeometryDrawing.Pen><Pen Brush="#D97706" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 9. Export JSON -->
    <DrawingImage x:Key="IconExport">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Export Tray -->
                <GeometryDrawing Geometry="M 4 14 V 19 A 2 2 0 0 0 6 21 H 18 A 2 2 0 0 0 20 19 V 14">
                    <GeometryDrawing.Pen><Pen Brush="#059669" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Arrow Up -->
                <GeometryDrawing Geometry="M 12 15 V 3 M 7 8 L 12 3 L 17 8">
                    <GeometryDrawing.Pen><Pen Brush="#059669" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 10. Exit Application -->
    <DrawingImage x:Key="IconExit">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 9 21 H 5 A 2 2 0 0 1 3 19 V 5 A 2 2 0 0 1 5 3 H 9">
                    <GeometryDrawing.Pen><Pen Brush="#E11D48" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 16 17 L 21 12 L 16 7 M 21 12 H 9">
                    <GeometryDrawing.Pen><Pen Brush="#E11D48" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 11. Undo -->
    <DrawingImage x:Key="IconUndo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 9 14 L 4 9 L 9 4 M 4 9 H 14.5 A 5.5 5.5 0 0 1 20 14.5 A 5.5 5.5 0 0 1 14.5 20 H 11">
                    <GeometryDrawing.Pen><Pen Brush="#475569" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 12. Redo -->
    <DrawingImage x:Key="IconRedo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 15 14 L 20 9 L 15 4 M 20 9 H 9.5 A 5.5 5.5 0 0 0 4 14.5 A 5.5 5.5 0 0 0 9.5 20 H 13">
                    <GeometryDrawing.Pen><Pen Brush="#475569" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 13. Cut -->
    <DrawingImage x:Key="IconCut">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Finger loops -->
                <GeometryDrawing Geometry="M 6 9 A 3 3 0 1 0 6 3 A 3 3 0 0 0 6 9 Z M 6 21 A 3 3 0 1 0 6 15 A 3 3 0 0 0 6 21 Z">
                    <GeometryDrawing.Pen><Pen Brush="#475569" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Crossed Blades -->
                <GeometryDrawing Geometry="M 20 4 L 8.12 15.88 M 14.47 14.48 L 20 20 M 8.12 8.12 L 12 12">
                    <GeometryDrawing.Pen><Pen Brush="#475569" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 14. Copy -->
    <DrawingImage x:Key="IconCopy">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Back Sheet -->
                <GeometryDrawing Geometry="M 8 2 H 18 A 2 2 0 0 1 20 4 V 14">
                    <GeometryDrawing.Pen><Pen Brush="#475569" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Front Sheet -->
                <GeometryDrawing Geometry="M 4 6 H 14 A 2 2 0 0 1 16 8 V 20 A 2 2 0 0 1 14 22 H 4 A 2 2 0 0 1 2 20 V 8 A 2 2 0 0 1 4 6 Z">
                    <GeometryDrawing.Brush><SolidColorBrush Color="#0A475569"/></GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#475569" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 15. Paste -->
    <DrawingImage x:Key="IconPaste">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Clipboard Frame -->
                <GeometryDrawing Geometry="M 16 4 H 18 A 2 2 0 0 1 20 6 V 20 A 2 2 0 0 1 18 22 H 6 A 2 2 0 0 1 4 20 V 6 A 2 2 0 0 1 6 4 H 8">
                    <GeometryDrawing.Brush><SolidColorBrush Color="#0A0284C7"/></GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Top Clip -->
                <GeometryDrawing Geometry="M 9 2 H 15 A 1 1 0 0 1 16 3 V 5 A 1 1 0 0 1 15 6 H 9 A 1 1 0 0 1 8 5 V 3 A 1 1 0 0 1 9 2 Z">
                    <GeometryDrawing.Brush><SolidColorBrush Color="#150284C7"/></GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Sheet Preview Lines -->
                <GeometryDrawing Geometry="M 8 12 H 16 M 8 16 H 13">
                    <GeometryDrawing.Pen><Pen Brush="#475569" Thickness="1.5" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 16. Duplicate -->
    <DrawingImage x:Key="IconDuplicate">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 8 2 H 18 A 2 2 0 0 1 20 4 V 14">
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 4 6 H 14 A 2 2 0 0 1 16 8 V 20 A 2 2 0 0 1 14 22 H 4 A 2 2 0 0 1 2 20 V 8 A 2 2 0 0 1 4 6 Z">
                    <GeometryDrawing.Brush><SolidColorBrush Color="#0A0284C7"/></GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Inner Plus -->
                <GeometryDrawing Geometry="M 9 11 V 17 M 6 14 H 12">
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 17. Delete -->
    <DrawingImage x:Key="IconDelete">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Lid -->
                <GeometryDrawing Geometry="M 3 6 H 21 M 8 6 V 3 A 1 1 0 0 1 9 2 H 15 A 1 1 0 0 1 16 3 V 6">
                    <GeometryDrawing.Pen><Pen Brush="#E11D48" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Can Body -->
                <GeometryDrawing Geometry="M 5 6 L 6.5 20 A 2 2 0 0 0 8.5 22 H 15.5 A 2 2 0 0 0 17.5 20 L 19 6">
                    <GeometryDrawing.Brush><SolidColorBrush Color="#0AE11D48"/></GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#E11D48" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Flutes -->
                <GeometryDrawing Geometry="M 10 11 V 17 M 14 11 V 17">
                    <GeometryDrawing.Pen><Pen Brush="#E11D48" Thickness="1.5" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 18. Select Cursor -->
    <DrawingImage x:Key="IconSelect">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Precision Pointer with Soft Fill -->
                <GeometryDrawing Geometry="M 3 3 L 10.07 19.97 L 12.58 12.58 L 19.97 10.07 Z">
                    <GeometryDrawing.Brush><SolidColorBrush Color="#1E0284C7"/></GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
