                <GeometryDrawing Geometry="M 12 12 L 17 17">
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 19. Select All -->
    <DrawingImage x:Key="IconSelectAll">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 3 9 V 5 A 2 2 0 0 1 5 3 H 9 M 15 3 H 19 A 2 2 0 0 1 21 5 V 9 M 21 15 V 19 A 2 2 0 0 1 19 21 H 15 M 9 21 H 5 A 2 2 0 0 1 3 19 V 15">
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 9 9 H 15 V 15 H 9 Z">
                    <GeometryDrawing.Brush><SolidColorBrush Color="#150284C7"/></GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 20. Zoom In -->
    <DrawingImage x:Key="IconZoomIn">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 11 19 A 8 8 0 1 0 11 3 A 8 8 0 0 0 11 19 Z M 21 21 L 16.65 16.65">
                    <GeometryDrawing.Brush><SolidColorBrush Color="#080284C7"/></GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 11 8 V 14 M 8 11 H 14">
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 21. Zoom Out -->
    <DrawingImage x:Key="IconZoomOut">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 11 19 A 8 8 0 1 0 11 3 A 8 8 0 0 0 11 19 Z M 21 21 L 16.65 16.65">
                    <GeometryDrawing.Brush><SolidColorBrush Color="#080284C7"/></GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 8 11 H 14">
                    <GeometryDrawing.Pen><Pen Brush="#0284C7" Thickness="1.6" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
