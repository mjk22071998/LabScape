<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- App / Window Surfaces (Architectural Studio Palette - Hallmark Vellum Elevation) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="AppBorderSubtleBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#475569"/>
    <SolidColorBrush x:Key="AppTextMutedBrush" Color="#64748B"/>

    <!-- Technical Drafting Accent (Blueprint Cyan / Precision Blue) -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0369A1"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#075985"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#F0F9FF"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#BAE6FD"/>
    <Color x:Key="AccentGlowColor">#300284C7</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="#0284C7"/>

    <!-- Semantic Status Indicators & Badges (Hallmark Light Elevation) -->
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#EF4444"/>

    <SolidColorBrush x:Key="StatusSuccessBackgroundBrush" Color="#ECFDF5"/>
    <SolidColorBrush x:Key="StatusSuccessBorderBrush" Color="#A7F3D0"/>
    <SolidColorBrush x:Key="StatusSuccessForegroundBrush" Color="#065F46"/>

    <SolidColorBrush x:Key="StatusWarningBackgroundBrush" Color="#FFFBEB"/>
    <SolidColorBrush x:Key="StatusWarningBorderBrush" Color="#FDE68A"/>
    <SolidColorBrush x:Key="StatusWarningForegroundBrush" Color="#92400E"/>

    <SolidColorBrush x:Key="StatusErrorBackgroundBrush" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="StatusErrorBorderBrush" Color="#FECACA"/>
    <SolidColorBrush x:Key="StatusErrorForegroundBrush" Color="#991B1B"/>

    <!-- Panels (Palette & Inspector) -->
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="PanelHeaderBackgroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="PanelHeaderForegroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="CardBorderHoverBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#E2E8F0"/>

    <!-- Input Controls -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#0284C7"/>

    <!-- Section Banners -->
    <SolidColorBrush x:Key="SectionHeaderBackgroundBrush" Color="#F0F9FF"/>
    <SolidColorBrush x:Key="SectionHeaderBorderBrush" Color="#BAE6FD"/>
    <SolidColorBrush x:Key="SectionHeaderForegroundBrush" Color="#0369A1"/>
    <SolidColorBrush x:Key="SectionHeaderSubForegroundBrush" Color="#0284C7"/>

    <!-- Browser Tab Strip (Architectural Vellum Tabs) -->
    <SolidColorBrush x:Key="TabBarBackgroundBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabInactiveBackgroundBrush" Color="#EDF2F7"/>
    <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TabActiveBorderBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="TabInactiveBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TabTextActiveBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TabTextInactiveBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TabCloseHoverBackgroundBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="TabAddButtonBackgroundBrush" Color="#EDF2F7"/>

    <!-- Status Bar -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#475569"/>
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#E2E8F0"/>

    <!-- Canvas Surface & Rulers (Drafting Desk & Vellum Sheet) -->
    <SolidColorBrush x:Key="CanvasWorkspaceBackgroundBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="CanvasPaperBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CanvasPaperBorderBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="CanvasGridLineBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="CanvasRulerBackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="CanvasRulerForegroundBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="CanvasRulerBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="CanvasRulerCursorBrush" Color="#EF4444"/>

    <!-- Floating HUD Viewport Toolbar -->
    <SolidColorBrush x:Key="HudBackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="HudBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="HudForegroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="HudButtonHoverBrush" Color="#E2E8F0"/>

    <!-- Minimalist Web-Style Technical Scrollbars -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="ScrollBarTrackHoverBrush" Color="#F1F5F988"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="ScrollBarThumbDraggingBrush" Color="#0284C7"/>

    <!-- Dialogs -->
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#E2E8F0"/>

</ResourceDictionary>
