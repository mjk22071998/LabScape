<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- App / Window Surfaces (Arcline Nordic Studio - Warm Paper & Travertine Elevation) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F8F6F2"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#F3EFE8"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#E5E0D5"/>
    <SolidColorBrush x:Key="AppBorderSubtleBrush" Color="#EDE9E1"/>
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#1A201E"/>
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#5C6662"/>
    <SolidColorBrush x:Key="AppTextMutedBrush" Color="#87938D"/>

    <!-- Hero Architectural Accent (Arcline Forest Spruce / Pine Green: #1A4D45) -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#1A4D45"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#235E55"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#133F38"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#EAF3F1"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#8DBAB0"/>
    <Color x:Key="AccentGlowColor">#351A4D45</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="#1A4D45"/>

    <!-- Natural Material & Semantic Status Indicators (Arcline Swatch Palette) -->
    <!-- Success: Forest Pine -->
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#1A4D45"/>
    <SolidColorBrush x:Key="StatusSuccessBackgroundBrush" Color="#EAF3F1"/>
    <SolidColorBrush x:Key="StatusSuccessBorderBrush" Color="#8DBAB0"/>
    <SolidColorBrush x:Key="StatusSuccessForegroundBrush" Color="#1A4D45"/>

    <!-- Warning / Studio Favorites: Warm Gold Ochre (#C89B3C) -->
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#C89B3C"/>
    <SolidColorBrush x:Key="StatusWarningBackgroundBrush" Color="#FDF8EE"/>
    <SolidColorBrush x:Key="StatusWarningBorderBrush" Color="#F4DEAB"/>
    <SolidColorBrush x:Key="StatusWarningForegroundBrush" Color="#8C6514"/>

    <!-- Error: Warm Terracotta / Burnt Sienna (#B85542) -->
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#B85542"/>
    <SolidColorBrush x:Key="StatusErrorBackgroundBrush" Color="#FBF1EF"/>
    <SolidColorBrush x:Key="StatusErrorBorderBrush" Color="#F2C8C0"/>
    <SolidColorBrush x:Key="StatusErrorForegroundBrush" Color="#8C2E1E"/>

    <!-- Panels (Palette & Inspector - Warm Architectural Studio Paper) -->
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FBF9F5"/>
    <SolidColorBrush x:Key="PanelHeaderBackgroundBrush" Color="#F3EFE8"/>
    <SolidColorBrush x:Key="PanelHeaderForegroundBrush" Color="#1A201E"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#F6F3EC"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E0D5"/>
    <SolidColorBrush x:Key="CardBorderHoverBrush" Color="#1A4D45"/>
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#E3DDD1"/>

    <!-- Input Controls (Soft Travertine Rounded Inputs) -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F4F1EA"/>
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#1A201E"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#DCD5C7"/>
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#B5ABA0"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#1A4D45"/>

    <!-- Section Banners -->
    <SolidColorBrush x:Key="SectionHeaderBackgroundBrush" Color="#EAF3F1"/>
    <SolidColorBrush x:Key="SectionHeaderBorderBrush" Color="#A7CEC5"/>
    <SolidColorBrush x:Key="SectionHeaderForegroundBrush" Color="#1A4D45"/>
    <SolidColorBrush x:Key="SectionHeaderSubForegroundBrush" Color="#26635A"/>

    <!-- Browser Tab Strip (Architectural Vellum Tabs) -->
    <SolidColorBrush x:Key="TabBarBackgroundBrush" Color="#ECE7DE"/>
    <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabInactiveBackgroundBrush" Color="#E2DCD1"/>
    <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#F6F3EC"/>
    <SolidColorBrush x:Key="TabActiveBorderBrush" Color="#1A4D45"/>
    <SolidColorBrush x:Key="TabInactiveBorderBrush" Color="#D1C9BB"/>
    <SolidColorBrush x:Key="TabTextActiveBrush" Color="#1A201E"/>
    <SolidColorBrush x:Key="TabTextInactiveBrush" Color="#5C6662"/>
    <SolidColorBrush x:Key="TabCloseHoverBackgroundBrush" Color="#F8E5E2"/>
    <SolidColorBrush x:Key="TabAddButtonBackgroundBrush" Color="#E2DCD1"/>

    <!-- Status Bar -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#F3EFE8"/>
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#5C6662"/>
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#E5E0D5"/>

    <!-- Canvas Surface & Rulers (Drafting Desk & Architectural Vellum Sheet) -->
    <SolidColorBrush x:Key="CanvasWorkspaceBackgroundBrush" Color="#E9E4D9"/>
    <SolidColorBrush x:Key="CanvasPaperBackgroundBrush" Color="#FAF8F4"/>
    <SolidColorBrush x:Key="CanvasPaperBorderBrush" Color="#C8C0B1"/>
    <SolidColorBrush x:Key="CanvasGridLineBrush" Color="#E8E2D5"/>
    <SolidColorBrush x:Key="CanvasRulerBackgroundBrush" Color="#F3EFE8"/>
    <SolidColorBrush x:Key="CanvasRulerForegroundBrush" Color="#77837E"/>
    <SolidColorBrush x:Key="CanvasRulerBorderBrush" Color="#D7D0C2"/>
    <SolidColorBrush x:Key="CanvasRulerCursorBrush" Color="#B86851"/>

    <!-- Floating HUD Viewport Toolbar -->
    <SolidColorBrush x:Key="HudBackgroundBrush" Color="#FBF9F5F0"/>
    <SolidColorBrush x:Key="HudBorderBrush" Color="#DCD5C8"/>
    <SolidColorBrush x:Key="HudForegroundBrush" Color="#1A201E"/>
    <SolidColorBrush x:Key="HudButtonHoverBrush" Color="#EDE7DC"/>

    <!-- Minimalist Web-Style Technical Scrollbars -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="ScrollBarTrackHoverBrush" Color="#E8E2D588"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#D5CDC0"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#B3A999"/>
    <SolidColorBrush x:Key="ScrollBarThumbDraggingBrush" Color="#1A4D45"/>

    <!-- Dialogs -->
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#F8F6F2"/>
    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#E5E0D5"/>

    <!-- Fluent.Ribbon Overrides for Crisp Light Mode -->
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonWindow.TitleForeground" Color="#1A201E"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonTabItem.Foreground" Color="#343E3A"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonTabItem.Selected.Foreground" Color="#1A4D45"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonTabItem.MouseOver.Foreground" Color="#133F38"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.LabelText" Color="#2A3530"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonGroupBox.Header.Foreground" Color="#66726D"/>

</ResourceDictionary>