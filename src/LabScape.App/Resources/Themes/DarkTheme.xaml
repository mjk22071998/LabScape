<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- App / Window Surfaces (Deep Slate & Midnight Palette) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0F19"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#111827"/>
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="AppBorderSubtleBrush" Color="#161F30"/>
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="AppTextMutedBrush" Color="#64748B"/>

    <!-- Brand & Accent Colors (Indigo / Violet) -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4338CA"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1E1B4B"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#4338CA"/>
    <Color x:Key="AccentGlowColor">#406366F1</Color>

    <!-- Panels (Palette & Inspector) -->
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#0E1526"/>
    <SolidColorBrush x:Key="PanelHeaderBackgroundBrush" Color="#161F30"/>
    <SolidColorBrush x:Key="PanelHeaderForegroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#161F30"/>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#26354A"/>
    <SolidColorBrush x:Key="CardBorderHoverBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#26354A"/>

    <!-- Input Controls -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#475569"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#6366F1"/>

    <!-- Section Banners -->
    <SolidColorBrush x:Key="SectionHeaderBackgroundBrush" Color="#1E1B4B"/>
    <SolidColorBrush x:Key="SectionHeaderBorderBrush" Color="#3730A3"/>
    <SolidColorBrush x:Key="SectionHeaderForegroundBrush" Color="#A5B4FC"/>
    <SolidColorBrush x:Key="SectionHeaderSubForegroundBrush" Color="#C7D2FE"/>

    <!-- Browser Tab Strip -->
    <SolidColorBrush x:Key="TabBarBackgroundBrush" Color="#080C14"/>
    <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="#161F30"/>
    <SolidColorBrush x:Key="TabInactiveBackgroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#1A2438"/>
    <SolidColorBrush x:Key="TabActiveBorderBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="TabInactiveBorderBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="TabTextActiveBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TabTextInactiveBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TabCloseHoverBackgroundBrush" Color="#451A1A"/>
    <SolidColorBrush x:Key="TabAddButtonBackgroundBrush" Color="#0F172A"/>

    <!-- Status Bar -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#080C14"/>
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#1F2937"/>

    <!-- Canvas Surface & Rulers -->
    <SolidColorBrush x:Key="CanvasWorkspaceBackgroundBrush" Color="#080C14"/>
    <SolidColorBrush x:Key="CanvasPaperBackgroundBrush" Color="#111827"/>
    <SolidColorBrush x:Key="CanvasPaperBorderBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="CanvasGridLineBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="CanvasRulerBackgroundBrush" Color="#0B0F19"/>
    <SolidColorBrush x:Key="CanvasRulerForegroundBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="CanvasRulerBorderBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="CanvasRulerCursorBrush" Color="#F87171"/>

    <!-- Floating HUD Viewport Toolbar -->
    <SolidColorBrush x:Key="HudBackgroundBrush" Color="#161F30"/>
    <SolidColorBrush x:Key="HudBorderBrush" Color="#26354A"/>
    <SolidColorBrush x:Key="HudForegroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="HudButtonHoverBrush" Color="#26354A"/>

    <!-- Scrollbars -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#334155"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#475569"/>

    <!-- Dialogs -->
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#0B0F19"/>
    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#111827"/>
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#1F2937"/>

</ResourceDictionary>
