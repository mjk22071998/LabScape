<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- App / Window Surfaces (Obsidian & Deep Blueprint Palette - Hallmark Elevation Ladder) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0F17"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#111827"/>
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#182234"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#28354A"/>
    <SolidColorBrush x:Key="AppBorderSubtleBrush" Color="#1A2436"/>
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="AppTextMutedBrush" Color="#64748B"/>

    <!-- Technical Drafting Accent (Blueprint Cyan / Precision Electric Blue) -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0369A1"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#0C253B"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#0369A1"/>
    <Color x:Key="AccentGlowColor">#4038BDF8</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="#0284C7"/>

    <!-- Semantic Status Indicators & Badges (Hallmark Dark Elevation) -->
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#F87171"/>

    <SolidColorBrush x:Key="StatusSuccessBackgroundBrush" Color="#0B2317"/>
    <SolidColorBrush x:Key="StatusSuccessBorderBrush" Color="#059669"/>
    <SolidColorBrush x:Key="StatusSuccessForegroundBrush" Color="#34D399"/>

    <SolidColorBrush x:Key="StatusWarningBackgroundBrush" Color="#2A1B07"/>
    <SolidColorBrush x:Key="StatusWarningBorderBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="StatusWarningForegroundBrush" Color="#FBBF24"/>

    <SolidColorBrush x:Key="StatusErrorBackgroundBrush" Color="#2D1111"/>
    <SolidColorBrush x:Key="StatusErrorBorderBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="StatusErrorForegroundBrush" Color="#F87171"/>

    <!-- Panels (Palette & Inspector - Elevated Paper Tier 2 & 3) -->
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#0E1524"/>
    <SolidColorBrush x:Key="PanelHeaderBackgroundBrush" Color="#141E32"/>
    <SolidColorBrush x:Key="PanelHeaderForegroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#162238"/>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#1E2D4A"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#283B5C"/>
    <SolidColorBrush x:Key="CardBorderHoverBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#233556"/>

    <!-- Input Controls -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#10192A"/>
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#253856"/>
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#385482"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#38BDF8"/>

    <!-- Section Banners -->
    <SolidColorBrush x:Key="SectionHeaderBackgroundBrush" Color="#0C253B"/>
    <SolidColorBrush x:Key="SectionHeaderBorderBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="SectionHeaderForegroundBrush" Color="#7DD3FC"/>
    <SolidColorBrush x:Key="SectionHeaderSubForegroundBrush" Color="#BAE6FD"/>

    <!-- Browser Tab Strip (Blueprint Terminal Tabs) -->
    <SolidColorBrush x:Key="TabBarBackgroundBrush" Color="#080C14"/>
    <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="#162238"/>
    <SolidColorBrush x:Key="TabInactiveBackgroundBrush" Color="#0D1422"/>
    <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#1A2740"/>
    <SolidColorBrush x:Key="TabActiveBorderBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="TabInactiveBorderBrush" Color="#1A2840"/>
    <SolidColorBrush x:Key="TabTextActiveBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TabTextInactiveBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TabCloseHoverBackgroundBrush" Color="#451A1A"/>
    <SolidColorBrush x:Key="TabAddButtonBackgroundBrush" Color="#0E1524"/>

    <!-- Status Bar -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#080C14"/>
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#1A2840"/>

    <!-- Canvas Surface & Rulers (Infinite Dark Drafting Table & Blueprint Sheet) -->
    <SolidColorBrush x:Key="CanvasWorkspaceBackgroundBrush" Color="#080C14"/>
    <SolidColorBrush x:Key="CanvasPaperBackgroundBrush" Color="#0F1728"/>
    <SolidColorBrush x:Key="CanvasPaperBorderBrush" Color="#253856"/>
    <SolidColorBrush x:Key="CanvasGridLineBrush" Color="#18253E"/>
    <SolidColorBrush x:Key="CanvasRulerBackgroundBrush" Color="#0B101B"/>
    <SolidColorBrush x:Key="CanvasRulerForegroundBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="CanvasRulerBorderBrush" Color="#1E2E4A"/>
    <SolidColorBrush x:Key="CanvasRulerCursorBrush" Color="#38BDF8"/>

    <!-- Floating HUD Viewport Toolbar -->
    <SolidColorBrush x:Key="HudBackgroundBrush" Color="#162238EE"/>
    <SolidColorBrush x:Key="HudBorderBrush" Color="#283B5C"/>
    <SolidColorBrush x:Key="HudForegroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="HudButtonHoverBrush" Color="#233556"/>

    <!-- Minimalist Web-Style Technical Scrollbars -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="ScrollBarTrackHoverBrush" Color="#141E3255"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#2B3F63"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#425E91"/>
    <SolidColorBrush x:Key="ScrollBarThumbDraggingBrush" Color="#38BDF8"/>

    <!-- Dialogs -->
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#0B0F17"/>
    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#111827"/>
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#28354A"/>

</ResourceDictionary>
