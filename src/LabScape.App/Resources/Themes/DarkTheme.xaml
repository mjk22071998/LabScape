<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- App / Window Surfaces (Arcline Nordic Nocturne - Warm Obsidian & Basalt Elevation) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F1413"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#151B19"/>
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#1B2320"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#26322E"/>
    <SolidColorBrush x:Key="AppBorderSubtleBrush" Color="#1C2623"/>
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#F0F3EF"/>
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#9EABA4"/>
    <SolidColorBrush x:Key="AppTextMutedBrush" Color="#6C7973"/>

    <!-- Hero Architectural Accent in Dark Mode (Luminous Nordic Mint Sage: #34D399) -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#28B884"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E8E65"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#122822"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#1B5446"/>
    <Color x:Key="AccentGlowColor">#4034D399</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="#34D399"/>

    <!-- Semantic Status Indicators & Badges (Arcline Nocturne Elevation) -->
    <!-- Success: Nordic Mint -->
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="StatusSuccessBackgroundBrush" Color="#0B241C"/>
    <SolidColorBrush x:Key="StatusSuccessBorderBrush" Color="#14533F"/>
    <SolidColorBrush x:Key="StatusSuccessForegroundBrush" Color="#34D399"/>

    <!-- Warning: Warm Amber Ochre -->
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="StatusWarningBackgroundBrush" Color="#261C09"/>
    <SolidColorBrush x:Key="StatusWarningBorderBrush" Color="#784D0E"/>
    <SolidColorBrush x:Key="StatusWarningForegroundBrush" Color="#FBBF24"/>

    <!-- Error: Warm Terracotta Coral -->
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="StatusErrorBackgroundBrush" Color="#2A1212"/>
    <SolidColorBrush x:Key="StatusErrorBorderBrush" Color="#7F1D1D"/>
    <SolidColorBrush x:Key="StatusErrorForegroundBrush" Color="#F87171"/>

    <!-- Panels (Palette & Inspector - Elevated Warm Basalt Tier 2 & 3) -->
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#121816"/>
    <SolidColorBrush x:Key="PanelHeaderBackgroundBrush" Color="#18211E"/>
    <SolidColorBrush x:Key="PanelHeaderForegroundBrush" Color="#F0F3EF"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#18211E"/>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#202B27"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#283631"/>
    <SolidColorBrush x:Key="CardBorderHoverBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#25332E"/>

    <!-- Input Controls (Deep Basalt Rounded Inputs) -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#131A18"/>
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#F0F3EF"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#283631"/>
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#3C4E47"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#34D399"/>

    <!-- Section Banners -->
    <SolidColorBrush x:Key="SectionHeaderBackgroundBrush" Color="#122922"/>
    <SolidColorBrush x:Key="SectionHeaderBorderBrush" Color="#1C4E41"/>
    <SolidColorBrush x:Key="SectionHeaderForegroundBrush" Color="#6EE7B7"/>
    <SolidColorBrush x:Key="SectionHeaderSubForegroundBrush" Color="#A7F3D0"/>

    <!-- Browser Tab Strip (Warm Obsidian Tabs) -->
    <SolidColorBrush x:Key="TabBarBackgroundBrush" Color="#0B0F0E"/>
    <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="#18211E"/>
    <SolidColorBrush x:Key="TabInactiveBackgroundBrush" Color="#101614"/>
    <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#1C2622"/>
    <SolidColorBrush x:Key="TabActiveBorderBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="TabInactiveBorderBrush" Color="#1E2825"/>
    <SolidColorBrush x:Key="TabTextActiveBrush" Color="#F0F3EF"/>
    <SolidColorBrush x:Key="TabTextInactiveBrush" Color="#76847E"/>
    <SolidColorBrush x:Key="TabCloseHoverBackgroundBrush" Color="#381919"/>
    <SolidColorBrush x:Key="TabAddButtonBackgroundBrush" Color="#121816"/>

    <!-- Status Bar -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#0D1211"/>
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#8B9791"/>
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#1E2825"/>

    <!-- Canvas Surface & Rulers (Nocturne Drafting Studio & Slate Sheet) -->
    <SolidColorBrush x:Key="CanvasWorkspaceBackgroundBrush" Color="#0A0D0C"/>
    <SolidColorBrush x:Key="CanvasPaperBackgroundBrush" Color="#111715"/>
    <SolidColorBrush x:Key="CanvasPaperBorderBrush" Color="#27342F"/>
    <SolidColorBrush x:Key="CanvasGridLineBrush" Color="#18211E"/>
    <SolidColorBrush x:Key="CanvasRulerBackgroundBrush" Color="#0D1211"/>
    <SolidColorBrush x:Key="CanvasRulerForegroundBrush" Color="#6A7771"/>
    <SolidColorBrush x:Key="CanvasRulerBorderBrush" Color="#1E2825"/>
    <SolidColorBrush x:Key="CanvasRulerCursorBrush" Color="#F59E0B"/>

    <!-- Floating HUD Viewport Toolbar -->
    <SolidColorBrush x:Key="HudBackgroundBrush" Color="#161F1CEE"/>
    <SolidColorBrush x:Key="HudBorderBrush" Color="#283631"/>
    <SolidColorBrush x:Key="HudForegroundBrush" Color="#F0F3EF"/>
    <SolidColorBrush x:Key="HudButtonHoverBrush" Color="#222E29"/>

    <!-- Minimalist Web-Style Technical Scrollbars -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="ScrollBarTrackHoverBrush" Color="#18211E55"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#26342F"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#384C45"/>
    <SolidColorBrush x:Key="ScrollBarThumbDraggingBrush" Color="#34D399"/>

    <!-- Dialogs -->
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#0F1413"/>
    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#151B19"/>
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#26322E"/>

    <!-- Fluent.Ribbon Overrides for High-Contrast Dark Mode -->
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonWindow.TitleForeground" Color="#F0F3EF"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonTabItem.Foreground" Color="#E1E6E3"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonTabItem.Selected.Foreground" Color="#34D399"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonTabItem.MouseOver.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.LabelText" Color="#DCE2DF"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonGroupBox.Header.Foreground" Color="#9EABA4"/>

</ResourceDictionary>