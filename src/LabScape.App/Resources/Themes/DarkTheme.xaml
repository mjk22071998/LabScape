<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- App / Window Surfaces (Obsidian & Deep Blueprint Palette) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#070B12"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#0D1524"/>
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#141E33"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#1A2840"/>
    <SolidColorBrush x:Key="AppBorderSubtleBrush" Color="#10192B"/>
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="AppTextMutedBrush" Color="#64748B"/>

    <!-- Technical Drafting Accent (Blueprint Cyan / Precision Electric Blue) -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0369A1"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#0C253B"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#0369A1"/>
    <Color x:Key="AccentGlowColor">#4038BDF8</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="#0284C7"/>

    <!-- Semantic Status Indicators -->
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#F87171"/>

    <!-- Panels (Palette & Inspector) -->
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#0A101C"/>
    <SolidColorBrush x:Key="PanelHeaderBackgroundBrush" Color="#0F1729"/>
    <SolidColorBrush x:Key="PanelHeaderForegroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0F192C"/>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#16233B"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1E2F4C"/>
    <SolidColorBrush x:Key="CardBorderHoverBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#1A2942"/>

    <!-- Input Controls -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0B1324"/>
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#1E3252"/>
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#2E4B77"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#38BDF8"/>

    <!-- Section Banners -->
    <SolidColorBrush x:Key="SectionHeaderBackgroundBrush" Color="#0C253B"/>
    <SolidColorBrush x:Key="SectionHeaderBorderBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="SectionHeaderForegroundBrush" Color="#7DD3FC"/>
    <SolidColorBrush x:Key="SectionHeaderSubForegroundBrush" Color="#BAE6FD"/>

    <!-- Browser Tab Strip (Blueprint Terminal Tabs) -->
    <SolidColorBrush x:Key="TabBarBackgroundBrush" Color="#05080E"/>
    <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="#0F192C"/>
    <SolidColorBrush x:Key="TabInactiveBackgroundBrush" Color="#080D17"/>
    <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#142138"/>
    <SolidColorBrush x:Key="TabActiveBorderBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="TabInactiveBorderBrush" Color="#121D30"/>
    <SolidColorBrush x:Key="TabTextActiveBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="TabTextInactiveBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TabCloseHoverBackgroundBrush" Color="#451A1A"/>
    <SolidColorBrush x:Key="TabAddButtonBackgroundBrush" Color="#0A101C"/>

    <!-- Status Bar -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#05080E"/>
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#131F33"/>

    <!-- Canvas Surface & Rulers (Infinite Dark Drafting Table & Blueprint Sheet) -->
    <SolidColorBrush x:Key="CanvasWorkspaceBackgroundBrush" Color="#05080E"/>
    <SolidColorBrush x:Key="CanvasPaperBackgroundBrush" Color="#0A1220"/>
    <SolidColorBrush x:Key="CanvasPaperBorderBrush" Color="#1E3252"/>
    <SolidColorBrush x:Key="CanvasGridLineBrush" Color="#122038"/>
    <SolidColorBrush x:Key="CanvasRulerBackgroundBrush" Color="#080E1A"/>
    <SolidColorBrush x:Key="CanvasRulerForegroundBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="CanvasRulerBorderBrush" Color="#16253D"/>
    <SolidColorBrush x:Key="CanvasRulerCursorBrush" Color="#38BDF8"/>

    <!-- Floating HUD Viewport Toolbar -->
    <SolidColorBrush x:Key="HudBackgroundBrush" Color="#0F192CEE"/>
    <SolidColorBrush x:Key="HudBorderBrush" Color="#1E3252"/>
    <SolidColorBrush x:Key="HudForegroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="HudButtonHoverBrush" Color="#1E2F4C"/>

    <!-- Minimalist Web-Style Technical Scrollbars -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="ScrollBarTrackHoverBrush" Color="#10192B55"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#263E63"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#3E5D8F"/>
    <SolidColorBrush x:Key="ScrollBarThumbDraggingBrush" Color="#38BDF8"/>

    <!-- Dialogs -->
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#070B12"/>
    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#0D1524"/>
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#1A2840"/>

</ResourceDictionary>
