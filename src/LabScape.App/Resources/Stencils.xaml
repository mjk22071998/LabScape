        <GeometryDrawing Brush="#EEF2FF">
            <GeometryDrawing.Pen>
                <Pen Brush="#4F46E5" Thickness="2"/>
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <EllipseGeometry Center="45,45" RadiusX="38" RadiusY="38"/>
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <EllipseGeometry Center="45,45" RadiusX="18" RadiusY="18"/>
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

