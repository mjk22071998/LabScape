<UserControl x:Class="LayoutDesigner.App.Views.StencilsPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:stencils="clr-namespace:LayoutDesigner.ViewModels.Stencils;assembly=LayoutDesigner.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="260">

    <Grid Background="#F9FAFB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search Box -->
        <Border Grid.Row="0" Margin="8,8,8,6" Background="White" CornerRadius="4" BorderBrush="#D1D5DB" BorderThickness="1" Padding="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Margin="4,2,6,2" VerticalAlignment="Center" Foreground="#9CA3AF"/>
                <TextBox Grid.Column="1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                         FontSize="12"/>
            </Grid>
        </Border>

        <!-- Categories Accordion / Scroll -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="6,0,6,8">

                <!-- 1. Devices Expander -->
                <Expander Header="IT Hardware &amp; Devices" IsExpanded="True" FontWeight="SemiBold" Margin="0,2,0,4">
                    <ItemsControl ItemsSource="{Binding FilteredDevices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="110" ItemHeight="95"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type stencils:StencilItem}">
                                <Border Margin="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4"
                                        Cursor="Hand" ToolTip="{Binding Title}"
                                        MouseMove="Stencil_MouseMove" MouseLeftButtonDown="Stencil_MouseLeftButtonDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#EFF6FF"/>
                                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Image Grid.Row="0" Source="{Binding IconResourceKey, Converter={StaticResource ResourceKeyToImageConverter}}" Stretch="Uniform" Margin="2"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Foreground="#374151"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <!-- 2. Furniture Expander -->
                <Expander Header="Office Furniture" IsExpanded="True" FontWeight="SemiBold" Margin="0,4,0,4">
                    <ItemsControl ItemsSource="{Binding FilteredFurniture}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="110" ItemHeight="95"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type stencils:StencilItem}">
                                <Border Margin="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4"
                                        Cursor="Hand" ToolTip="{Binding Title}"
                                        MouseMove="Stencil_MouseMove" MouseLeftButtonDown="Stencil_MouseLeftButtonDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#EFF6FF"/>
                                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Image Grid.Row="0" Source="{Binding IconResourceKey, Converter={StaticResource ResourceKeyToImageConverter}}" Stretch="Uniform" Margin="2"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Foreground="#374151"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <!-- 3. Shapes Expander -->
                <Expander Header="Geometric Shapes" IsExpanded="True" FontWeight="SemiBold" Margin="0,4,0,4">
                    <ItemsControl ItemsSource="{Binding FilteredShapes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="110" ItemHeight="95"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type stencils:StencilItem}">
                                <Border Margin="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4"
                                        Cursor="Hand" ToolTip="{Binding Title}"
                                        MouseMove="Stencil_MouseMove" MouseLeftButtonDown="Stencil_MouseLeftButtonDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#EFF6FF"/>
                                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Image Grid.Row="0" Source="{Binding IconResourceKey, Converter={StaticResource ResourceKeyToImageConverter}}" Stretch="Uniform" Margin="4"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Foreground="#374151"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
