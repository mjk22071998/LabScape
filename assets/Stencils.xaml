<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================== -->
    <!-- 1. IT HARDWARE STENCILS                    -->
    <!-- ========================================== -->

    <!-- Desktop PC (100x100) -->
    <DrawingGroup x:Key="Stencil_DesktopPC">
        <GeometryDrawing Brush="#9CA3AF">
            <GeometryDrawing.Pen>
                <Pen Brush="#374151" Thickness="2"/>
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="38,24,24,12" RadiusX="3" RadiusY="3"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#1F2937">
            <GeometryDrawing.Pen>
                <Pen Brush="#111827" Thickness="1.5"/>
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <PathGeometry Figures="M 12,18 C 30,15 70,15 88,18 L 88,22 C 70,19 30,19 12,22 Z"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#E5E7EB">
            <GeometryDrawing.Pen>
                <Pen Brush="#374151" Thickness="2"/>
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="18,44,46,20" RadiusX="3" RadiusY="3"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#E5E7EB">
            <GeometryDrawing.Pen>
                <Pen Brush="#374151" Thickness="1.5"/>
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="69,48,9,14" RadiusX="4.5" RadiusY="4.5"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#374151">
            <GeometryDrawing.Pen>
                <Pen Brush="#1F2937" Thickness="2"/>
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="18,72,50,14" RadiusX="2" RadiusY="2"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

    <!-- Laptop with Tilted Back Screen (100x100) -->
    <DrawingGroup x:Key="Stencil_Laptop">
        <!-- Tilted Screen Panel -->
        <GeometryDrawing Brush="#1F2937">
            <GeometryDrawing.Pen>
                <Pen Brush="#111827" Thickness="2"/>
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <PathGeometry Figures="M 20,12 L 80,12 L 76,36 L 24,36 Z"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <!-- Hinge Bar -->
        <GeometryDrawing Brush="#111827">
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="22,34,56,5" RadiusX="1.5" RadiusY="1.5"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <!-- Base Chassis -->
        <GeometryDrawing Brush="#E5E7EB">
            <GeometryDrawing.Pen>
                <Pen Brush="#374151" Thickness="2"/>
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="18,38,64,48" RadiusX="4" RadiusY="4"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <!-- Keyboard Inset -->
        <GeometryDrawing Brush="#D1D5DB">
            <GeometryDrawing.Pen>
                <Pen Brush="#6B7280" Thickness="1"/>
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="22,44,56,22" RadiusX="2" RadiusY="2"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <!-- Trackpad -->
        <GeometryDrawing Brush="#F3F4F6">
            <GeometryDrawing.Pen>
                <Pen Brush="#9CA3AF" Thickness="1"/>
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="38,69,24,13" RadiusX="2" RadiusY="2"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

    <!-- Server Rack (100x100) -->
    <DrawingGroup x:Key="Stencil_ServerRack">
        <GeometryDrawing Brush="#1F2937">
            <GeometryDrawing.Pen>
                <Pen Brush="#111827" Thickness="2.5"/>
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="18,10,64,80" RadiusX="4" RadiusY="4"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#111827">
            <GeometryDrawing.Pen>
                <Pen Brush="#4B5563" Thickness="1.5"/>
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="27,26,46,48"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

    <!-- ========================================== -->
    <!-- 2. FURNITURE STENCILS                      -->
    <!-- ========================================== -->

    <!-- Standard Office Desk (120x70) -->
    <DrawingGroup x:Key="Stencil_Desk">
        <!-- Desktop Surface -->
        <GeometryDrawing Brush="#F3F4F6">
            <GeometryDrawing.Pen>
                <Pen Brush="#374151" Thickness="2"/>
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="10,10,100,50" RadiusX="3" RadiusY="3"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <!-- Drawer Pedestal -->
        <GeometryDrawing Brush="#E5E7EB">
            <GeometryDrawing.Pen>
                <Pen Brush="#6B7280" Thickness="1.5"/>
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="13,14,22,42" RadiusX="2" RadiusY="2"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <!-- Cable Grommet -->
        <GeometryDrawing Brush="#374151">
            <GeometryDrawing.Geometry>
                <EllipseGeometry Center="95,22" RadiusX="3.5" RadiusY="3.5"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

    <!-- Office Swivel Chair (100x100) -->
    <DrawingGroup x:Key="Stencil_OfficeChair">
        <GeometryDrawing Brush="#E5E7EB">
            <GeometryDrawing.Pen>
                <Pen Brush="#374151" Thickness="2.5"/>
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="27,32,46,40" RadiusX="12" RadiusY="12"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#374151">
            <GeometryDrawing.Geometry>
                <GeometryGroup>
                    <RectangleGeometry Rect="19,38,7,28" RadiusX="3.5" RadiusY="3.5"/>
                    <RectangleGeometry Rect="74,38,7,28" RadiusX="3.5" RadiusY="3.5"/>
                </GeometryGroup>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#4B5563">
            <GeometryDrawing.Pen>
                <Pen Brush="#1F2937" Thickness="2"/>
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <PathGeometry Figures="M 23,28 Q 50,16 77,28 Q 50,22 23,28 Z"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

    <!-- Conference Table 8-Seater (Opposing Rows, No End Chairs) (220x100) -->
    <DrawingGroup x:Key="Stencil_ConferenceTable8">
        <GeometryDrawing Brush="#F3F4F6">
            <GeometryDrawing.Pen>
                <Pen Brush="#374151" Thickness="2.5"/>
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="24,22,172,56" RadiusX="14" RadiusY="14"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#E5E7EB">
            <GeometryDrawing.Pen>
                <Pen Brush="#6B7280" Thickness="1.5"/>
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="90,44,40,12" RadiusX="3" RadiusY="3"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

    <!-- 3-Seater Sofa (160x80) -->
    <DrawingGroup x:Key="Stencil_Sofa3Seater">
        <GeometryDrawing Brush="#E5E7EB">
            <GeometryDrawing.Pen>
                <Pen Brush="#374151" Thickness="2.5"/>
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="10,10,140,60" RadiusX="8" RadiusY="8"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#D1D5DB">
            <GeometryDrawing.Pen>
                <Pen Brush="#4B5563" Thickness="1.5"/>
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="14,14,132,18" RadiusX="5" RadiusY="5"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

</ResourceDictionary>
